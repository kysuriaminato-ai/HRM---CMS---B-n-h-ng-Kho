+        [Phone]         NVARCHAR(20)  NULL,
+        [Email]         NVARCHAR(150) NULL,
+        [Address]       NVARCHAR(500) NULL,
+        [TaxCode]       NVARCHAR(50)  NULL,
+        [CustomerType]  NVARCHAR(50)  NOT NULL DEFAULT 'Individual',
