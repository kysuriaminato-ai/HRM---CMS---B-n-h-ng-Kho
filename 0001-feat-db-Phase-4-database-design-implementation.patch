+# ERD — Sơ đồ quan hệ thực thể
+
+> Cập nhật: Phiên 4 (2026-11-04)
+> Quy ước: int PK (Identity) cho bảng thường, long PK cho bảng dữ liệu lớn.
+> Tất cả bảng nghiệp vụ có: CreatedAt, UpdatedAt, IsDeleted, CreatedBy, UpdatedBy.
+
+---
+
+## 1. Nhóm Hệ thống (System)
+
+```mermaid
+erDiagram
+    Users {
+        int Id PK
+        string Username UK
+        string PasswordHash
+        string PasswordSalt
+        bool IsActive
+        bool IsSuperAdmin
+        string SecurityStamp
+        datetime LastLoginAt
+        int EmployeeId FK "nullable"
+    }
+    Roles {
+        int Id PK
+        string Code UK
+        string Name
+        string Description
+        bool IsSystem
+        bool IsActive
+    }
+    Modules {
+        int Id PK
+        string Code UK
+        string Name
+        string Icon
+        int OrderIndex
+        bool IsActive
+    }
+    Permissions {
+        int Id PK
+        string Code UK
+        string Name
+        int ModuleId FK
+        int OrderIndex
+    }
+    UserRoles {
+        int UserId PK_FK
+        int RoleId PK_FK
+        datetime AssignedAt
+    }
+    RolePermissions {
+        int RoleId PK_FK
+        int PermissionId PK_FK
+    }
+    UserPermissions {
+        int UserId PK_FK
+        int PermissionId PK_FK
+        bool IsGranted
+    }
+    AuditLogs {
+        long Id PK
+        int UserId
+        string Username
+        string Action
+        string EntityName
+        string RecordId
+        string OldValues "JSON"
+        string NewValues "JSON"
+        datetime CreatedAt
+    }
+    Notifications {
+        long Id PK
+        int ReceiverUserId
+        string TargetRole
+        string Title
+        string Content
+        string Type
+        bool IsRead
+    }
+    NotificationReads {
+        long NotificationId PK_FK
+        int UserId PK_FK
+        datetime ReadAt
+    }
+    SiteSettings {
+        int Id PK
+        string SettingKey UK
+        string SettingValue
+        string SettingGroup
+    }
+    LoginAttempts {
+        int Id PK
+        string Username
+        string IpAddress
+        int FailedCount
+    }
+
+    Users ||--o{ UserRoles : ""
+    Roles ||--o{ UserRoles : ""
+    Users ||--o{ UserPermissions : ""
+    Permissions ||--o{ UserPermissions : ""
+    Roles ||--o{ RolePermissions : ""
+    Permissions ||--o{ RolePermissions : ""
+    Modules ||--o{ Permissions : ""
+    Notifications ||--o{ NotificationReads : ""
+```
+
