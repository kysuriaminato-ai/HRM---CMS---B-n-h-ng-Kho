@model ERP_HRM_CMS.Models.ViewModels.ChangePasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Module"] = "system";
    ViewData["Title"] = "Đổi mật khẩu cá nhân";
    ViewData["BreadcrumbSection"] = "Bảo mật tài khoản";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-5 col-md-7">
        <div class="erp-card p-4 shadow-sm">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary mb-3" style="width: 56px; height: 56px;">
                    <i class="bi bi-shield-lock-fill fs-3"></i>
                </div>
                <h5 class="fw-bold mb-1">Đổi mật khẩu cá nhân</h5>
                <p class="text-muted small mb-0">Mật khẩu mới tối thiểu 8 ký tự, bao gồm cả chữ cái và chữ số.</p>
            </div>

            @if (Model.IsForcedFirstLogin)
            {
                <div class="alert alert-warning d-flex align-items-start gap-2 small" role="alert">
                    <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                    <div>
                        <strong>Yêu cầu bảo mật lần đăng nhập đầu tiên:</strong>
                        Tài khoản của bạn vừa được cấp mật khẩu tạm thời. Bạn cần đổi sang mật khẩu cá nhân trước khi sử dụng hệ thống.
                    </div>
                </div>
            }

            <form asp-controller="Auth" asp-action="ChangePassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label small fw-semibold"></label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu hiện tại / tạm thời" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label small fw-semibold"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="Tối thiểu 8 ký tự (chữ & số)" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmNewPassword" class="form-label small fw-semibold"></label>
                    <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" />
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary py-2 fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i> Cập nhật mật khẩu mới
                    </button>
                    @if (!Model.IsForcedFirstLogin)
                    {
                        <a href="/Home/Index" class="btn btn-outline-secondary btn-sm">Quay lại Trang tổng quan</a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

