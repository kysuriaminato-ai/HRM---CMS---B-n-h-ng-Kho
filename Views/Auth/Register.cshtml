@inject ERP_HRM_CMS.Data.AppDbContext Db
@{ var brand = "AURA BRILLIANCE - HAUTE JOAILLERIE"; }
@model ERP_HRM_CMS.Models.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng Ký Tài Khoản - AURA BRILLIANCE";
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Google Fonts & Bootstrap -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/perfume-luxury.css" rel="stylesheet" />

    <style>
        :root {
            --reg-gold: #d4af37;
            --reg-gold-light: #f7e8bd;
            --reg-diamond: #f0f8ff;
        }
        body {
            background-color: #08090d;
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            color: #fcfbfa;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(212, 175, 55, 0.09) 0%, transparent 40%),
                radial-gradient(circle at 85% 85%, rgba(240, 248, 255, 0.05) 0%, transparent 45%);
            margin: 0;
            padding: 24px;
        }

        .register-wrapper {
            width: 100%;
            max-width: 1050px;
            background: rgba(14, 18, 26, 0.9);
            border: 1px solid rgba(212, 175, 55, 0.28);
            border-radius: 24px;
            box-shadow: 0 25px 65px rgba(0, 0, 0, 0.85), 0 0 45px rgba(212, 175, 55, 0.15);
            overflow: hidden;
            backdrop-filter: blur(20px);
        }

        .register-hero {
            background: linear-gradient(135deg, rgba(14, 18, 26, 0.75) 0%, rgba(8, 9, 13, 0.95) 100%),
                        url('https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=1000&q=80') center/cover no-repeat;
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
        }

        .register-hero::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(circle at center, rgba(212, 175, 55, 0.18) 0%, transparent 70%);
            pointer-events: none;
        }

        .register-form-pane {
            padding: 50px 45px;
        }

        .form-control {
            background: rgba(22, 27, 39, 0.8);
            border: 1px solid rgba(212, 175, 55, 0.22);
            color: #fff;
            padding: 12px 16px;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            background: rgba(26, 32, 48, 0.95);
            border-color: var(--reg-gold);
            color: #fff;
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
        }

        .btn-gold-action {
            background: linear-gradient(135deg, #d4af37 0%, #f7e8bd 50%, #aa8624 100%);
            border: none;
            color: #0b0c10;
            font-weight: 700;
            padding: 13px;
            border-radius: 10px;
            letter-spacing: 0.05em;
            width: 100%;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(212, 175, 55, 0.35);
        }

        .btn-gold-action:hover {
            box-shadow: 0 6px 28px rgba(212, 175, 55, 0.6);
            transform: translateY(-2px);
            color: #000;
        }

        .brand-badge {
            background: rgba(212, 175, 55, 0.15);
            border: 1px solid rgba(212, 175, 55, 0.4);
            color: var(--reg-gold-light);
            font-size: 0.75rem;
            letter-spacing: 0.15em;
            padding: 5px 14px;
            border-radius: 20px;
            text-transform: uppercase;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 16px;
        }
    </style>
</head>
<body>
    <div class="register-wrapper">
        <div class="row g-0">
            <!-- Cột trái: Giới thiệu thương hiệu trang sức -->
            <div class="col-lg-6 register-hero d-none d-lg-flex">
                <div class="position-relative" style="z-index: 2;">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-gem fs-3 text-warning"></i>
                        <span class="fs-4 fw-bold font-serif" style="letter-spacing: 0.12em; color: var(--reg-gold);">AURA BRILLIANCE</span>
                    </div>
                    <span class="brand-badge">HAUTE JOAILLERIE & KIM CƯƠNG GIA</span>
                    <h3 class="font-serif fw-bold text-light mt-3" style="line-height: 1.3;">
                        Đăng Ký Thành Viên VIP & Khám Phá Thế Giới Trang Sức Xa Xỉ
                    </h3>
                    <p class="text-secondary small mt-3" style="line-height: 1.8;">
                        Trở thành hội viên để nhận đặc quyền tư vấn 1:1 từ chuyên gia kim hoàn, đặt hẹn thử nhẫn kim cương tại phòng chờ VIP và nhận thông báo các phiên bản giới hạn trước khi ra mắt công chúng.
                    </p>
                </div>

                <div class="position-relative" style="z-index: 2;">
                    <div class="p-3 rounded-3 mb-3" style="background: rgba(14, 18, 26, 0.85); border: 1px solid rgba(212, 175, 55, 0.25);">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-patch-check-fill fs-3 text-warning"></i>
                            <div>
                                <strong class="d-block text-light small">Đặc Quyền Thành Viên AURA BRILLIANCE</strong>
                                <span class="text-secondary small">Bảo hành làm sạch kim cương trọn đời & Đổi mẫu linh hoạt</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center text-secondary small">
                        <span><i class="bi bi-shield-check text-warning me-1"></i>Bảo mật thông tin 100%</span>
                        <a href="/" class="text-warning text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Về Cửa Hàng Trang Sức</a>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Form Đăng Ký -->
            <div class="col-lg-6 register-form-pane">
                <div class="text-center mb-4">
                    <div class="d-lg-none mb-3">
                        <i class="bi bi-gem fs-2 text-warning"></i>
                        <h4 class="font-serif fw-bold text-warning mb-0">AURA BRILLIANCE</h4>
                    </div>
                    <span class="brand-badge">THÀNH VIÊN MỚI</span>
                    <h3 class="font-serif fw-bold text-light">Đăng Ký Tài Khoản</h3>
                    <p class="text-secondary small">Tạo tài khoản để lưu sản phẩm yêu thích và trải nghiệm mua sắm</p>
                </div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3 border-0" style="background: rgba(220, 38, 38, 0.2); color: #f87171;"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label small fw-semibold text-secondary">Tên đăng nhập:</label>
                        <div class="position-relative">
                            <input asp-for="Username" class="form-control ps-4" placeholder="ví dụ: hoang.kimcuong" autofocus autocomplete="username" />
                            <i class="bi bi-person position-absolute text-muted" style="left: 12px; top: 12px;"></i>
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary">Mật khẩu:</label>
                        <div class="position-relative">
                            <input asp-for="Password" id="regPass" type="password" class="form-control ps-4 pe-5" placeholder="Tối thiểu 8 ký tự, có chữ và số..." autocomplete="new-password" />
                            <i class="bi bi-lock position-absolute text-muted" style="left: 12px; top: 12px;"></i>
                            <button type="button" class="btn btn-link position-absolute end-0 top-0 text-secondary text-decoration-none h-100 px-3" onclick="togglePass('regPass', 'eye1')">
                                <i class="bi bi-eye" id="eye1"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary">Xác nhận mật khẩu:</label>
                        <div class="position-relative">
                            <input asp-for="ConfirmPassword" id="regPassConfirm" type="password" class="form-control ps-4 pe-5" placeholder="Nhập lại mật khẩu..." autocomplete="new-password" />
                            <i class="bi bi-shield-check position-absolute text-muted" style="left: 12px; top: 12px;"></i>
                            <button type="button" class="btn btn-link position-absolute end-0 top-0 text-secondary text-decoration-none h-100 px-3" onclick="togglePass('regPassConfirm', 'eye2')">
                                <i class="bi bi-eye" id="eye2"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-gold-action">
                        <i class="bi bi-person-check-fill me-2"></i> TẠO TÀI KHOẢN NGAY
                    </button>
                </form>

                <div class="text-center mt-4 small">
                    Đã có tài khoản? <a asp-action="Login" class="fw-bold text-warning text-decoration-none">Đăng nhập tại đây</a>
                </div>

                <div class="text-center mt-3">
                    <a href="/" class="text-secondary text-decoration-none small hover-gold">
                        <i class="bi bi-arrow-left me-1"></i> Trở về Trang Chủ AURA BRILLIANCE
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        function togglePass(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
</body>
</html>
