@inject ERP_HRM_CMS.Data.AppDbContext Db
@{ var brand = ERP_HRM_CMS.Helpers.SiteSettingReader.Get(Db, "Site_Short_Name", "ERP"); }
@model ERP_HRM_CMS.Models.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng ký tài khoản";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @brand</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background-color: #F8F9FA; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { background: #fff; border: 1px solid #E5E7EB; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,.04); width: 100%; max-width: 440px; padding: 40px; }
        .btn-dark-main { background-color: #000; color: #fff; border: none; border-radius: 8px; padding: 12px; font-weight: 600; width: 100%; }
        .btn-dark-main:hover { background-color: #262626; color: #fff; }
    </style>
</head>
<body>
    <div class="login-card">
        <h4 class="fw-bold text-dark mb-1 text-center">Đăng ký tài khoản</h4>
        <p class="text-muted small mb-4 text-center">Tài khoản sẽ được kích hoạt sau khi quản trị viên duyệt.</p>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="Username" class="form-control" autofocus autocomplete="username" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
                <div class="form-text">Tối thiểu 8 ký tự, gồm cả chữ và số.</div>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-dark-main">Đăng ký</button>
        </form>

        <div class="text-center mt-4 small">
            Đã có tài khoản? <a asp-action="Login" class="fw-semibold text-dark">Đăng nhập</a>
        </div>
    </div>
</body>
</html>
