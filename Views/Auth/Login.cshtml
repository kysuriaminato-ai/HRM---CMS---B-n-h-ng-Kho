@inject ERP_HRM_CMS.Data.AppDbContext Db
@{ var brand = "AURA BRILLIANCE - HAUTE JOAILLERIE"; }
@model ERP_HRM_CMS.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Cổng Quản Trị Hệ Thống - AURA BRILLIANCE";
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Google Fonts & Bootstrap -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/perfume-luxury.css" rel="stylesheet" />

    <style>
        :root {
            --login-gold: #d4af37;
            --login-gold-light: #f7e8bd;
        }
        body {
            background-color: #08090d;
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            color: #fcfbfa;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(212, 175, 55, 0.09) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(240, 248, 255, 0.05) 0%, transparent 45%);
            margin: 0;
            padding: 20px;
        }

        .login-wrapper {
            width: 100%;
            max-width: 1050px;
            background: rgba(14, 18, 26, 0.88);
            border: 1px solid rgba(212, 175, 55, 0.28);
            border-radius: 24px;
            box-shadow: 0 25px 65px rgba(0, 0, 0, 0.85), 0 0 45px rgba(212, 175, 55, 0.15);
            overflow: hidden;
            backdrop-filter: blur(20px);
        }

        .login-hero {
            background: linear-gradient(135deg, rgba(14, 18, 26, 0.72) 0%, rgba(8, 9, 13, 0.95) 100%),
                        url('https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=1000&q=80') center/cover no-repeat;
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
        }

        .login-hero::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(circle at center, rgba(212, 175, 55, 0.18) 0%, transparent 70%);
            pointer-events: none;
        }

        .login-form-pane {
            padding: 50px 45px;
        }

        .form-control {
            background: rgba(22, 27, 39, 0.8);
            border: 1px solid rgba(212, 175, 55, 0.22);
            color: #fff;
            padding: 12px 16px;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            background: rgba(26, 32, 48, 0.95);
            border-color: var(--login-gold);
            color: #fff;
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
        }

        .btn-gold-login {
            background: linear-gradient(135deg, #d4af37 0%, #f7e8bd 50%, #aa8624 100%);
            border: none;
            color: #0b0c10;
            font-weight: 700;
            padding: 13px;
            border-radius: 10px;
            letter-spacing: 0.05em;
            width: 100%;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(212, 175, 55, 0.35);
        }

        .btn-gold-login:hover {
            box-shadow: 0 6px 28px rgba(212, 175, 55, 0.6);
            transform: translateY(-2px);
            color: #000;
        }

        .brand-badge {
            background: rgba(212, 175, 55, 0.15);
            border: 1px solid rgba(212, 175, 55, 0.4);
            color: var(--login-gold-light);
            font-size: 0.75rem;
            letter-spacing: 0.15em;
            padding: 5px 14px;
            border-radius: 20px;
            text-transform: uppercase;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 16px;
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="row g-0">
            <!-- Cột trái: Hình ảnh thương hiệu & Chuyển động tĩnh -->
            <div class="col-lg-6 login-hero d-none d-lg-flex">
                <div class="position-relative" style="z-index: 2;">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-gem fs-3 text-warning"></i>
                        <span class="fs-4 fw-bold font-serif" style="letter-spacing: 0.12em; color: var(--login-gold);">AURA BRILLIANCE</span>
                    </div>
                    <span class="brand-badge">HAUTE JOAILLERIE & KIM CƯƠNG GIA</span>
                    <h3 class="font-serif fw-bold text-light mt-3" style="line-height: 1.3;">
                        Hệ Thống Quản Trị Kim Hoàn, Bán Hàng & Kho Đa Chi Nhánh
                    </h3>
                    <p class="text-secondary small mt-3" style="line-height: 1.8;">
                        Nền tảng vận hành tập trung: Quản lý mã vạch từng viên kim cương GIA, định giá vàng bạc đá quý, thu ngân POS, chấm công nhân sự và phân quyền menu chi tiết cho từng Admin Con.
                    </p>
                </div>

                <div class="position-relative" style="z-index: 2;">
                    <div class="p-3 rounded-3 mb-3" style="background: rgba(14, 18, 26, 0.85); border: 1px solid rgba(212, 175, 55, 0.25);">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-shield-lock-fill fs-3 text-warning"></i>
                            <div>
                                <strong class="d-block text-light small">Bảo Mật Phân Quyền Đa Tầng 2026</strong>
                                <span class="text-secondary small">Admin Tổng toàn quyền • Admin Con chỉ xem đúng menu được cấp</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center text-secondary small">
                        <span><i class="bi bi-check-circle-fill text-warning me-1"></i>Hệ thống ERP Kim Hoàn 2026</span>
                        <a href="/" class="text-warning text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Về Trang Bán Trang Sức</a>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Form Đăng Nhập -->
            <div class="col-lg-6 login-form-pane">
                <div class="text-center mb-4">
                    <div class="d-lg-none mb-3">
                        <i class="bi bi-gem fs-2 text-warning"></i>
                        <h4 class="font-serif fw-bold text-warning mb-0">AURA BRILLIANCE</h4>
                    </div>
                    <span class="brand-badge">CỔNG NỘI BỘ & KHÁCH HÀNG</span>
                    <h3 class="font-serif fw-bold text-light">Đăng Nhập Tài Khoản</h3>
                    <p class="text-secondary small">Dành cho Admin Tổng, Admin Con, Nhân viên và Hội viên VIP</p>
                </div>

                @if (TempData["ThongBao"] is string thongBao)
                {
                    <div class="alert alert-success py-2 small mb-3 border-0" style="background: rgba(5, 150, 105, 0.2); color: #34d399;">
                        <i class="bi bi-check-circle me-1"></i> @thongBao
                    </div>
                }

                <form asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3 border-0" style="background: rgba(220, 38, 38, 0.2); color: #f87171;"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label small fw-semibold text-secondary">Tên đăng nhập:</label>
                        <div class="position-relative">
                            <input asp-for="Username" class="form-control ps-4" placeholder="Nhập tên đăng nhập (admin / ketoan...)" autofocus autocomplete="username" />
                            <i class="bi bi-person position-absolute text-muted" style="left: 12px; top: 12px;"></i>
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary">Mật khẩu:</label>
                        <div class="position-relative">
                            <input asp-for="Password" id="passwordInput" type="password" class="form-control ps-4 pe-5" placeholder="Nhập mật khẩu..." autocomplete="current-password" />
                            <i class="bi bi-key position-absolute text-muted" style="left: 12px; top: 12px;"></i>
                            <button type="button" class="btn btn-link position-absolute end-0 top-0 text-secondary text-decoration-none h-100 px-3" onclick="togglePassword()">
                                <i class="bi bi-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input bg-dark border-secondary" />
                            <label asp-for="RememberMe" class="form-check-label small text-secondary">Ghi nhớ đăng nhập</label>
                        </div>
                        <a href="javascript:alert('Vui lòng liên hệ Admin Tổng để cấp lại mật khẩu.')" class="small text-warning text-decoration-none">
                            Quên mật khẩu?
                        </a>
                    </div>

                    <button type="submit" class="btn btn-gold-login">
                        <i class="bi bi-box-arrow-in-right me-2"></i> ĐĂNG NHẬP HỆ THỐNG
                    </button>
                </form>

                <div class="text-center mt-3">
                    <span class="text-secondary small">Chưa có tài khoản hội viên?</span>
                    <a asp-action="Register" class="text-warning fw-bold small text-decoration-none ms-1">Đăng ký tài khoản ngay</a>
                </div>

                <!-- Thẻ bấm 1 chạm điền tài khoản mẫu -->
                <div class="mt-4 p-3 rounded-3 text-secondary small" style="background: rgba(255,255,255,0.03); border: 1px dashed rgba(212,175,55,0.35);">
                    <div class="text-warning fw-bold mb-2 d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-key-fill me-1"></i>Bấm để tự động điền tài khoản thử nghiệm:</span>
                        <span class="badge bg-warning text-dark font-monospace">Pass: Admin@123456</span>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-outline-warning d-flex align-items-center gap-1" onclick="fillAccount('admin', 'Admin@123456')">
                            <i class="bi bi-shield-shaded"></i> <strong>Admin Tổng</strong> (Đầy đủ menu)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-info d-flex align-items-center gap-1" onclick="fillAccount('ketoan', 'Admin@123456')">
                            <i class="bi bi-person-gear"></i> <strong>Admin Con</strong> (Chỉ menu Lương)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light d-flex align-items-center gap-1" onclick="fillAccount('salestaff', 'Admin@123456')">
                            <i class="bi bi-cart"></i> <strong>Admin Con</strong> (Chỉ Bán Hàng POS)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light d-flex align-items-center gap-1" onclick="fillAccount('warehouse', 'Admin@123456')">
                            <i class="bi bi-box-seam"></i> <strong>Admin Con</strong> (Chỉ Kho Hàng)
                        </button>
                    </div>
                    <div class="mt-2 text-muted" style="font-size: 0.75rem;">
                        <i class="bi bi-info-circle me-1"></i>Gợi ý: Mật khẩu chấp nhận cả <code>Admin@123456</code> hoặc <code>123456</code>.
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a href="/" class="text-secondary text-decoration-none small hover-gold">
                        <i class="bi bi-gem me-1"></i> Trở Về Cửa Hàng Trang Sức AURA BRILLIANCE
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        function fillAccount(u, p) {
            var uInput = document.querySelector('input[name="Username"]');
            var pInput = document.getElementById('passwordInput');
            if (uInput) uInput.value = u;
            if (pInput) pInput.value = p;
        }

        function togglePassword() {
            var pInput = document.getElementById('passwordInput');
            var eyeIcon = document.getElementById('eyeIcon');
            if (pInput.type === 'password') {
                pInput.type = 'text';
                eyeIcon.classList.remove('bi-eye');
                eyeIcon.classList.add('bi-eye-slash');
            } else {
                pInput.type = 'password';
                eyeIcon.classList.remove('bi-eye-slash');
                eyeIcon.classList.add('bi-eye');
            }
        }
    </script>
</body>
</html>
