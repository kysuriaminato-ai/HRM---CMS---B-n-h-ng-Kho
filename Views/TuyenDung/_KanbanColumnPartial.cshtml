@model dynamic
@{
    string title = Model.Title;
    string badgeColor = Model.BadgeColor;
    string status = Model.Status;
    var candidates = (List<ERP_HRM_CMS.Models.ViewModels.CandidateKanbanDto>)Model.Candidates;
    string icon = Model.Icon;
}

<div class="col" style="min-width: 310px; max-width: 340px;">
    <div class="kanban-column card border-0 bg-light rounded-4 shadow-sm h-100 p-2"
         ondragover="handleDragOver(event)"
         ondragleave="handleDragLeave(event)"
         ondrop="handleDrop(event, '@status')">
        
        <!-- Column Header -->
        <div class="d-flex justify-content-between align-items-center p-2 mb-2 border-bottom">
            <div class="d-flex align-items-center gap-2">
                <i class="bi @icon text-@badgeColor"></i>
                <span class="fw-bold text-dark small">@title</span>
            </div>
            <span class="badge bg-@badgeColor rounded-pill column-count-badge">@candidates.Count</span>
        </div>

        <!-- Cards Container -->
        <div class="kanban-cards d-flex flex-column gap-2 overflow-auto p-1" style="max-height: calc(100vh - 280px);">
            @foreach (var c in candidates)
            {
                <div class="kanban-card card border-0 shadow-sm rounded-3 p-3 bg-white"
                     draggable="true"
                     data-candidate-id="@c.Id"
                     ondragstart="handleDragStart(event)"
                     ondragend="handleDragEnd(event)"
                     style="cursor: grab;">
                    
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.75rem;">@c.Code</span>
                        @if (c.EvaluationScore.HasValue)
                        {
                            <span class="badge @(c.EvaluationScore >= 80 ? "bg-success-subtle text-success border border-success-subtle" : (c.EvaluationScore >= 50 ? "bg-warning-subtle text-warning border border-warning-subtle" : "bg-danger-subtle text-danger border border-danger-subtle"))">
                                <i class="bi bi-star-fill me-1"></i>@c.EvaluationScore.Value.ToString("0.#")
                            </span>
                        }
                    </div>

                    <h6 class="fw-bold mb-1 text-dark">
                        <a href="javascript:void(0)" onclick="openCandidateDrawer(@c.Id)" class="text-decoration-none text-dark hover-primary">
                            @c.FullName
                        </a>
                    </h6>

                    <div class="text-muted small mb-2" style="font-size: 0.8rem;">
                        <i class="bi bi-briefcase me-1 text-primary"></i>@c.JobPostingTitle
                    </div>

                    <div class="d-flex flex-wrap gap-2 text-muted small mb-3" style="font-size: 0.75rem;">
                        @if (!string.IsNullOrWhiteSpace(c.Phone))
                        {
                            <span><i class="bi bi-telephone me-1"></i>@c.Phone</span>
                        }
                        <span><i class="bi bi-clock me-1"></i>@c.AppliedDate.ToString("dd/MM")</span>
                    </div>

                    @if (c.NextInterviewDate.HasValue)
                    {
                        <div class="alert alert-warning py-1 px-2 rounded-2 small mb-2 d-flex align-items-center" style="font-size: 0.75rem;">
                            <i class="bi bi-calendar-event me-1"></i> Phỏng vấn: @c.NextInterviewDate.Value.ToString("HH:mm dd/MM")
                        </div>
                    }

                    <!-- Card Actions -->
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-1">
                        <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-muted" onclick="openCandidateDrawer(@c.Id)" title="Xem hồ sơ & CV">
                            <i class="bi bi-eye me-1"></i>Chi tiết
                        </button>
                        
                        <div class="d-flex gap-1">
                            @if (status != "Hired" && status != "Rejected")
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.75rem;" onclick="openScheduleModal(@c.Id, '@c.FullName')" title="Lên lịch phỏng vấn">
                                    <i class="bi bi-calendar-plus"></i> Lịch
                                </button>
                            }

                            @if (status == "Offered" || status == "Hired")
                            {
                                <a href="/TuyenDung/TiepNhanNhanSu/@c.Id" class="btn btn-sm btn-success py-0 px-2 fw-semibold" style="font-size: 0.75rem;" title="1-Click Chuyển Ứng viên Thành Nhân viên">
                                    <i class="bi bi-person-check-fill me-1"></i>Tiếp nhận
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

