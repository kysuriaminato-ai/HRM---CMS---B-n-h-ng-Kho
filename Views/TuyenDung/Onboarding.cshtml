@model List<ERP_HRM_CMS.Models.ViewModels.OnboardingChecklistDto>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Quy Trình Hội Nhập & Bàn Giao (Onboarding / Offboarding)";
    string? typeFilter = (string?)ViewBag.TypeFilter;
    string? statusFilter = (string?)ViewBag.StatusFilter;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-clipboard-check me-2 text-primary"></i>Quy Trình Onboarding & Offboarding</h4>
            <p class="text-muted small mb-0">Theo dõi tiến độ hội nhập nhân sự mới và thủ tục bàn giao, thu hồi tài sản khi nhân viên thôi việc.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/TuyenDung/Kanban" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-kanban me-1"></i> ATS Kanban
            </a>
            <a href="/TuyenDung/Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-list-ul me-1"></i> Danh Sách Tin
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabs Filter -->
    <ul class="nav nav-pills mb-4 gap-2">
        <li class="nav-item">
            <a class="nav-link @(string.IsNullOrEmpty(typeFilter) ? "active" : "") fw-semibold" href="/TuyenDung/Onboarding">
                <i class="bi bi-grid me-1"></i> Tất Cả (@Model.Count)
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(typeFilter == "Onboarding" ? "active" : "") fw-semibold" href="/TuyenDung/Onboarding?type=Onboarding">
                <i class="bi bi-person-plus me-1"></i> Hội Nhập Nhân Viên Mới (@Model.Count(c => c.Type == "Onboarding"))
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(typeFilter == "Offboarding" ? "active" : "") fw-semibold" href="/TuyenDung/Onboarding?type=Offboarding">
                <i class="bi bi-box-arrow-right me-1"></i> Thủ Tục Thôi Việc / Bàn Giao (@Model.Count(c => c.Type == "Offboarding"))
            </a>
        </li>
    </ul>

    <!-- Checklists Cards -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var c in Model)
            {
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge @(c.Type == "Onboarding" ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-warning-subtle text-warning border border-warning-subtle") rounded-pill px-3 py-1">
                                    <i class="bi @(c.Type == "Onboarding" ? "bi-person-badge" : "bi-box-arrow-right") me-1"></i>@c.Type
                                </span>
                                <span class="badge @(c.Status == "Completed" ? "bg-success" : "bg-secondary") rounded-pill">
                                    @(c.Status == "Completed" ? "Hoàn thành" : "Đang thực hiện")
                                </span>
                            </div>

                            <h5 class="fw-bold mb-1 text-dark">@c.Title</h5>
                            <div class="text-muted small mb-3">
                                <strong>@c.EmployeeName</strong> (<span class="font-monospace">@c.EmployeeCode</span>) - @c.PositionName - @c.DepartmentName
                            </div>

                            <!-- Progress Bar -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small fw-semibold mb-1">
                                    <span class="text-secondary">Tiến độ hoàn thành:</span>
                                    <span class="text-primary tabular-nums progress-text-@c.Id">@c.ProgressPercentage% (@c.CompletedTasks/@c.TotalTasks việc)</span>
                                </div>
                                <div class="progress" style="height: 10px; border-radius: 5px;">
                                    <div class="progress-bar bg-success progress-bar-@c.Id" role="progressbar" style="width: @c.ProgressPercentage%;" aria-valuenow="@c.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>

                            <!-- Tasks Checklist -->
                            <div class="card bg-light border-0 rounded-3 p-3 mb-3">
                                <div class="small fw-bold text-dark mb-2"><i class="bi bi-list-task me-1 text-primary"></i>Danh mục công việc:</div>
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var task in c.Tasks)
                                    {
                                        <div class="d-flex align-items-center justify-content-between p-2 bg-white rounded-2 border">
                                            <div class="form-check mb-0">
                                                <input class="form-check-input task-checkbox" type="checkbox" id="task_@task.Id" data-task-id="@task.Id" data-checklist-id="@c.Id" checked="@(task.IsCompleted ? "checked" : null)" onchange="toggleTask(@task.Id, @c.Id, this.checked)" />
                                                <label class="form-check-label small @(task.IsCompleted ? "text-decoration-line-through text-muted" : "fw-semibold text-dark")" for="task_@task.Id" id="label_@task.Id">
                                                    @task.TaskName
                                                </label>
                                            </div>
                                            <span class="badge bg-light text-muted border small" style="font-size: 0.7rem;">@task.DepartmentRole</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top small text-muted">
                            <div>
                                <i class="bi bi-calendar me-1"></i>Bắt đầu: @c.StartDate.ToString("dd/MM/yyyy")
                                @if (c.TargetCompletionDate.HasValue)
                                {
                                    <span class="ms-2"><i class="bi bi-flag me-1"></i>Hạn: @c.TargetCompletionDate.Value.ToString("dd/MM/yyyy")</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(c.AssignedHrName))
                            {
                                <div><i class="bi bi-person me-1"></i>HR: @c.AssignedHrName</div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center text-muted">
            <i class="bi bi-clipboard-x fs-1 d-block mb-2"></i>
            <h5 class="fw-bold">Chưa có quy trình Onboarding / Offboarding nào</h5>
            <p class="small mb-0">Quy trình sẽ tự động sinh khi bạn thực hiện "Tiếp nhận nhân sự" từ ứng viên trúng tuyển.</p>
        </div>
    }
</div>

@section Scripts {
<script>
    async function toggleTask(taskId, checklistId, isCompleted) {
        const label = document.getElementById(`label_${taskId}`);
        if (isCompleted) {
            label.classList.add('text-decoration-line-through', 'text-muted');
            label.classList.remove('fw-semibold', 'text-dark');
        } else {
            label.classList.remove('text-decoration-line-through', 'text-muted');
            label.classList.add('fw-semibold', 'text-dark');
        }

        try {
            const res = await fetch('/TuyenDung/CapNhatTienDoTask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ taskId: taskId, isCompleted: isCompleted })
            });

            const data = await res.json();
            if (!res.ok || !data.success) {
                alert(data.message || 'Lỗi cập nhật task');
                window.location.reload();
            } else {
                // Update percentage on UI
                recalculateChecklistProgress(checklistId);
            }
        } catch (err) {
            console.error(err);
            alert('Lỗi kết nối khi cập nhật tiến độ công việc');
        }
    }

    function recalculateChecklistProgress(checklistId) {
        const checkboxes = document.querySelectorAll(`[data-checklist-id="${checklistId}"]`);
        const total = checkboxes.length;
        let completed = 0;
        checkboxes.forEach(cb => {
            if (cb.checked) completed++;
        });

        const percent = total > 0 ? Math.round((completed * 100) / total) : 0;

        const pBar = document.querySelector(`.progress-bar-${checklistId}`);
        if (pBar) {
            pBar.style.width = `${percent}%`;
            pBar.setAttribute('aria-valuenow', percent);
        }

        const pText = document.querySelector(`.progress-text-${checklistId}`);
        if (pText) {
            pText.textContent = `${percent}% (${completed}/${total} việc)`;
        }
    }
</script>
}

