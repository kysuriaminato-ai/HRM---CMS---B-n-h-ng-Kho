@model ERP_HRM_CMS.Models.ViewModels.OrderListViewModel
@{
    Layout = "_SalesLayout";
    ViewData["Title"] = "Tra Cứu & Quản Lý Đơn Hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-receipt me-2 text-primary"></i>Quản Lý Đơn Hàng</h4>
        <p class="text-muted small mb-0">Theo dõi toàn bộ đơn hàng bán lẻ tại quầy POS, trạng thái thanh toán và doanh số</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/DonHang/ExportDoanhThuExcel" class="btn btn-outline-success px-3">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel (.xlsx)
        </a>
        <a asp-action="Dashboard" class="btn btn-outline-primary px-3">
            <i class="bi bi-graph-up me-1"></i> Dashboard Doanh Số
        </a>
        <a href="/BanHang/POS" class="btn btn-primary px-3 shadow-sm">
            <i class="bi bi-cash-coin me-1"></i> Mở POS Bán Hàng
        </a>
    </div>
</div>

<!-- THỐNG KÊ NHANH -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-primary-subtle p-3 text-primary me-3">
                    <i class="bi bi-receipt-cutoff fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Tổng đơn hiển thị</div>
                    <h5 class="fw-bold mb-0">@Model.TotalOrdersCount</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-success-subtle p-3 text-success me-3">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Tổng doanh thu hợp lệ</div>
                    <h5 class="fw-bold mb-0 text-success">@Model.TotalRevenue.ToString("N0") đ</h5>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- BỘ LỌC TÌM KIẾM -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="keyword" value="@Model.Keyword" class="form-control form-control-sm" placeholder="Mã đơn, Tên khách hàng, SĐT..." />
            </div>
            <div class="col-md-2">
                <select name="orderStatus" class="form-select form-select-sm">
                    <option value="">-- Trạng thái đơn --</option>
                    <option value="Completed" selected="@(Model.OrderStatus == "Completed")">Completed (Hoàn thành)</option>
                    <option value="Pending" selected="@(Model.OrderStatus == "Pending")">Pending (Chờ duyệt)</option>
                    <option value="Cancelled" selected="@(Model.OrderStatus == "Cancelled")">Cancelled (Đã hủy)</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="paymentStatus" class="form-select form-select-sm">
                    <option value="">-- Thanh toán --</option>
                    <option value="Paid" selected="@(Model.PaymentStatus == "Paid")">Paid (Đã thanh toán)</option>
                    <option value="Unpaid" selected="@(Model.PaymentStatus == "Unpaid")">Unpaid (Chưa thanh toán)</option>
                </select>
            </div>
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" title="Từ ngày" />
                    <span class="input-group-text">-</span>
                    <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" title="Đến ngày" />
                </div>
            </div>
            <div class="col-md-1 text-end">
                <button type="submit" class="btn btn-sm btn-dark w-100">Lọc</button>
            </div>
        </form>
    </div>
</div>

<!-- BẢNG DANH SÁCH ĐƠN HÀNG -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 140px;">Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Chi nhánh</th>
                        <th>Thời gian tạo</th>
                        <th class="text-end">Tổng thanh toán</th>
                        <th class="text-center">Thanh toán</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-3">Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Orders != null && Model.Orders.Any())
                    {
                        foreach (var o in Model.Orders)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="badge bg-light text-dark border font-monospace">@o.OrderCode</span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@o.CustomerName</div>
                                    @if (!string.IsNullOrEmpty(o.CustomerPhone))
                                    {
                                        <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@o.CustomerPhone</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border">@(o.Branch?.Name ?? "CN Mặc định")</span>
                                </td>
                                <td class="text-muted small">@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end fw-bold text-primary">@o.FinalAmount.ToString("N0") đ</td>
                                <td class="text-center">
                                    @if (o.PaymentStatus == "Paid")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success">Đã thanh toán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning">Chưa thanh toán</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (o.OrderStatus == "Completed")
                                    {
                                        <span class="badge bg-success">Hoàn thành</span>
                                    }
                                    else if (o.OrderStatus == "Cancelled")
                                    {
                                        <span class="badge bg-danger">Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Đang xử lý</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="ChiTiet" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary py-1 px-2" title="Xem hóa đơn">
                                        <i class="bi bi-eye"></i> Xem
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Không có đơn hàng nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
