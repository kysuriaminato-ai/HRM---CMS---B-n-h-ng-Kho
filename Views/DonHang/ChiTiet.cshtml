@model ERP_HRM_CMS.Models.Entities.Order
@{
    Layout = "_SalesLayout";
    ViewData["Title"] = "Đơn Hàng " + Model.OrderCode;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Mã Đơn: <code>@Model.OrderCode</code></h4>
        <p class="text-secondary small mb-0">Thời gian tạo: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") | Điểm bán: <strong>@Model.Branch?.Name</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a href="/DonHang/Index" class="btn btn-sm btn-outline-secondary">Quay lại danh sách</a>
        <a href="/DonHang/InHoaDon/@Model.Id" target="_blank" class="btn btn-sm btn-primary">
            <i class="bi bi-receipt-cutoff me-1"></i> In Hóa Đơn POS (VietQR)
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="erp-card mb-4">
            <div class="erp-card-header d-flex justify-content-between align-items-center">
                <span>Chi Tiết Mặt Hàng Đã Bán</span>
                <span class="badge bg-light text-dark border">@Model.OrderDetails.Count mục</span>
            </div>
            <div class="table-responsive">
                <table class="table erp-table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Sản Phẩm</th>
                            <th class="text-end">Đơn Giá</th>
                            <th class="text-center">Số Lượng</th>
                            <th class="text-end">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.OrderDetails)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@d.Product?.Name</div>
                                    <div class="small text-muted">SKU: <code>@d.Product?.SKU</code></div>
                                </td>
                                <td class="text-end">@d.UnitPrice.ToString("N0") đ</td>
                                <td class="text-center fw-bold">@d.Quantity</td>
                                <td class="text-end fw-bold">@((d.Quantity * d.UnitPrice).ToString("N0")) đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="erp-card p-4 mb-4">
            <h6 class="fw-bold text-uppercase pb-2 border-bottom text-dark mb-3">Thông Tin Khách & Giao Dịch</h6>
            <div class="small mb-2"><strong>Khách hàng:</strong> @Model.CustomerName</div>
            <div class="small mb-2"><strong>Điện thoại:</strong> @Model.CustomerPhone</div>
            <div class="small mb-2"><strong>Địa chỉ:</strong> @(Model.CustomerAddress ?? "Tại quầy")</div>
            <div class="small mb-2"><strong>Thu ngân / Người lập:</strong> @(Model.Creator?.Username ?? "Online")</div>
            <div class="small mb-3"><strong>Phương thức:</strong> <span class="badge bg-light text-dark border">@Model.PaymentMethod</span></div>

            <div class="border-top pt-3">
                <div class="d-flex justify-content-between mb-2 small">
                    <span>Tổng tiền hàng:</span>
                    <strong>@Model.TotalAmount.ToString("N0") đ</strong>
                </div>
                <div class="d-flex justify-content-between mb-2 small">
                    <span>Chiết khấu:</span>
                    <strong>-@Model.DiscountAmount.ToString("N0") đ</strong>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <span class="fw-bold">THANH TOÁN:</span>
                    <span class="fs-5 fw-bold text-dark">@Model.FinalAmount.ToString("N0") đ</span>
                </div>
            </div>
        </div>

        <!-- Trạng thái & Phê duyệt đơn hàng -->
        <div class="erp-card p-3">
            <h6 class="fw-bold small text-uppercase mb-2">Cập Nhật Trạng Thái</h6>
            <form asp-action="CapNhatTrangThai" method="post" class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <select name="status" class="form-select form-select-sm">
                    <option value="Completed" selected="@(Model.OrderStatus == "Completed")">Hoàn tất (Completed)</option>
                    <option value="Pending" selected="@(Model.OrderStatus == "Pending")">Chờ xử lý (Pending)</option>
                    <option value="Cancelled" selected="@(Model.OrderStatus == "Cancelled")">Hủy đơn (Cancelled)</option>
                </select>
                <button type="submit" class="btn btn-sm btn-erp-black text-nowrap">Lưu</button>
            </form>
        </div>
    </div>
</div>

