@model List<ERP_HRM_CMS.Models.Entities.Content>
@{
    ViewData["Module"] = "cms";
    ViewData["Title"] = "Quản Trị Bài Viết & Nội Dung";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Danh Sách Bài Viết & Trang Tĩnh</h4>
        <p class="text-secondary small mb-0">Quản lý nội dung tin tức, giới thiệu và chính sách</p>
    </div>
    <a href="/Content/Create" class="btn btn-erp-black">
        <i class="bi bi-pencil-square me-1"></i> Soạn Bài Mới
    </a>
</div>

<div class="erp-card">
    <div class="table-responsive">
        <table class="table erp-table mb-0">
            <thead>
                <tr>
                    <th style="width: 60px;">ID</th>
                    <th>Tiêu Đề Bài Viết</th>
                    <th>Slug Đường Dẫn</th>
                    <th>Trạng Thái</th>
                    <th>Lượt Xem</th>
                    <th>Ngày Cập Nhật</th>
                    <th class="text-end" style="width: 140px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.Id</td>
                            <td class="fw-semibold">@c.Title</td>
                            <td><code class="small">/bai-viet/@c.Slug</code></td>
                            <td>
                                @if (c.Status == "Published")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Xuất bản</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Bản nháp</span>
                                }
                            </td>
                            <td>@c.ViewCount</td>
                            <td class="small text-secondary">@c.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <a href="/Content/Edit/@c.Id" class="btn btn-sm btn-erp-outline py-1 px-2"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Hệ thống sẽ tự động gỡ bỏ liên kết từ các Menu trỏ đến bài này. Tiếp tục xóa?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-erp-outline py-1 px-2 text-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Chưa có bài viết nào trong hệ thống.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
