@model ERP_HRM_CMS.Controllers.StyleguideTableViewModel
@using ERP_HRM_CMS.Models.Enums
@{
    Layout = "_Layout";
    ViewData["Module"] = "system";
    ViewData["Title"] = "UI Styleguide";
    ViewData["BreadcrumbSection"] = "Hệ thống";

    var surfaceTokens = new (string Name, string VarName)[]
    {
        ("Body Surface", "--erp-bg-body"),
        ("Card Surface", "--erp-bg-card"),
        ("Input Surface", "--erp-bg-surface"),
        ("Subtle Surface", "--erp-bg-subtle"),
        ("Hover Surface", "--erp-bg-hover"),
        ("Sidebar Surface", "--erp-bg-sidebar")
    };

    var semanticTokens = new (string Name, string VarName)[]
    {
        ("Module Primary", "--erp-primary"),
        ("Primary Subtle", "--erp-primary-subtle"),
        ("Success", "--erp-success"),
        ("Warning", "--erp-warning"),
        ("Danger", "--erp-danger"),
        ("Info", "--erp-info"),
        ("Purple", "--erp-purple"),
        ("Border Default", "--erp-border-color")
    };

    var moduleDefs = new (string Key, string Label, string Icon)[]
    {
        ("system", "System (Mặc định)", "bi-sliders2"),
        ("hrm", "HRM (Nhân sự)", "bi-people"),
        ("payroll", "Payroll (Lương)", "bi-cash-coin"),
        ("sales", "Sales (Bán hàng)", "bi-cart-check"),
        ("warehouse", "Warehouse (Kho)", "bi-box-seam"),
        ("cms", "CMS (Nội dung)", "bi-newspaper")
    };

    var radiusScale = new (string Label, string VarName)[]
    {
        ("xs (4px)", "--erp-radius-xs"),
        ("sm (6px)", "--erp-radius-sm"),
        ("md (8px)", "--erp-radius-md"),
        ("lg (12px)", "--erp-radius-lg"),
        ("xl (16px)", "--erp-radius-xl"),
        ("2xl (20px)", "--erp-radius-2xl"),
        ("full (9999px)", "--erp-radius-full")
    };

    var spacingScale = new (string Label, string VarName)[]
    {
        ("space-1 (4px)", "--erp-space-1"),
        ("space-2 (8px)", "--erp-space-2"),
        ("space-3 (12px)", "--erp-space-3"),
        ("space-4 (16px)", "--erp-space-4"),
        ("space-5 (20px)", "--erp-space-5"),
        ("space-6 (24px)", "--erp-space-6"),
        ("space-8 (32px)", "--erp-space-8"),
        ("space-10 (40px)", "--erp-space-10"),
        ("space-12 (48px)", "--erp-space-12")
    };

    var shadowScale = new (string Label, string VarName)[]
    {
        ("shadow-xs", "--erp-shadow-xs"),
        ("shadow-sm", "--erp-shadow-sm"),
        ("shadow-md", "--erp-shadow-md"),
        ("shadow-lg", "--erp-shadow-lg"),
        ("shadow-xl", "--erp-shadow-xl")
    };
}

@* ═══════ 1. PAGE HEADER COMPONENT ═══════ *@
<erp-page-header title="UI Styleguide & Design System"
                 subtitle="Trình diễn đầy đủ Design Tokens, 12 Shared Components và Micro-interactions Giai đoạn A (Dành riêng cho Super Admin)"
                 icon="bi-palette2"
                 breadcrumbs="Bảng điều khiển:/Home/Index|Hệ thống:/PhanQuyen/MaTranPhanQuyen|UI Styleguide">
    <button type="button" class="btn btn-outline-secondary btn-sm" data-drawer-open="sgRightDrawer">
        <i class="bi bi-layout-sidebar-inset-reverse me-1"></i>Mở Drawer mẫu
    </button>
    <button type="button" class="btn btn-primary btn-sm ripple" onclick="window.toggleTheme && window.toggleTheme(event)">
        <i class="bi bi-circle-half me-1"></i>Đổi Sáng / Tối (Circular Reveal)
    </button>
</erp-page-header>

@* ═══════ STICKY LIVE MODULE & THEME SWITCHER ═══════ *@
<div class="erp-sg-sticky-bar d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div class="d-flex align-items-center flex-wrap gap-2">
        <span class="small fw-semibold text-muted me-1">
            <i class="bi bi-droplet-half me-1"></i>Màu nhấn phân hệ (<code>data-module</code>):
        </span>
        @foreach (var m in moduleDefs)
        {
            <button type="button"
                    class="erp-sg-module-btn @(m.Key == "system" ? "active" : "")"
                    data-sg-module="@m.Key">
                <i class="bi @m.Icon"></i>
                <span>@m.Label</span>
            </button>
        }
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="erp-badge erp-badge-primary erp-badge-dot" id="sgMotionStatusBadge">Motion: Standard</span>
    </div>
</div>

@* ═══════ SECTION A: DESIGN TOKENS ═══════ *@
<section class="erp-sg-section">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h5 class="fw-bold mb-1"><i class="bi bi-sliders me-2" style="color: var(--erp-primary);"></i>1. Design Tokens (Màu sắc, Bo góc, Khoảng cách, Đổ bóng & Motion)</h5>
            <p class="text-muted small mb-0">Toàn bộ giá trị được định nghĩa tại <code>enterprise-theme.css</code>, tự động thích ứng Light / Dark và <code>[data-module]</code>.</p>
        </div>
    </div>

    <h6 class="fw-semibold small text-uppercase text-muted mb-3">Surface & Background Tokens</h6>
    <div class="row g-3 mb-4">
        @foreach (var sw in surfaceTokens)
        {
            <div class="col-6 col-md-4 col-xl-2">
                <div class="erp-sg-swatch">
                    <div class="erp-sg-swatch-color" style="background: var(@sw.VarName);"></div>
                    <div class="erp-sg-swatch-meta">
                        <div class="fw-semibold text-truncate">@sw.Name</div>
                        <code class="small">@sw.VarName</code>
                    </div>
                </div>
            </div>
        }
    </div>

    <h6 class="fw-semibold small text-uppercase text-muted mb-3">Semantic & Module Accent Tokens</h6>
    <div class="row g-3 mb-4">
        @foreach (var sw in semanticTokens)
        {
            <div class="col-6 col-md-3 col-xl-3">
                <div class="erp-sg-swatch">
                    <div class="erp-sg-swatch-color" style="background: var(@sw.VarName);"></div>
                    <div class="erp-sg-swatch-meta">
                        <div class="fw-semibold text-truncate">@sw.Name</div>
                        <code class="small">@sw.VarName</code>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <h6 class="fw-semibold small text-uppercase text-muted mb-3">Border Radius Scale</h6>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var r in radiusScale)
                {
                    <div class="erp-sg-demo-box" style="border-radius: var(@r.VarName); min-width: 108px;">
                        <div>@r.Label</div>
                        <code class="small d-block mt-1">@r.VarName</code>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <h6 class="fw-semibold small text-uppercase text-muted mb-3">Spacing Scale</h6>
            <div class="d-flex flex-column gap-2">
                @foreach (var sp in spacingScale)
                {
                    <div class="d-flex align-items-center gap-3">
                        <code class="small" style="min-width: 145px;">@sp.VarName</code>
                        <span class="erp-sg-space-bar" style="width: var(@sp.VarName);"></span>
                        <span class="text-muted small">@sp.Label</span>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-7">
            <h6 class="fw-semibold small text-uppercase text-muted mb-3">Elevation & Shadow Scale</h6>
            <div class="row g-3">
                @foreach (var sh in shadowScale)
                {
                    <div class="col-6 col-sm-4">
                        <div class="erp-sg-shadow-box" style="box-shadow: var(@sh.VarName);">
                            <div>@sh.Label</div>
                            <code class="small text-muted">@sh.VarName</code>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <h6 class="fw-semibold small text-uppercase text-muted mb-3">Motion & Easing Tokens</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Token</th>
                            <th>Vai trò</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td><code>--erp-duration-instant</code></td><td class="small text-muted">80ms — Phản hồi tức thời</td></tr>
                        <tr><td><code>--erp-duration-fast</code></td><td class="small text-muted">150ms — Hover, focus, badge</td></tr>
                        <tr><td><code>--erp-duration-normal</code></td><td class="small text-muted">240ms — Accordion, tab, modal</td></tr>
                        <tr><td><code>--erp-duration-slow</code></td><td class="small text-muted">380ms — Drawer, view transition</td></tr>
                        <tr><td><code>--erp-ease-spring</code></td><td class="small text-muted">Cubic-bezier đàn hồi nhẹ</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@* ═══════ SECTION B: STAT CARDS ═══════ *@
<section class="erp-sg-section">
    <h5 class="fw-bold mb-1"><i class="bi bi-graph-up-arrow me-2" style="color: var(--erp-primary);"></i>2. StatCard Component (<code>&lt;erp-stat-card&gt;</code> &amp; <code>_StatCard.cshtml</code>)</h5>
    <p class="text-muted small mb-4">Hỗ trợ đếm số tự động (<code>count-up-target</code>), tiền tố/hậu tố, xu hướng tăng/giảm và 6 biến thể ngữ nghĩa.</p>

    <div class="row g-3 stagger-list">
        <div class="col-sm-6 col-xl-3">
            <erp-stat-card label="Doanh thu thuần"
                           count-up-target="1285400000"
                           suffix=" đ"
                           trend="+18.4% so với kỳ trước"
                           trend-dir="up"
                           icon="bi-currency-dollar"
                           variant="primary" />
        </div>
        <div class="col-sm-6 col-xl-3">
            <erp-stat-card label="Nhân sự chính thức"
                           count-up-target="248"
                           suffix=" người"
                           trend="+6 nhân sự mới"
                           trend-dir="up"
                           icon="bi-people-fill"
                           variant="success" />
        </div>
        <div class="col-sm-6 col-xl-3">
            <erp-stat-card label="Đơn từ chờ duyệt"
                           count-up-target="14"
                           suffix=" hồ sơ"
                           trend="Cần xử lý trong ngày"
                           trend-dir="neutral"
                           icon="bi-hourglass-split"
                           variant="warning" />
        </div>
        <div class="col-sm-6 col-xl-3">
            <erp-stat-card label="Cảnh báo tồn kho"
                           count-up-target="5"
                           suffix=" SKU"
                           trend="-2 SKU dưới định mức"
                           trend-dir="down"
                           icon="bi-exclamation-triangle-fill"
                           variant="danger" />
        </div>
    </div>
</section>

@* ═══════ SECTION C: FILTER BAR + AJAX DATA TABLE ═══════ *@
<section class="erp-sg-section">
    <h5 class="fw-bold mb-1"><i class="bi bi-table me-2" style="color: var(--erp-primary);"></i>3. FilterBar &amp; AJAX DataTable (<code>&lt;erp-filter-bar&gt;</code> + <code>&lt;erp-data-table&gt;</code>)</h5>
    <p class="text-muted small mb-4">Gõ tìm kiếm (debounce 300ms), lọc theo phân hệ/trạng thái, bấm vào tiêu đề cột để sắp xếp hoặc chuyển trang mượt bằng AJAX + View Transition + Stagger Rows.</p>

    <erp-filter-bar target-table="sgAjaxTable"
                    action-url="/UI/StyleguideTableData"
                    search-name="keyword"
                    search-placeholder="Tìm mã chứng từ, nội dung, người phụ trách...">
        <select name="moduleFilter" class="form-select form-select-sm w-auto" aria-label="Lọc theo phân hệ">
            <option value="">Tất cả phân hệ</option>
            <option value="hrm">Nhân sự (HRM)</option>
            <option value="payroll">Lương &amp; Phúc lợi</option>
            <option value="sales">Bán hàng &amp; POS</option>
            <option value="warehouse">Kho &amp; Mua hàng</option>
            <option value="cms">Nội dung (CMS)</option>
            <option value="system">Hệ thống</option>
        </select>

        <select name="statusFilter" class="form-select form-select-sm w-auto" aria-label="Lọc theo nhóm trạng thái">
            <option value="">Mọi trạng thái</option>
            <option value="success">Hoàn tất / Đã duyệt (Success)</option>
            <option value="info">Đang xử lý / Đã gửi (Info)</option>
            <option value="warning">Chờ duyệt / Khóa sổ (Warning)</option>
            <option value="danger">Từ chối / Quá hạn (Danger)</option>
            <option value="neutral">Bản nháp (Neutral)</option>
        </select>
    </erp-filter-bar>

    <partial name="_StyleguideTablePartial" model="Model" />
</section>

@* ═══════ SECTION D: WORKFLOW STATUS BADGES ═══════ *@
<section class="erp-sg-section">
    <h5 class="fw-bold mb-1"><i class="bi bi-patch-check me-2" style="color: var(--erp-primary);"></i>4. Badge Trạng Thái Chuẩn Hóa (<code>&lt;erp-status-badge&gt;</code> theo <code>WorkflowStatuses</code>)</h5>
    <p class="text-muted small mb-4">Ánh xạ tự động toàn bộ 5 nhóm Enum nghiệp vụ trong <code>Models/Enums/WorkflowStatuses.cs</code> và mã chuỗi lưu trong cơ sở dữ liệu.</p>

    <div class="row g-3">
        <div class="col-md-6 col-xl-4">
            <div class="p-3 border rounded-3 h-100">
                <div class="fw-semibold small mb-2">PurchaseOrderStatus (Đơn mua hàng PO)</div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var st in Enum.GetValues<PurchaseOrderStatus>())
                    {
                        <erp-status-badge status="@st" show-icon="true" />
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="p-3 border rounded-3 h-100">
                <div class="fw-semibold small mb-2">DebtStatus (Công nợ AR / AP)</div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var st in Enum.GetValues<DebtStatus>())
                    {
                        <erp-status-badge status="@st" show-icon="true" />
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="p-3 border rounded-3 h-100">
                <div class="fw-semibold small mb-2">LeaveRequestStatus (Đơn nghỉ phép / Công tác)</div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var st in Enum.GetValues<LeaveRequestStatus>())
                    {
                        <erp-status-badge status="@st" />
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-3 border rounded-3 h-100">
                <div class="fw-semibold small mb-2">PayrollPeriodStatus (Kỳ tính lương)</div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var st in Enum.GetValues<PayrollPeriodStatus>())
                    {
                        <erp-status-badge status="@st" show-icon="true" />
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-3 border rounded-3 h-100">
                <div class="fw-semibold small mb-2">SalarySlipStatus (Phiếu lương cá nhân)</div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var st in Enum.GetValues<SalarySlipStatus>())
                    {
                        <erp-status-badge status="@st" />
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@* ═══════ SECTION E: TABS (SLIDING INDICATOR) + EMPTY STATE + SKELETON + AVATAR + TIMELINE ═══════ *@
<section class="erp-sg-section">
    <h5 class="fw-bold mb-1"><i class="bi bi-segmented-nav me-2" style="color: var(--erp-primary);"></i>5. Tabs Trượt Indicator &amp; Nhóm Component Hiển Thị</h5>
    <p class="text-muted small mb-4">Hỗ trợ thanh trượt mượt (<code>.erp-tab-indicator</code>), điều hướng phím mũi tên Trái/Phải/Home/End, tích hợp EmptyState, Skeleton, Avatar và Timeline.</p>

    <erp-tabs id="sgShowcaseTabs">
        <erp-tab id="tabTimeline" title="Timeline" icon="bi-clock-history" badge="4" active="true">
            <erp-timeline>
                <erp-timeline-item title="Giám đốc phê duyệt đơn mua hàng PO-2026-003"
                                   time="10/04/2026 16:45"
                                   actor="Super Admin • Ban Giám đốc"
                                   variant="success"
                                   icon="bi-check-lg">
                    Đã ký duyệt hạn mức 96.800.000 đ và chuyển phiếu sang bộ phận Kho tiếp nhận hàng hóa.
                </erp-timeline-item>
                <erp-timeline-item title="Kế toán trưởng kiểm tra ngân sách quý II"
                                   time="10/04/2026 14:10"
                                   actor="Trịnh Thu Hà • Phòng Tài chính Kế toán"
                                   variant="info"
                                   icon="bi-calculator">
                    Xác nhận số dư ngân sách mua sắm thiết bị CNTT còn khả dụng.
                </erp-timeline-item>
                <erp-timeline-item title="Yêu cầu bổ sung báo giá cạnh tranh"
                                   time="09/04/2026 11:20"
                                   actor="Phạm Minh Châu • Phòng Mua hàng"
                                   variant="warning"
                                   icon="bi-exclamation-lg">
                    Đã đính kèm đủ 3 báo giá nhà cung cấp đạt chuẩn ISO.
                </erp-timeline-item>
                <erp-timeline-item title="Khởi tạo đề xuất mua sắm"
                                   time="09/04/2026 08:30"
                                   actor="Đinh Gia Bảo • Khối Kỹ thuật"
                                   variant="primary"
                                   icon="bi-plus-lg">
                    Tạo phiếu yêu cầu trang bị màn hình phục vụ dự án ERP Giai đoạn A.
                </erp-timeline-item>
            </erp-timeline>
        </erp-tab>

        <erp-tab id="tabAvatar" title="Avatar" icon="bi-person-circle" badge="5 cỡ">
            <div class="d-flex flex-wrap align-items-end gap-4 py-2">
                <div class="text-center">
                    <erp-avatar name="Nguyễn Văn An" size="xs" status="online" />
                    <div class="small text-muted mt-2"><code>xs</code> (24px)</div>
                </div>
                <div class="text-center">
                    <erp-avatar name="Trần Quốc Bảo" size="sm" status="online" />
                    <div class="small text-muted mt-2"><code>sm</code> (32px)</div>
                </div>
                <div class="text-center">
                    <erp-avatar name="Lê Hoàng Châu" size="md" status="busy" />
                    <div class="small text-muted mt-2"><code>md</code> (40px • busy)</div>
                </div>
                <div class="text-center">
                    <erp-avatar name="Phạm Minh Dũng" size="lg" status="away" />
                    <div class="small text-muted mt-2"><code>lg</code> (52px • away)</div>
                </div>
                <div class="text-center">
                    <erp-avatar name="Võ Khánh Linh" size="xl" status="offline" />
                    <div class="small text-muted mt-2"><code>xl</code> (68px • offline)</div>
                </div>
            </div>
        </erp-tab>

        <erp-tab id="tabEmptyState" title="EmptyState" icon="bi-inbox">
            <erp-empty-state icon="bi-folder2-open"
                             title="Chưa có chứng từ phát sinh trong kỳ"
                             description="Khi có đơn hàng, phiếu kho hoặc bảng lương mới, dữ liệu sẽ được đồng bộ trực tiếp tại đây."
                             action-text="Tạo chứng từ mẫu"
                             action-url="/UI/Styleguide" />
        </erp-tab>

        <erp-tab id="tabSkeleton" title="Skeleton" icon="bi-hourglass">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="small fw-semibold text-muted mb-2">Card &amp; Avatar Skeleton</div>
                    <erp-skeleton type="card" rows="3" />
                    <div class="mt-3">
                        <erp-skeleton type="avatar" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="small fw-semibold text-muted mb-2">List &amp; Table Skeleton</div>
                    <erp-skeleton type="list" rows="2" />
                    <div class="mt-3">
                        <erp-skeleton type="table" rows="3" />
                    </div>
                </div>
            </div>
        </erp-tab>
    </erp-tabs>
</section>

@* ═══════ SECTION F: OVERLAYS (CONFIRM MODAL + DRAWER) & MICRO-INTERACTIONS ═══════ *@
<section class="erp-sg-section">
    <h5 class="fw-bold mb-1"><i class="bi bi-magic me-2" style="color: var(--erp-primary);"></i>6. ConfirmModal, Drawer &amp; Hiệu Ứng Tương Tác (Animations Playground)</h5>
    <p class="text-muted small mb-4">Tất cả hiệu ứng tự động giảm chuyển động khi hệ điều hành bật chế độ <code>prefers-reduced-motion: reduce</code>.</p>

    <div class="row g-4">
        @* ConfirmModal & Drawer *@
        <div class="col-lg-6">
            <div class="p-4 border rounded-3 h-100">
                <h6 class="fw-bold mb-2">ConfirmModal &amp; Offcanvas Drawer</h6>
                <p class="text-muted small mb-3">Thử nghiệm hộp thoại xác nhận (JS API hoặc thuộc tính <code>data-erp-confirm</code>) và ngăn kéo trượt trái/phải.</p>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-danger btn-sm" id="sgBtnProgrammaticConfirm">
                        <i class="bi bi-trash3 me-1"></i>ERP.confirm (Danger)
                    </button>
                    <button type="button"
                            class="btn btn-warning btn-sm"
                            data-erp-confirm="Bạn có chắc chắn muốn khóa sổ kỳ lương tháng 04/2026 không?"
                            data-erp-confirm-title="Khóa sổ bảng lương"
                            data-erp-confirm-variant="warning"
                            id="sgBtnDeclarativeConfirm">
                        <i class="bi bi-lock me-1"></i>Declarative Confirm
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-drawer-open="sgRightDrawer">
