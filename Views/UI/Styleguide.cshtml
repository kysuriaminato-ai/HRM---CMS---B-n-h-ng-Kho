@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    // 1. Live Module Switcher
    var modButtons = document.querySelectorAll('[data-sg-module]');
    modButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
            var mod = btn.getAttribute('data-sg-module');
            ERP.withViewTransition(function () {
                if (window.setErpModule) {
                    window.setErpModule(mod);
                } else {
                    document.documentElement.setAttribute('data-module', mod);
                }
                modButtons.forEach(function (b) { b.classList.toggle('active', b === btn); });
            });
        });
    });

    // 2. Reduced Motion Indicator
    var motionBadge = document.getElementById('sgMotionStatusBadge');
    var mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    function syncMotionBadge() {
        if (!motionBadge) return;
        if (mq.matches) {
            motionBadge.textContent = 'Motion: Reduced (Tôn trọng cài đặt hệ thống)';
            motionBadge.className = 'erp-badge erp-badge-warning erp-badge-dot';
        } else {
            motionBadge.textContent = 'Motion: Full Animations';
            motionBadge.className = 'erp-badge erp-badge-success erp-badge-dot';
        }
    }
    syncMotionBadge();
    if (mq.addEventListener) mq.addEventListener('change', syncMotionBadge);

    // 3. Programmatic & Declarative Confirm Demo
    var progBtn = document.getElementById('sgBtnProgrammaticConfirm');
    if (progBtn) {
        progBtn.addEventListener('click', function () {
            ERP.confirm({
                title: 'Xác nhận xóa chứng từ mẫu?',
                message: 'Thao tác này minh họa hộp thoại ERP.confirm() dùng chung trên toàn hệ thống.',
                confirmText: 'Xóa bản ghi',
                variant: 'danger',
                onConfirm: function () {
                    ERP.toast('Đã xác nhận thao tác xóa mẫu!', 'success');
                }
            });
        });
    }

    var declBtn = document.getElementById('sgBtnDeclarativeConfirm');
    if (declBtn) {
        declBtn.addEventListener('erp:confirmed', function () {
            ERP.toast('Đã khóa sổ kỳ lương mẫu thành công!', 'info');
        });
    }

    // 4. Form Validation Shake + Success Tick Demo
    var demoForm = document.getElementById('sgDemoValidationForm');
    var reqInput = document.getElementById('sgRequiredInput');
    if (demoForm && reqInput) {
        demoForm.addEventListener('submit', function (e) {
            e.preventDefault();
            if (!reqInput.value.trim()) {
                reqInput.classList.add('is-invalid');
                ERP.shake(demoForm);
                ERP.toast('Vui lòng nhập mã phê duyệt trước khi gửi!', 'danger');
            } else {
                reqInput.classList.remove('is-invalid');
                reqInput.classList.add('is-valid');
                ERP.successTick('#sgTickMount', 'Mã hợp lệ!');
                ERP.toast('Kiểm tra hợp lệ thành công!', 'success');
            }
        });
    }

    // 5. View Transition Card Swap Demo
    var vtBtn = document.getElementById('sgBtnViewTransition');
    var vtText = document.getElementById('sgTransitionText');
    var vtBadge = document.getElementById('sgTransitionBadge');
    var compact = false;
    if (vtBtn && vtText && vtBadge) {
        vtBtn.addEventListener('click', function () {
            compact = !compact;
            ERP.withViewTransition(function () {
                if (compact) {
                    vtText.innerHTML = '<i class="bi bi-list-check me-2"></i>Chế độ hiển thị: <strong>Mật độ cao (Enterprise Dense)</strong>';
                    vtBadge.textContent = 'Compact ON';
                    vtBadge.className = 'erp-badge erp-badge-success';
                } else {
                    vtText.innerHTML = '<i class="bi bi-grid-1x2 me-2"></i>Chế độ hiển thị: <strong>Tổng quan tiêu chuẩn</strong>';
                    vtBadge.textContent = 'Compact OFF';
                    vtBadge.className = 'erp-badge erp-badge-primary';
                }
            });
        });
    }
});
</script>
}
