@model ERP_HRM_CMS.Models.Entities.PayrollPeriod
@{
    ViewData["Title"] = $"Bảng lương kỳ {Model?.Month:D2}/{Model?.Year}";
    ViewData["Module"] = "payroll";
    ViewData["BreadcrumbSection"] = "Tiền lương & Phúc lợi";
}

<erp-page-header title="@(Model?.Name ?? "Bảng Tính Lương Doanh Nghiệp")"
                 subtitle="Hệ thống tự động đồng bộ ngày công thực tế, đơn từ, bảo hiểm bắt buộc và thuế TNCN lũy tiến"
                 icon="bi-cash-stack"
                 breadcrumbs="Dashboard:/|Tiền lương & Phúc lợi:/BangLuong/Index|Bảng lương chi tiết">
    <a href="/BangLuong/ExportExcel/@Model?.Id" class="btn btn-outline-success btn-sm">
        <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel lương
    </a>
    <a href="/BangLuong/ExportBangKeBaoHiem/@Model?.Id" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-file-earmark-spreadsheet me-1"></i> Trích nộp BHXH
    </a>
    <a href="/BangLuong/XuatUyNhiemChi/@Model?.Id" class="btn btn-outline-danger btn-sm" title="Chỉ SuperAdmin/Kế toán lương">
        <i class="bi bi-bank me-1"></i> Xuất Ủy Nhiệm Chi (UNC)
    </a>
    @if (Model != null && Model.Status != ERP_HRM_CMS.Models.Enums.PayrollPeriodStatus.Locked && Model.Status != ERP_HRM_CMS.Models.Enums.PayrollPeriodStatus.Paid)
    {
        <form method="post" asp-action="KhoaBangLuong" asp-route-id="@Model.Id" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn KHÓA kỳ lương này? Sau khi khóa sẽ không thể tính lại tự động.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-warning btn-sm"><i class="bi bi-lock me-1"></i> Khóa kỳ lương</button>
        </form>
    }
    @if (Model != null && Model.Status == ERP_HRM_CMS.Models.Enums.PayrollPeriodStatus.Locked)
    {
        <form method="post" asp-action="ChuyenChiTra" asp-route-id="@Model.Id" class="d-inline" onsubmit="return confirm('Xác nhận đã chi trả lương và phát hành phiếu lương cho toàn bộ nhân sự?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-circle me-1"></i> Chi trả &amp; Phát hành</button>
        </form>
    }
    <form method="post" asp-action="GuiPhieuLuong" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn gửi thông báo phiếu lương Real-time tới TOÀN BỘ nhân sự?');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="payrollPeriodId" value="@Model?.Id" />
        <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-send-check me-1"></i> Gửi phiếu lương</button>
    </form>
    <button type="button" class="btn btn-primary btn-sm ripple" data-bs-toggle="modal" data-bs-target="#modalTinhLuong">
        <i class="bi bi-calculator me-1"></i> Tính lại lương tự động
    </button>
</erp-page-header>

<!-- Bộ lọc kỳ lương -->
<erp-filter-bar method="get">
    <div class="col-md-2 col-6">
        <label class="form-label small fw-semibold mb-1">Tháng lương</label>
        <select name="month" class="form-select form-select-sm">
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(m == ViewBag.SelectedMonth)">Tháng @m</option>
            }
        </select>
    </div>
    <div class="col-md-2 col-6">
        <label class="form-label small fw-semibold mb-1">Năm</label>
        <select name="year" class="form-select form-select-sm tabular-nums">
            @for (int y = 2024; y <= 2027; y++)
            {
                <option value="@y" selected="@(y == ViewBag.SelectedYear)">Năm @y</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small fw-semibold mb-1">Phòng ban</label>
        <select name="departmentId" class="form-select form-select-sm">
            <option value="">-- Toàn bộ phòng ban --</option>
            @if (ViewBag.Departments != null)
            {
                @foreach (var d in (IEnumerable<ERP_HRM_CMS.Models.Entities.Department>)ViewBag.Departments)
                {
                    <option value="@d.Id" selected="@(d.Id == ViewBag.DepartmentId)">@d.Name</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small fw-semibold mb-1">Tìm kiếm nhân sự</label>
        <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control form-control-sm" placeholder="Mã NV, Họ tên..." />
    </div>
    <div class="col-md-2 d-flex gap-1 align-items-end">
        <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>Xem kỳ</button>
        <a href="/BangLuong/Index" class="btn btn-sm btn-outline-secondary" title="Kỳ hiện tại"><i class="bi bi-calendar-event"></i></a>
    </div>
</erp-filter-bar>

@if (ViewBag.IsAttendanceLocked == false)
{
    <div class="alert alert-warning d-flex align-items-center mb-4 border-warning shadow-sm">
        <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
        <div>
            <strong>Cảnh báo khóa kỳ công:</strong> Kỳ chấm công Tháng @ViewBag.SelectedMonth/@ViewBag.SelectedYear hiện tại <strong>chưa được khóa</strong>! Số liệu ngày công và giờ làm thêm OT có thể tiếp tục biến động. Hãy chốt và khóa kỳ công trước khi phê duyệt chi trả lương.
        </div>
    </div>
}

@if (ViewBag.Comparison != null)
{
    var comp = (ERP_HRM_CMS.Models.ViewModels.PayrollComparisonDto)ViewBag.Comparison;
    <div class="card erp-card mb-4 bg-light-subtle border">
        <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-bar-chart-steps text-primary fs-5"></i>
                <span class="fw-semibold small">Biến động so với Kỳ trước (@comp.PreviousPeriodName):</span>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-4 text-nowrap small">
                <div>
                    <span class="text-muted">Tổng quỹ Net:</span>
                    <strong class="tabular-nums">@comp.CurrentTotalNet.ToString("N0") đ</strong>
                    @if (comp.TotalNetChange >= 0)
                    {
                        <span class="badge bg-danger-subtle text-danger ms-1">
                            <i class="bi bi-arrow-up-right"></i> +@comp.TotalNetChange.ToString("N0") đ (+@comp.TotalNetChangePercent.ToString("F1")%)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success ms-1">
                            <i class="bi bi-arrow-down-right"></i> @comp.TotalNetChange.ToString("N0") đ (@comp.TotalNetChangePercent.ToString("F1")%)
                        </span>
                    }
                </div>
                <div>
                    <span class="text-muted">Quy mô nhân sự:</span>
                    <strong class="tabular-nums">@comp.CurrentEmployeeCount nhân sự</strong>
                    @if (comp.EmployeeCountChange >= 0)
                    {
                        <span class="badge bg-primary-subtle text-primary ms-1">+@comp.EmployeeCountChange NV</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary ms-1">@comp.EmployeeCountChange NV</span>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Thống kê tài chính kỳ lương -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <erp-stat-card label="Tổng Quỹ Lương (Gross)" value="@(Model?.TotalGrossSalary.ToString("N0") ?? "0") đ" icon="bi-wallet2" variant="primary" />
    </div>
    <div class="col-6 col-md-3">
        <erp-stat-card label="Tổng Thực Lĩnh (Net)" value="@(Model?.TotalNetSalary.ToString("N0") ?? "0") đ" icon="bi-cash-coin" variant="success" />
    </div>
    <div class="col-6 col-md-3">
        <erp-stat-card label="Trích Nộp Bảo Hiểm (10.5%)" value="@(Model?.TotalInsurance.ToString("N0") ?? "0") đ" icon="bi-shield-shaded" variant="info" />
    </div>
    <div class="col-6 col-md-3">
        <erp-stat-card label="Thuế TNCN Tạm Tính" value="@(Model?.TotalPIT.ToString("N0") ?? "0") đ" icon="bi-receipt-cutoff" variant="warning" />
    </div>
</div>

<!-- Bảng chi tiết lương nhân sự -->
<div class="card erp-card mb-4">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="fw-bold">
            <i class="bi bi-table me-2 text-primary"></i>Danh Sách Bảng Lương Chi Tiết (@(Model?.SalarySlips?.Count ?? 0) nhân sự)
        </div>
        <div class="small text-muted tabular-nums">
            Công chuẩn: <strong class="text-dark">@(Model?.StandardWorkDays ?? 22) ngày</strong> | Trạng thái: <erp-status-badge variant="success" label="@(Model != null ? ERP_HRM_CMS.Helpers.WorkflowStatusUiHelper.ResolveObject(Model.Status, "PayrollPeriod").Label : "DRAFT")" dot="true" />
        </div>
    </div>
    <div class="table-responsive">
        <table class="table erp-table sticky-thead mb-0 align-middle">
            <thead>
                <tr>
                    <th class="sticky-col-1" style="width: 50px;">STT</th>
                    <th class="sticky-col-2">Nhân Sự</th>
                    <th>Chức Vụ &amp; Phòng Ban</th>
                    <th class="text-end">Lương HĐ</th>
                    <th class="text-center">Công Thực</th>
                    <th class="text-end">Lương Ngày Công</th>
                    <th class="text-end">Phụ Cấp &amp; Thưởng</th>
                    <th class="text-end">Thu Nhập (Gross)</th>
                    <th class="text-end">Giảm Trừ</th>
                    <th class="text-end text-success fw-bold">THỰC LĨNH (NET)</th>
                    <th class="text-center" style="width: 100px;">Trạng Thái</th>
                    <th class="text-end sticky-col-actions" style="width: 130px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.SalarySlips != null && Model.SalarySlips.Any())
                {
                    int stt = 1;
                    @foreach (var slip in Model.SalarySlips.OrderBy(s => s.Employee.EmployeeCode))
                    {
                        decimal totalAllowances = slip.PositionAllowance + slip.LunchAllowance + slip.OtherAllowance + slip.Bonus;
                        decimal totalDeductions = slip.TotalInsurance + slip.PersonalIncomeTax + slip.LatePenalty;
                        <tr>
                            <td class="sticky-col-1 text-center text-muted tabular-nums">@(stt++)</td>
                            <td class="sticky-col-2">
                                <a href="/NhanSu/Details/@slip.EmployeeId" class="fw-bold text-decoration-none text-primary">@slip.Employee.FullName</a>
                                <div class="font-monospace text-muted small tabular-nums">@slip.Employee.EmployeeCode</div>
                            </td>
                            <td>
                                <div class="small fw-semibold text-primary">@(slip.Employee.Position?.Name ?? "-")</div>
                                <div class="text-muted" style="font-size: 11px;">@(slip.Employee.Department?.Name ?? "-")</div>
                            </td>
                            <td class="text-end tabular-nums">@slip.BasicSalary.ToString("N0") đ</td>
                            <td class="text-center tabular-nums">
                                <span class="badge bg-light text-dark border fw-bold">@slip.ActualWorkDays / @slip.StandardDays</span>
                                @if (slip.PaidLeaveDays > 0)
                                {
                                    <div class="text-info" style="font-size: 10px;">+@slip.PaidLeaveDays phép</div>
                                }
                                @if (slip.OvertimeHours > 0)
                                {
                                    <div class="text-warning" style="font-size: 10px;">+@slip.OvertimeHours h OT</div>
                                }
                            </td>
                            <td class="text-end tabular-nums">@slip.StandardWorkSalary.ToString("N0") đ</td>
                            <td class="text-end tabular-nums text-success">+@totalAllowances.ToString("N0") đ</td>
                            <td class="text-end tabular-nums fw-semibold text-primary">@slip.GrossSalary.ToString("N0") đ</td>
                            <td class="text-end tabular-nums text-danger">-@totalDeductions.ToString("N0") đ</td>
                            <td class="text-end tabular-nums fw-bold text-success fs-6">@slip.NetSalary.ToString("N0") đ</td>
                            <td class="text-center">
                                <erp-status-badge variant="success" label="Đã tính" dot="true" />
                            </td>
                            <td class="text-end sticky-col-actions">
                                <a href="/BangLuong/PhieuLuong/@slip.Id" class="btn btn-sm btn-outline-primary" title="Xem & In phiếu lương">
                                    <i class="bi bi-receipt me-1"></i>Phiếu
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="12" class="p-0 border-0">
                            <erp-empty-state icon="bi-cash-coin"
                                             title="Kỳ lương chưa có dữ liệu"
                                             description="Chưa có dữ liệu tính toán lương cho kỳ được chọn."
                                             action-text="Tính lại lương tự động"
                                             action-url="javascript:new bootstrap.Modal(document.getElementById('modalTinhLuong')).show()" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Tính Lại Lương -->
<div class="modal fade" id="modalTinhLuong" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-action="TinhLuongTuDong" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-calculator me-2 text-primary"></i>Tính Toán Lương Tự Động</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info py-2 small mb-3">
                    Hệ thống sẽ quét hợp đồng còn hiệu lực, tổng hợp ngày công và đơn nghỉ phép được duyệt trong kỳ để tính toán lại toàn bộ.
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Tháng tính lương</label>
                        <select name="month" class="form-select form-select-sm">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m" selected="@(m == ViewBag.SelectedMonth)">Tháng @m</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Năm tính lương</label>
                        <input type="number" name="year" value="@ViewBag.SelectedYear" class="form-control form-control-sm tabular-nums" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Số ngày công chuẩn của tháng</label>
                        <input type="number" name="standardDays" value="@(Model?.StandardWorkDays ?? 22)" class="form-control form-control-sm tabular-nums" />
                        <div class="form-text" style="font-size: 11px;">Mặc định 22 hoặc 26 ngày tùy chế độ làm việc.</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-play-fill me-1"></i>Bắt Đầu Tính Lương</button>
            </div>
        </form>
    </div>
</div>
