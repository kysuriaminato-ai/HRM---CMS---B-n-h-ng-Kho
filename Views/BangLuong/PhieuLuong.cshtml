@model ERP_HRM_CMS.Models.Entities.SalarySlip
@{
    ViewData["Title"] = $"Phiếu Lương - {Model.Employee.FullName} ({Model.PayrollPeriod.Name})";
    ViewData["Module"] = "payroll";
    ViewData["BreadcrumbSection"] = "Tiền lương & Phúc lợi";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3 d-print-none">
            <a href="/BangLuong/Index?month=@Model.PayrollPeriod.Month&year=@Model.PayrollPeriod.Year" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại Bảng Lương
            </a>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary btn-sm ripple" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> In Phiếu Lương (A4 / A5)
                </button>
            </div>
        </div>

        <div class="card erp-card erp-printable p-4 shadow-sm border print-document" id="printablePayslip">
            <!-- 1. HEADER CÔNG TY -->
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary text-white p-2 text-center d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-building fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-uppercase text-primary">Tập Đoàn Công Nghệ Tiên Phong</h5>
                        <div class="small text-muted">Hệ Thống Quản Trị Nguồn Nhân Lực Enterprise HRM</div>
                    </div>
                </div>
                <div class="text-end">
                    <erp-status-badge variant="success" label="@ERP_HRM_CMS.Helpers.WorkflowStatusUiHelper.ResolveObject(Model.Status, "SalarySlip").Label" dot="true" />
                    <div class="small text-muted mt-1 tabular-nums">Mã Phiếu: <strong class="font-monospace text-dark">PS-@Model.PayrollPeriod.Year@Model.PayrollPeriod.Month.ToString("D2")-@Model.Employee.EmployeeCode</strong></div>
                </div>
            </div>

            <!-- TIÊU ĐỀ PHIẾU -->
            <div class="text-center my-3">
                <h4 class="fw-bold mb-1 text-uppercase text-dark print-doc-title">PHIẾU BÁO LƯƠNG NHÂN VIÊN</h4>
                <div class="text-muted small fst-italic">Kỳ thanh toán: @Model.PayrollPeriod.Name (Công chuẩn: @Model.StandardDays ngày)</div>
            </div>

            <!-- 2. THÔNG TIN NHÂN SỰ -->
            <div class="p-3 bg-light rounded-3 mb-4 border">
                <div class="row g-2 small">
                    <div class="col-sm-6">
                        <span class="text-muted">Họ và tên:</span> <strong class="text-dark fs-6">@Model.Employee.FullName</strong>
                    </div>
                    <div class="col-sm-6 tabular-nums">
                        <span class="text-muted">Mã nhân viên:</span> <strong class="font-monospace text-primary">@Model.Employee.EmployeeCode</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted">Phòng ban:</span> <strong class="text-dark">@(Model.Employee.Department?.Name ?? "-")</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted">Chức vụ:</span> <strong class="text-dark">@(Model.Employee.Position?.Name ?? "-")</strong>
                    </div>
                    <div class="col-sm-6 tabular-nums">
                        <span class="text-muted">Tài khoản thụ hưởng:</span> <strong class="font-monospace text-dark">@(Model.Employee.EmployeeDetail?.BankAccountNumber ?? "-")</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted">Ngân hàng:</span> <strong class="text-dark">@(Model.Employee.EmployeeDetail?.BankName ?? "-")</strong>
                    </div>
                </div>
            </div>

            <!-- 3. BẢNG CHI TIẾT THU NHẬP VÀ KHẤU TRỪ 2 CỘT -->
            <div class="row g-3 mb-4">
                <!-- CỘT 1: CÁC KHOẢN THU NHẬP (EARNINGS) -->
                <div class="col-md-6">
                    <div class="border rounded-3 h-100 overflow-hidden">
                        <div class="p-2 bg-primary bg-opacity-10 text-primary fw-bold small text-uppercase">
                            <i class="bi bi-plus-circle me-1"></i> I. Các Khoản Thu Nhập
                        </div>
                        <table class="table table-sm table-borderless mb-0 small">
                            <tbody>
                                <tr class="border-bottom">
                                    <td class="text-muted">Lương hợp đồng lao động:</td>
                                    <td class="text-end font-monospace fw-semibold tabular-nums">@Model.BasicSalary.ToString("N0") đ</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Ngày công thực tế:</td>
                                    <td class="text-end font-monospace tabular-nums">@Model.ActualWorkDays / @Model.StandardDays ngày</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Nghỉ phép hưởng lương:</td>
                                    <td class="text-end font-monospace tabular-nums">@Model.PaidLeaveDays ngày</td>
                                </tr>
                                <tr class="border-bottom">
                                    <td class="fw-semibold text-dark">Lương ngày công:</td>
                                    <td class="text-end font-monospace fw-bold tabular-nums">@Model.StandardWorkSalary.ToString("N0") đ</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Làm thêm giờ (OT: @Model.OvertimeHours h):</td>
                                    <td class="text-end font-monospace tabular-nums">@Model.OvertimeSalary.ToString("N0") đ</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Phụ cấp chức vụ / trách nhiệm:</td>
                                    <td class="text-end font-monospace tabular-nums">@Model.PositionAllowance.ToString("N0") đ</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Phụ cấp ăn trưa:</td>
                                    <td class="text-end font-monospace tabular-nums">@Model.LunchAllowance.ToString("N0") đ</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Phụ cấp khác:</td>
                                    <td class="text-end font-monospace tabular-nums">@Model.OtherAllowance.ToString("N0") đ</td>
                                </tr>
                                <tr class="border-bottom">
                                    <td class="text-muted">Thưởng hiệu quả / KPI:</td>
                                    <td class="text-end font-monospace text-success tabular-nums">+@Model.Bonus.ToString("N0") đ</td>
                                </tr>
                                <tr class="bg-light">
                                    <td class="fw-bold text-uppercase text-primary">TỔNG THU NHẬP (GROSS):</td>
                                    <td class="text-end font-monospace fw-bold text-primary fs-6 tabular-nums">@Model.GrossSalary.ToString("N0") đ</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- CỘT 2: CÁC KHOẢN GIẢM TRỪ (DEDUCTIONS) -->
                <div class="col-md-6">
                    <div class="border rounded-3 h-100 overflow-hidden">
                        <div class="p-2 bg-danger bg-opacity-10 text-danger fw-bold small text-uppercase">
                            <i class="bi bi-dash-circle me-1"></i> II. Các Khoản Giảm Trừ
                        </div>
                        <table class="table table-sm table-borderless mb-0 small">
                            <tbody>
                                <tr>
                                    <td class="text-muted">BHXH người LĐ trích nộp (8%):</td>
                                    <td class="text-end font-monospace tabular-nums">-@Model.SocialInsurance.ToString("N0") đ</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">BHYT người LĐ trích nộp (1.5%):</td>
                                    <td class="text-end font-monospace tabular-nums">-@Model.HealthInsurance.ToString("N0") đ</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">BHTN người LĐ trích nộp (1%):</td>
                                    <td class="text-end font-monospace tabular-nums">-@Model.UnemploymentInsurance.ToString("N0") đ</td>
                                </tr>
                                <tr class="border-bottom">
                                    <td class="fw-semibold text-dark">Tổng bảo hiểm (10.5%):</td>
                                    <td class="text-end font-monospace fw-bold text-danger tabular-nums">-@Model.TotalInsurance.ToString("N0") đ</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Phạt vi phạm / đi muộn:</td>
                                    <td class="text-end font-monospace text-danger tabular-nums">-@Model.LatePenalty.ToString("N0") đ</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Thu nhập chịu thuế TNCN:</td>
                                    <td class="text-end font-monospace tabular-nums">@Model.TaxableIncome.ToString("N0") đ</td>
                                </tr>
                                <tr class="border-bottom">
                                    <td class="text-muted">Thuế TNCN tạm tính:</td>
                                    <td class="text-end font-monospace text-danger tabular-nums">-@Model.PersonalIncomeTax.ToString("N0") đ</td>
                                </tr>
                                <tr>
                                    <td colspan="2" class="text-muted fst-italic" style="font-size: 11px;">(Đã tính giảm trừ bản thân 11.000.000 đ)</td>
                                </tr>
                                <tr class="bg-light">
                                    <td class="fw-bold text-uppercase text-danger">TỔNG KHẤU TRỪ:</td>
                                    <td class="text-end font-monospace fw-bold text-danger fs-6 tabular-nums">-@((Model.TotalInsurance + Model.PersonalIncomeTax + Model.LatePenalty).ToString("N0")) đ</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 4. THỰC LĨNH CHÍNH THỨC -->
            <div class="p-3 bg-success bg-opacity-10 border border-success rounded-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <div class="text-success small fw-bold text-uppercase">THỰC LĨNH CHUYỂN KHOẢN (NET SALARY)</div>
                    <div class="small text-muted">Số tiền thực nhận sau khi hoàn thành mọi nghĩa vụ thuế và bảo hiểm</div>
                </div>
                <div class="text-end">
                    <span class="fs-3 fw-bold text-success font-monospace tabular-nums">@Model.NetSalary.ToString("N0") VNĐ</span>
                </div>
            </div>

            <!-- 5. CHỮ KÝ VÀ MÃ XÁC NHẬN -->
            <div class="row text-center mt-5 pt-3 small text-muted print-signatures">
                <div class="col-4 print-signature-box">
                    <div class="fw-bold text-dark print-sign-role">NGƯỜI LẬP PHIẾU</div>
                    <div class="fst-italic print-sign-note" style="font-size: 11px;">(Ký và ghi rõ họ tên)</div>
                    <div style="height: 60px;"></div>
                    <div class="fw-semibold text-dark print-sign-name">Phòng Nhân Sự</div>
                </div>
                <div class="col-4 print-signature-box">
                    <div class="fw-bold text-dark print-sign-role">KẾ TOÁN TRƯỞNG</div>
                    <div class="fst-italic print-sign-note" style="font-size: 11px;">(Ký và đóng dấu)</div>
                    <div style="height: 60px;"></div>
                    <div class="fw-semibold text-dark print-sign-name">Ban Tài Chính - Kế Toán</div>
                </div>
                <div class="col-4 print-signature-box">
                    <div class="fw-bold text-dark print-sign-role">NGƯỜI NHẬN TIỀN</div>
                    <div class="fst-italic print-sign-note" style="font-size: 11px;">(Xác nhận tài khoản thụ hưởng)</div>
                    <div style="height: 60px;"></div>
                    <div class="fw-semibold text-dark print-sign-name">@Model.Employee.FullName</div>
                </div>
            </div>

            <div class="text-center text-muted small mt-4 pt-3 border-top d-print-none" style="font-size: 11px;">
                Mọi thắc mắc về số liệu chấm công, thuế và bảo hiểm, vui lòng liên hệ phòng Nhân sự trong vòng 03 ngày làm việc kể từ ngày nhận thông báo.
            </div>
        </div>
    </div>
</div>
