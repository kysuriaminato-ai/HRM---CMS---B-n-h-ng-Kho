@model IEnumerable<ERP_HRM_CMS.Models.Entities.Supplier>
@{
    ViewData["Title"] = "Quản Lý Nhà Cung Cấp (SCM)";
    Layout = "~/Views/Shared/_WarehouseLayout.cshtml";
    decimal totalDebt = ViewBag.TotalDebt ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-truck text-primary me-2"></i>Quản Lý Nhà Cung Cấp (Suppliers)</h4>
        <p class="text-muted small mb-0">Danh bạ nhà phân phối, theo dõi điều khoản công nợ và lịch sử mua hàng</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/PurchaseOrder/Index" class="btn btn-outline-secondary">
            <i class="bi bi-journal-text me-1"></i> Đơn Mua Hàng (PO)
        </a>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createSupplierModal">
            <i class="bi bi-plus-circle me-1"></i> Thêm Nhà Cung Cấp
        </button>
    </div>
</div>

<!-- Thống kê tổng quan -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 shadow-sm border-0">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">Tổng Số Nhà Cung Cấp</div>
                    <div class="fs-3 fw-bold text-primary">@Model.Count()</div>
                </div>
                <div class="bg-primary-subtle p-3 rounded-circle text-primary">
                    <i class="bi bi-building fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 shadow-sm border-0">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">Tổng Nợ Phải Trả NCC</div>
                    <div class="fs-3 fw-bold text-danger">@totalDebt.ToString("N0") đ</div>
                </div>
                <div class="bg-danger-subtle p-3 rounded-circle text-danger">
                    <i class="bi bi-cash-stack fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 shadow-sm border-0">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">Trạng Thái Hợp Tác</div>
                    <div class="fs-3 fw-bold text-success">@Model.Count(s => s.IsActive) Đang Hoạt Động</div>
                </div>
                <div class="bg-success-subtle p-3 rounded-circle text-success">
                    <i class="bi bi-check2-circle fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control border-start-0" 
                           placeholder="Tìm theo tên, mã NCC, MST, SĐT, Email..." />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary px-3"><i class="bi bi-filter me-1"></i> Lọc</button>
                @if (!string.IsNullOrEmpty(ViewBag.Keyword))
                {
                    <a href="/Supplier/Index" class="btn btn-outline-secondary px-3 ms-1">Xóa lọc</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách nhà cung cấp -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã NCC</th>
                    <th>Tên Nhà Cung Cấp</th>
                    <th>Thông Tin Liên Hệ</th>
                    <th>Mã Số Thuế</th>
                    <th>Công Nợ Phải Trả</th>
                    <th>Trạng Thái</th>
                    <th class="text-end">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border font-monospace">@s.Code</span>
                            </td>
                            <td>
                                <div class="fw-bold text-main">@s.Name</div>
                                <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@s.Address</div>
                            </td>
                            <td>
                                <div class="small"><i class="bi bi-telephone me-1 text-muted"></i>@(s.Phone ?? "Chưa có")</div>
                                <div class="small"><i class="bi bi-envelope me-1 text-muted"></i>@(s.Email ?? "Chưa có")</div>
                            </td>
                            <td>
                                <span class="font-monospace text-secondary">@(s.TaxCode ?? "Chưa cấp")</span>
                            </td>
                            <td>
                                @if (s.TotalDebt > 0)
                                {
                                    <span class="fw-bold text-danger">@s.TotalDebt.ToString("N0") đ</span>
                                }
                                else
                                {
                                    <span class="text-success small fw-semibold"><i class="bi bi-check-circle me-1"></i>Đã tất toán</span>
                                }
                            </td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border">Đang hợp tác</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">Tạm ngưng</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/PurchaseOrder/Create?supplierId=@s.Id" class="btn btn-sm btn-outline-primary py-1 px-2" title="Tạo đơn mua hàng">
                                    <i class="bi bi-cart-plus me-1"></i> Tạo PO
                                </a>
                                <button class="btn btn-sm btn-outline-secondary py-1 px-2 ms-1" onclick="editSupplier(@s.Id)" title="Chỉnh sửa thông tin">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Không tìm thấy nhà cung cấp nào phù hợp
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm Nhà Cung Cấp -->
<div class="modal fade" id="createSupplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg border-0">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold"><i class="bi bi-truck text-primary me-2"></i>Thêm Mới Nhà Cung Cấp</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Mã Nhà Cung Cấp <span class="text-danger">*</span></label>
                            <input type="text" name="Code" class="form-control" required placeholder="VD: NCC-SAMSUNG" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Mã Số Thuế</label>
                            <input type="text" name="TaxCode" class="form-control" placeholder="VD: 0102938475" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Tên Doanh Nghiệp / Nhà Cung Cấp <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control" required placeholder="Tên công ty hoặc nhà phân phối" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Số Điện Thoại</label>
                            <input type="text" name="Phone" class="form-control" placeholder="VD: 024 3828 9999" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Email Liên Hệ</label>
                            <input type="email" name="Email" class="form-control" placeholder="VD: contact@partner.com" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Địa Chỉ Trụ Sở</label>
                            <input type="text" name="Address" class="form-control" placeholder="Số nhà, đường, quận/huyện, tỉnh/thành" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-body-tertiary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-circle me-1"></i> Lưu Nhà Cung Cấp</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Chỉnh Sửa Nhà Cung Cấp -->
<div class="modal fade" id="editSupplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg border-0">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editId" name="Id" />
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Cập Nhật Nhà Cung Cấp</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Mã Nhà Cung Cấp</label>
                            <input type="text" id="editCode" class="form-control bg-light" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Mã Số Thuế</label>
                            <input type="text" id="editTaxCode" name="TaxCode" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Tên Nhà Cung Cấp <span class="text-danger">*</span></label>
                            <input type="text" id="editName" name="Name" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Số Điện Thoại</label>
                            <input type="text" id="editPhone" name="Phone" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Email Liên Hệ</label>
                            <input type="email" id="editEmail" name="Email" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Địa Chỉ</label>
                            <input type="text" id="editAddress" name="Address" class="form-control" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="editIsActive" name="IsActive" value="true" checked>
                                <label class="form-check-label fw-semibold small" for="editIsActive">Đang hoạt động / Tiếp tục hợp tác</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-body-tertiary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function editSupplier(id) {
        fetch('/Supplier/GetSupplier/' + id)
            .then(res => res.json())
            .then(data => {
                document.getElementById('editId').value = data.id;
                document.getElementById('editCode').value = data.code;
                document.getElementById('editName').value = data.name;
                document.getElementById('editTaxCode').value = data.taxCode || '';
                document.getElementById('editPhone').value = data.phone || '';
                document.getElementById('editEmail').value = data.email || '';
                document.getElementById('editAddress').value = data.address || '';
                document.getElementById('editIsActive').checked = data.isActive;
                new bootstrap.Modal(document.getElementById('editSupplierModal')).show();
            });
    }
</script>
}
