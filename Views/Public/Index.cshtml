<!-- ==========================================================================
     SCRIPTS: LỌC TRANG SỨC & TƯƠNG TÁC
     ========================================================================== -->
<!-- Token chống giả mạo cho API giỏ hàng -->
@Html.AntiForgeryToken()

<!-- Ảnh nổi khi rê chuột lên sản phẩm -->
<div id="jewelFloatPreview" class="pf-float-preview" aria-hidden="true">
    <img id="jewelFloatImg" src="" alt="" />
    <div class="pf-float-caption">
        <span id="jewelFloatName"></span>
        <small id="jewelFloatGia" class="d-block text-warning font-monospace"></small>
    </div>
</div>

<script>
(function () {
    'use strict';

    var grid = document.getElementById('jewelryGrid');
    if (!grid) { return; }

    var cards = Array.prototype.slice.call(grid.querySelectorAll('.jewelry-card-item'));
    var emptyBox = document.getElementById('jewelryEmpty');
    var countEl = document.getElementById('fltCount');
    var chipRow = document.getElementById('jewelryFilterBtns');

    var elKeyword = document.getElementById('fltKeyword');
    var elMaterial = document.getElementById('fltMaterial');
    var elPrice = document.getElementById('fltPrice');
    var elSort = document.getElementById('fltSort');

    var state = { cat: 'all', material: 'all', price: 'all', sort: 'default', keyword: '' };

    // Giữ thứ tự gốc để khôi phục khi chọn "Mặc định"
    cards.forEach(function (c, i) { c.dataset.order = String(i); });

    function stripAccent(v) {
        return (v || '').toString().toLowerCase()
            .normalize('NFD').replace(/[̀-ͯ]/g, '')
            .replace(/đ/g, 'd');
    }

    function priceInRange(price, range) {
        if (range === 'all') { return true; }
        var parts = range.split('-');
        var min = parseFloat(parts[0]) * 1000000;
        var max = parseFloat(parts[1]) * 1000000;
        return price >= min && price <= max;
    }

    function apply() {
        var shown = 0;
        var kw = stripAccent(state.keyword).trim();

        cards.forEach(function (card) {
            var okCat = state.cat === 'all' || card.dataset.category === state.cat;
            var okMat = state.material === 'all' || card.dataset.material === state.material;
            var okPrice = priceInRange(parseFloat(card.dataset.price || '0'), state.price);
            var hay = stripAccent(card.dataset.name + ' ' + card.dataset.gia + ' ' + card.dataset.sku);
            var okKw = kw === '' || hay.indexOf(kw) !== -1;

            var visible = okCat && okMat && okPrice && okKw;
            card.classList.toggle('d-none', !visible);
            if (visible) { shown++; }
        });

        // Sắp xếp
        var sorted = cards.slice();
        if (state.sort === 'price-asc') {
            sorted.sort(function (a, b) { return parseFloat(a.dataset.price) - parseFloat(b.dataset.price); });
        } else if (state.sort === 'price-desc') {
            sorted.sort(function (a, b) { return parseFloat(b.dataset.price) - parseFloat(a.dataset.price); });
        } else if (state.sort === 'name-asc') {
            sorted.sort(function (a, b) { return stripAccent(a.dataset.name).localeCompare(stripAccent(b.dataset.name)); });
        } else {
            sorted.sort(function (a, b) { return parseInt(a.dataset.order, 10) - parseInt(b.dataset.order, 10); });
        }
        sorted.forEach(function (c) { grid.appendChild(c); });

        if (countEl) { countEl.textContent = String(shown); }
        if (emptyBox) { emptyBox.classList.toggle('d-none', shown !== 0); }
    }

    // --- Dải danh mục ---
    function setActiveChip(cat) {
        if (!chipRow) { return; }
        Array.prototype.forEach.call(chipRow.querySelectorAll('button'), function (b) {
            var on = b.dataset.cat === cat;
            b.classList.toggle('btn-gold-luxury', on);
            b.classList.toggle('active', on);
            b.classList.toggle('btn-outline-gold', !on);
        });
    }

    if (chipRow) {
        chipRow.addEventListener('click', function (e) {
            var btn = e.target.closest('button[data-cat]');
            if (!btn) { return; }
            state.cat = btn.dataset.cat;
            setActiveChip(state.cat);
            apply();
        });
    }

    if (elKeyword) { elKeyword.addEventListener('input', function () { state.keyword = this.value; apply(); }); }
    if (elMaterial) { elMaterial.addEventListener('change', function () { state.material = this.value; apply(); }); }
    if (elPrice) { elPrice.addEventListener('change', function () { state.price = this.value; apply(); }); }
    if (elSort) { elSort.addEventListener('change', function () { state.sort = this.value; apply(); }); }

    var btnReset = document.getElementById('fltReset');
    if (btnReset) {
        btnReset.addEventListener('click', function () {
            state = { cat: 'all', material: 'all', price: 'all', sort: 'default', keyword: '' };
            if (elKeyword) { elKeyword.value = ''; }
            if (elMaterial) { elMaterial.value = 'all'; }
            if (elPrice) { elPrice.value = 'all'; }
            if (elSort) { elSort.value = 'default'; }
            setActiveChip('all');
            apply();
        });
    }

    // --- Lưới / Danh sách ---
    var btnGrid = document.getElementById('viewGrid');
    var btnList = document.getElementById('viewList');
    function setView(isList) {
        grid.classList.toggle('pf-view-list', isList);
        if (btnGrid && btnList) {
            btnGrid.classList.toggle('btn-gold-luxury', !isList);
            btnGrid.classList.toggle('btn-outline-gold', isList);
            btnList.classList.toggle('btn-gold-luxury', isList);
            btnList.classList.toggle('btn-outline-gold', !isList);
        }
    }
    if (btnGrid) { btnGrid.addEventListener('click', function () { setView(false); }); }
    if (btnList) { btnList.addEventListener('click', function () { setView(true); }); }

    // --- Ảnh nổi khi rê chuột ---
    var floatBox = document.getElementById('jewelFloatPreview');
    var floatImg = document.getElementById('jewelFloatImg');
    var floatName = document.getElementById('jewelFloatName');
    var floatGia = document.getElementById('jewelFloatGia');
    var canHover = window.matchMedia && window.matchMedia('(hover: hover) and (min-width: 992px)').matches;

    if (canHover && floatBox) {
        cards.forEach(function (card) {
            card.addEventListener('mouseenter', function () {
                var src = card.dataset.img;
                if (!src) { return; }
                floatImg.src = src;
                floatImg.alt = card.dataset.name || '';
                floatName.textContent = card.dataset.name || '';
                floatGia.textContent = card.dataset.gia || '';
                floatBox.classList.add('is-visible');
            });
            card.addEventListener('mousemove', function (e) {
                var w = 300, h = 330, pad = 18;
                var x = e.clientX + pad;
                var y = e.clientY + pad;
                if (x + w > window.innerWidth) { x = e.clientX - w - pad; }
                if (y + h > window.innerHeight) { y = window.innerHeight - h - pad; }
                if (y < pad) { y = pad; }
                floatBox.style.transform = 'translate(' + x + 'px,' + y + 'px)';
            });
            card.addEventListener('mouseleave', function () {
                floatBox.classList.remove('is-visible');
            });
        });
    }

    // --- Xem nhanh giấy kiểm định ---
    function cardOf(el) { return el.closest('.jewelry-card-item'); }

    grid.addEventListener('click', function (e) {
        var qv = e.target.closest('.js-quickview');
        if (qv) {
            var c = cardOf(qv);
            document.getElementById('modalJewelName').textContent = c.dataset.name;
            document.getElementById('modalJewelTitle').textContent = c.dataset.name;
            document.getElementById('modalJewelPrice').textContent = qv.dataset.priceText + ' VNĐ';
            document.getElementById('modalJewelDesc').textContent = qv.dataset.desc;
            document.getElementById('modalMaterial').textContent = qv.dataset.material;
            document.getElementById('modalCarat').textContent = qv.dataset.carat;
            document.getElementById('modalColor').textContent = qv.dataset.color;
            document.getElementById('modalClarity').textContent = qv.dataset.clarity;
            document.getElementById('modalGiaNum').textContent = c.dataset.gia;
            document.getElementById('modalJewelImg').src = c.dataset.img;
            new bootstrap.Modal(document.getElementById('quickViewModal')).show();
            return;
        }

        var od = e.target.closest('.js-order');
        if (od) { orderJewelry(cardOf(od), od); }
    });

    // --- Đặt mua: thêm vào giỏ rồi sang trang mua bán & thanh toán ---
    function toast(msg) {
        var el = document.getElementById('cartToast');
        var body = document.getElementById('toastMessage');
        if (!el || !body) { return; }
        body.textContent = msg;
        new bootstrap.Toast(el, { delay: 2500 }).show();
    }

    function orderJewelry(card, btn) {
        var realId = parseInt(card.dataset.realid || '0', 10);
        var name = card.dataset.name;
        var original = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...';

        if (!realId) {
            // Mẫu trưng bày chưa gắn mã kho: sang thẳng trang giỏ hàng & thanh toán
            toast('Đang mở trang mua bán & thanh toán cho "' + name + '".');
            window.location.href = '/GioHang';
            return;
        }

        var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
        fetch('/GioHang/AddToCartApi', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': tokenEl ? tokenEl.value : ''
            },
            body: JSON.stringify({ productId: realId, quantity: 1, branchId: 1 })
        })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function () { window.location.href = '/GioHang'; })
        .catch(function () {
            btn.disabled = false;
            btn.innerHTML = original;
            toast('Không thêm được vào giỏ. Vui lòng thử lại hoặc gọi hotline 1900 6868.');
        });
    }

    // --- Mở trang với bộ lọc sẵn: /?cat=nhan-kim-cuong#bo-suu-tap ---
    var params = new URLSearchParams(window.location.search);
    var catParam = params.get('cat');
    if (catParam && chipRow && chipRow.querySelector('button[data-cat="' + catParam + '"]')) {
        state.cat = catParam;
        setActiveChip(catParam);
    }

    apply();
})();
</script>
