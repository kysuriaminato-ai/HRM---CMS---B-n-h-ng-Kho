<!-- ==========================================================================
     HERO SECTION: TUYỆT TÁC TRANG SỨC KIM CƯƠNG VỚI CHUYỂN ĐỘNG TĨNH
     ========================================================================== -->
<section class="pf-hero-section position-relative py-5">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row align-items-center min-vh-75 py-4">
            <!-- Cột trái: Văn bản giới thiệu thương hiệu kim hoàn -->
            <div class="col-lg-7 text-start mb-5 mb-lg-0">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" 
                     style="background: rgba(212, 175, 55, 0.12); border: 1px solid rgba(212, 175, 55, 0.35);">
                    <i class="bi bi-gem text-warning"></i>
                    <span class="small font-monospace" style="color: #f7e8bd; letter-spacing: 0.15em;">
                        AURA BRILLIANCE • HAUTE JOAILLERIE & GIA DIAMONDS
                    </span>
                </div>

                <h1 class="display-3 font-serif fw-bold text-white mb-3" style="line-height: 1.15;">
                    Tuyệt Tác <span class="pf-gold-text">Kim Cương</span><br />
                    Đẳng Cấp Thượng Lưu
                </h1>

                <p class="lead text-secondary mb-4" style="max-width: 620px; font-weight: 300; line-height: 1.8;">
                    Mỗi viên kim cương tại <strong>AURA BRILLIANCE</strong> là một báu vật độc bản được chứng nhận bởi <strong>Viện Ngọc Học Hoa Kỳ GIA</strong>. Chế tác thủ công bởi các nghệ nhân kim hoàn bậc thầy trên chất liệu Bạch kim Platinum 950 và Vàng 18K nguyên khối.
                </p>

                <!-- Thống kê nhanh thông số uy tín -->
                <div class="row g-3 mb-4" style="max-width: 580px;">
                    <div class="col-4">
                        <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(212,175,55,0.2);">
                            <div class="fs-4 fw-bold text-warning font-serif">100%</div>
                            <div class="small text-secondary" style="font-size: 0.75rem;">Kim Cương GIA</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(212,175,55,0.2);">
                            <div class="fs-4 fw-bold text-warning font-serif">3EX</div>
                            <div class="small text-secondary" style="font-size: 0.75rem;">Giác Cắt Hoàn Hảo</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(212,175,55,0.2);">
                            <div class="fs-4 fw-bold text-warning font-serif">95%</div>
                            <div class="small text-secondary" style="font-size: 0.75rem;">Cam Kết Thu Đổi</div>
                        </div>
                    </div>
                </div>

                <!-- Nút hành động chính -->
                <div class="d-flex flex-wrap gap-3 align-items-center">
                    <a href="#jewelry-collection" class="btn btn-gold-luxury px-4 py-3">
                        <i class="bi bi-gem me-2"></i> KHÁM PHÁ BỘ SƯU TẬP
                    </a>
                    <a href="#gia-guide" class="btn btn-outline-gold px-4 py-3">
                        <i class="bi bi-award me-2"></i> CẨM NANG 4CS KIM CƯƠNG
                    </a>
                    <a href="/Auth/Register" class="btn btn-link text-warning text-decoration-none small ps-2">
                        <i class="bi bi-person-plus me-1"></i> Đăng Ký Hội Viên VIP
                    </a>
                </div>
            </div>

            <!-- Cột phải: Khối hiển thị nhẫn kim cương trung tâm với chuyển động tĩnh -->
            <div class="col-lg-5 text-center position-relative">
                <!-- Vòng hào quang kim cương tỏa sáng nhịp nhàng (pfAuraPulse) -->
                <div class="pf-aura-pulse position-absolute top-50 start-50 translate-middle" 
                     style="width: 380px; height: 380px; background: radial-gradient(circle, rgba(212,175,55,0.35) 0%, rgba(247,232,189,0.15) 45%, transparent 70%); border-radius: 50%; pointer-events: none; z-index: 1;">
                </div>

                <!-- Khung nhẫn kim cương bồng bềnh tĩnh (pfFloatBottle) -->
                <div class="pf-float-bottle position-relative d-inline-block" style="z-index: 3;">
                    <div class="position-relative p-4 rounded-4" 
                         style="background: linear-gradient(145deg, rgba(26,32,48,0.7) 0%, rgba(14,17,24,0.9) 100%); border: 1px solid rgba(212,175,55,0.4); box-shadow: 0 25px 60px rgba(0,0,0,0.8), 0 0 40px rgba(212,175,55,0.2);">
                        <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=700&q=80" 
                             alt="Nhẫn Kim Cương Solitaire Brilliant Cut" 
                             class="img-fluid rounded-3" 
                             style="max-height: 380px; object-fit: cover; filter: drop-shadow(0 15px 30px rgba(0,0,0,0.7));" />
                        
                        <!-- Huy hiệu chứng chỉ GIA nổi -->
                        <div class="position-absolute bottom-0 start-50 translate-middle-x mb-4 px-3 py-2 rounded-pill shadow-lg d-flex align-items-center gap-2"
                             style="background: rgba(8, 9, 13, 0.95); border: 1px solid var(--pf-gold); backdrop-filter: blur(10px); min-width: 260px; justify-content: center;">
                            <i class="bi bi-patch-check-fill text-warning fs-5"></i>
                            <div class="text-start">
                                <div class="fw-bold small text-white font-serif" style="letter-spacing: 0.05em;">GIA CERTIFIED D/VVS1</div>
                                <div class="text-secondary" style="font-size: 0.7rem;">Mã khắc laser cạnh: GIA-248910291</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

