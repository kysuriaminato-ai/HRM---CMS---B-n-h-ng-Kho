<!-- ==========================================================================
     PHẦN 1: HERO SECTION - HAUTE PARFUMERIE (CHUYỂN ĐỘNG TĨNH ĐẲNG CẤP)
     ========================================================================== -->
<section class="pf-hero-section">
    <!-- Lớp sương khói hương thơm mờ ảo trôi nhẹ nhàng (Chuyển động tĩnh) -->
    <div class="pf-mist-layer" style="width: 500px; height: 500px; top: -100px; left: -100px;"></div>
    <div class="pf-mist-layer" style="width: 600px; height: 600px; bottom: -150px; right: -100px; animation-delay: -5s;"></div>

    <div class="container position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <!-- Nội dung giới thiệu bên trái -->
            <div class="col-lg-6">
                <div class="pf-hero-badge">
                    <i class="bi bi-stars"></i> BỘ SƯU TẬP NICHE & HAUTE PARFUMERIE 2026
                </div>
                <h1 class="pf-hero-title">
                    Đánh Thức Giác Quan Với <span class="pf-gold-text">Tuyệt Tác Mùi Hương</span> Độc Bản
                </h1>
                <p class="pf-hero-desc">
                    Mỗi giọt nước hoa tại <strong>L'Aura Noir</strong> là một tác phẩm nghệ thuật điều hương thủ công từ Paris và Grasse. Chiết xuất tinh dầu nguyên bản 100%, bảo lưu độ lưu hương bất tận suốt 24 giờ.
                </p>

                <!-- Nút hành động -->
                <div class="d-flex flex-wrap gap-3 align-items-center mb-5">
                    <a href="#bo-suu-tap" class="btn pf-gold-shimmer-btn px-4 py-3 rounded-pill">
                        <i class="bi bi-bag-check me-2"></i> KHÁM PHÁ BỘ SƯU TẬP
                    </a>
                    <a href="#thap-mui-huong" class="btn btn-outline-light px-4 py-3 rounded-pill border-secondary" style="letter-spacing: 0.05em; font-weight: 600;">
                        <i class="bi bi-droplet me-2 text-warning"></i> KHÁM PHÁ THÁP HƯƠNG
                    </a>
                </div>

                <!-- Thống kê trực quan -->
                <div class="row g-4 pt-3 border-top border-secondary">
                    <div class="col-4">
                        <div class="fs-3 fw-bold text-warning font-serif">100%</div>
                        <div class="text-secondary small">Chính Hãng Pháp & Ý</div>
                    </div>
                    <div class="col-4">
                        <div class="fs-3 fw-bold text-warning font-serif">16H+</div>
                        <div class="text-secondary small">Độ Lưu Hương Vượt Trội</div>
                    </div>
                    <div class="col-4">
                        <div class="fs-3 fw-bold text-warning font-serif">15.000+</div>
                        <div class="text-secondary small">Tín Đồ Hương Thơm VIP</div>
                    </div>
                </div>
            </div>

            <!-- Hình ảnh chai nước hoa bồng bềnh tĩnh bên phải (Hero Visual) -->
            <div class="col-lg-6">
                <div class="pf-hero-visual">
                    <!-- Vòng hào quang thở nhịp nhàng (Aura Breathing Animation) -->
                    <div class="pf-hero-aura pf-aura-pulse"></div>

                    <!-- Chai nước hoa trôi bồng bềnh êm đềm tĩnh lặng (Float Animation) -->
                    <div class="pf-float-bottle position-relative text-center">
                        <img src="https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?auto=format&fit=crop&w=700&q=80" 
                             alt="Baccarat Rouge 540 Extrait" 
                             class="pf-hero-bottle-img" />
                    </div>

                    <!-- Thẻ nổi 1: Độ lưu hương -->
                    <div class="pf-hero-floating-card pf-card-tl pf-breathe-card">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle p-2" style="background: rgba(212,175,55,0.2); color: var(--pf-gold);">
                                <i class="bi bi-clock-history fs-4"></i>
                            </div>
                            <div>
                                <span class="d-block text-warning fw-bold small text-uppercase">Extrait de Parfum</span>
                                <strong class="text-light fs-6">Lưu Hương 16 - 24 Giờ</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Thẻ nổi 2: Tinh dầu tự nhiên -->
                    <div class="pf-hero-floating-card pf-card-br pf-breathe-card" style="animation-delay: -2.5s;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle p-2" style="background: rgba(212,175,55,0.2); color: var(--pf-gold);">
                                <i class="bi bi-patch-check-fill fs-4"></i>
                            </div>
                            <div>
                                <span class="d-block text-warning fw-bold small text-uppercase">Cam Kết Chất Lượng</span>
                                <strong class="text-light fs-6">100% Chuẩn Auth Tem QR</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     PHẦN 2: 4 CAM KẾT VÀNG TỪ L'AURA NOIR
     ========================================================================== -->
<section class="py-5" style="background: #06070a; border-bottom: 1px solid var(--pf-gold-border);">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="p-4 rounded-4 h-100" style="background: rgba(18,22,32,0.6); border: 1px solid rgba(212,175,55,0.15);">
                    <div class="text-warning fs-2 mb-3 pf-sparkle-icon"><i class="bi bi-shield-check"></i></div>
                    <h5 class="text-light fw-bold mb-2">Chính Hãng Trọn Đời</h5>
                    <p class="text-secondary small mb-0">Cam kết 100% nguyên seal nhập khẩu. Đền gấp 10 lần nếu phát hiện hàng không chính hãng.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="p-4 rounded-4 h-100" style="background: rgba(18,22,32,0.6); border: 1px solid rgba(212,175,55,0.15);">
                    <div class="text-warning fs-2 mb-3 pf-sparkle-icon"><i class="bi bi-gift"></i></div>
                    <h5 class="text-light fw-bold mb-2">Tặng 2 Sample 2ml</h5>
                    <p class="text-secondary small mb-0">Thử mùi sample trước khi bóc seal chai chính. Hỗ trợ đổi trả miễn phí nếu không ưng ý.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="p-4 rounded-4 h-100" style="background: rgba(18,22,32,0.6); border: 1px solid rgba(212,175,55,0.15);">
                    <div class="text-warning fs-2 mb-3 pf-sparkle-icon"><i class="bi bi-lightning-charge"></i></div>
                    <h5 class="text-light fw-bold mb-2">Giao Hỏa Tốc 2 Giờ</h5>
                    <p class="text-secondary small mb-0">Đóng gói hộp quà nhung sang trọng, giao nhanh 2h nội thành Hà Nội & TP. Hồ Chí Minh.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="p-4 rounded-4 h-100" style="background: rgba(18,22,32,0.6); border: 1px solid rgba(212,175,55,0.15);">
                    <div class="text-warning fs-2 mb-3 pf-sparkle-icon"><i class="bi bi-gem"></i></div>
                    <h5 class="text-light fw-bold mb-2">Tư Vấn Mùi Hương 1:1</h5>
                    <p class="text-secondary small mb-0">Đội ngũ chuyên gia mùi hương giàu kinh nghiệm sẵn sàng định hình chữ ký mùi hương của bạn.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     PHẦN 3: BỘ SƯU TẬP NƯỚC HOA CAO CẤP & BỘ LỌC TƯƠNG TÁC
     ========================================================================== -->
<section id="bo-suu-tap" class="py-5" style="background: var(--pf-bg-dark);">
    <div class="container py-4">
        <!-- Tiêu đề mục -->
        <div class="pf-section-head">
            <span class="pf-eyebrow">Haute Parfumerie Curation</span>
            <h2 class="pf-section-title">Tuyển Tập Nước Hoa Danh Tiếng Thế Giới</h2>
            <p class="text-secondary mx-auto mt-2" style="max-width: 600px;">
                Những chai nước hoa được khát khao nhất bởi giới mộ điệu, mang đậm tính nghệ thuật và cá tính độc bản.
            </p>
        </div>

        <!-- Bộ Lọc Nhóm Hương Tương Tác (Live Filter Pills) -->
        <div class="pf-filter-nav">
            <button class="pf-filter-btn active" onclick="filterPerfumes('all', this)">
                <i class="bi bi-grid me-1"></i> Tất Cả Tuyệt Tác
            </button>
            <button class="pf-filter-btn" onclick="filterPerfumes('nuoc-hoa-nam', this)">
                <i class="bi bi-gender-male me-1"></i> Nước Hoa Nam
            </button>
            <button class="pf-filter-btn" onclick="filterPerfumes('nuoc-hoa-nu', this)">
                <i class="bi bi-gender-female me-1"></i> Nước Hoa Nữ
            </button>
            <button class="pf-filter-btn" onclick="filterPerfumes('nuoc-hoa-niche', this)">
                <i class="bi bi-stars me-1"></i> Tuyệt Tác Niche
            </button>
        </div>

        <!-- Lưới sản phẩm nước hoa cao cấp -->
        <div class="row g-4" id="pfPerfumeGrid">
            @foreach (var p in luxuryPerfumes)
            {
                <div class="col-md-6 col-lg-4 col-xl-3 pf-item" data-category="@p.Category">
                    <div class="pf-card pf-breathe-card">
                        <!-- Hình ảnh chai nước hoa -->
                        <div class="pf-card-thumb-wrap">
                            <span class="pf-badge-hot">@p.Badge</span>
                            <span class="pf-badge-concentration">@p.Volume</span>
                            <img src="@p.Image" alt="@p.Name" class="pf-card-thumb" loading="lazy" />
                        </div>

                        <!-- Thông tin nước hoa -->
                        <div class="pf-card-body">
                            <div class="pf-brand-origin">@p.Origin • @p.CategoryName</div>
                            <h3 class="pf-prod-title" title="@p.Name">
                                <a href="javascript:void(0)" onclick="openPerfumeModal('@p.Name', '@p.Image', '@p.Price.ToString("N0") đ', '@p.TopNotes', '@p.HeartNotes', '@p.BaseNotes', '@p.Longevity', '@p.Projection')">@p.Name</a>
                            </h3>

                            <!-- Preview 3 tầng nốt hương -->
                            <div class="pf-scent-notes-preview">
                                <div><strong class="text-warning">Đầu:</strong> @p.TopNotes</div>
                                <div><strong class="text-warning">Giữa:</strong> @p.HeartNotes</div>
                                <div><strong class="text-warning">Cuối:</strong> @p.BaseNotes</div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-2 small text-secondary">
                                <span><i class="bi bi-clock-history me-1 text-warning"></i>@p.Longevity</span>
                                <span><i class="bi bi-broadcast me-1 text-warning"></i>@p.Projection</span>
                            </div>

                            <!-- Giá bán & Nút Thêm Vào Giỏ -->
                            <div class="pf-price-box">
                                <span class="pf-price-current">@p.Price.ToString("N0") ₫</span>
                                <span class="pf-price-old">@p.OldPrice.ToString("N0") ₫</span>
                            </div>

                            <button type="button" class="pf-btn-add-cart" onclick="addToCartPerfume('@p.Name')">
                                <i class="bi bi-bag-plus"></i> Thêm Vào Giỏ Hàng
                            </button>
                        </div>
