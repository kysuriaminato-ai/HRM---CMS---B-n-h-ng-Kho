<span id="bang-do-size" class="pf-anchor"></span>
<section class="py-5 position-relative" style="background: rgba(10,13,19,0.9); border-top: 1px solid rgba(212,175,55,0.2);">
    <div class="container py-3">
        <div class="text-center mb-5">
            <span class="badge px-3 py-2 rounded-pill mb-2 font-monospace" style="background: rgba(212,175,55,0.15); color: #f7e8bd; border: 1px solid rgba(212,175,55,0.3);">
                RING SIZE GUIDE • CHUẨN QUỐC TẾ
