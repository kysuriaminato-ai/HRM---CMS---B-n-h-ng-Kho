@section Scripts {
    <script>
        // Lọc sản phẩm theo danh mục mượt mà
        function filterPerfumes(category, btn) {
            // Cập nhật trạng thái nút
            document.querySelectorAll('.pf-filter-btn').forEach(function(b) {
                b.classList.remove('active');
            });
            btn.classList.add('active');

            // Lọc các thẻ sản phẩm
            var items = document.querySelectorAll('#pfPerfumeGrid .pf-item');
            items.forEach(function(item) {
                if (category === 'all' || item.getAttribute('data-category') === category) {
                    item.style.display = 'block';
                    item.style.opacity = '0';
                    setTimeout(function() {
                        item.style.transition = 'opacity 0.4s ease';
                        item.style.opacity = '1';
                    }, 50);
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // Thêm nước hoa vào giỏ hàng với thông báo Toast
        function addToCartPerfume(productName) {
            showPerfumeToast(productName);
        }

        // Mở Modal chi tiết nốt hương
        var currentModalProdName = "";
        function openPerfumeModal(name, img, price, top, heart, base, longevity, projection) {
            currentModalProdName = name;
            document.getElementById('pfModalTitle').textContent = name;
            document.getElementById('pfModalImg').src = img;
            document.getElementById('pfModalPrice').textContent = price;
            document.getElementById('pfModalTop').textContent = top;
            document.getElementById('pfModalHeart').textContent = heart;
            document.getElementById('pfModalBase').textContent = base;
            document.getElementById('pfModalLongevity').textContent = longevity;
            document.getElementById('pfModalProjection').textContent = projection;

            var modal = new bootstrap.Modal(document.getElementById('pfDetailModal'));
            modal.show();
        }

        function addToCartFromModal() {
            var modalEl = document.getElementById('pfDetailModal');
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
            addToCartPerfume(currentModalProdName);
        }

        // Trắc nghiệm chọn mùi hương
        function runScentQuiz() {
            var style = document.getElementById('quizStyle').value;
            var titleEl = document.getElementById('quizResultTitle');
            var descEl = document.getElementById('quizResultDesc');

            if (style === 'luxury') {
                titleEl.textContent = "Baccarat Rouge 540 Extrait de Parfum";
                descEl.textContent = "Hương thơm vương giả số 1 thế giới với nghệ tây, hoa nhài Ai Cập và long diên hương. Tỏa sáng trong mọi dạ tiệc.";
            } else if (style === 'mysterious') {
                titleEl.textContent = "Tom Ford Private Blend Oud Wood EDP";
                descEl.textContent = "Trầm hương Oud bí ẩn hòa quyện cùng bạch đậu khấu và vani đen, tạo nên phong thái quyến rũ không thể cưỡng lại.";
            } else if (style === 'fresh') {
                titleEl.textContent = "Bleu De Chanel Parfum Pour Homme";
                descEl.textContent = "Sự tươi mát bùng nổ từ chanh vàng Ý và bạc hà tuyết, lắng đọng trên nền gỗ đàn hương New Caledonia thanh lịch.";
            } else {
                titleEl.textContent = "Le Labo Santal 33 (Biểu Tượng Niche)";
                descEl.textContent = "Hương gỗ đàn hương Úc, giấy cói và da thuộc độc bản dành riêng cho những tâm hồn tự do và khác biệt.";
            }

            var box = document.getElementById('quizResultBox');
            box.style.transform = 'scale(0.96)';
            setTimeout(function() {
                box.style.transition = 'transform 0.4s ease';
                box.style.transform = 'scale(1)';
            }, 100);
        }
    </script>
}
