                Xem tất cả <i class="bi bi-chevron-right"></i>
            </a>
        </div>

        <div class="pk-trend-row" role="list">
            @foreach (var xh in luxuryJewelry.Take(8))
            {
                <a class="pk-trend-item" role="listitem" href="/?cat=@xh.Category#bo-suu-tap" title="@xh.Name">
                    <span class="pk-trend-circle">
                        <img src="@(string.IsNullOrWhiteSpace(xh.Image) ? "/images/jewelry-placeholder.svg" : xh.Image)"
                             alt="@xh.CategoryName" loading="lazy"
                             onerror="this.onerror=null; this.alt=''; this.src='/images/jewelry-placeholder.svg';" />
                    </span>
                    <span class="pk-trend-label">@xh.CategoryName</span>
