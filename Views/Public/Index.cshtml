            }
        </div>

        <div class="row g-3 g-lg-4 mt-4">
            <div class="col-12 col-md-4">
                <a class="pk-promo pk-promo--rose" href="/?cat=nhan-kim-cuong#bo-suu-tap">
                    <span class="pk-promo-kicker">Bộ sưu tập cưới</span>
                    <div class="pk-promo-title">Lấp Lánh Rạng Ngời</div>
                    <div class="pk-promo-sub">Nhẫn cầu hôn kim cương GIA, khắc tên miễn phí trọn đời.</div>
