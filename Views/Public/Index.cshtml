                    <i class="bi bi-grid-fill me-1"></i> Tất Cả Tuyệt Tác
                </button>
                <button type="button" class="btn btn-sm btn-outline-gold px-3 py-2" onclick="filterJewelry('nhan-kim-cuong', this)">
                    <i class="bi bi-record-circle me-1"></i> Nhẫn Kim Cương
                </button>
                <button type="button" class="btn btn-sm btn-outline-gold px-3 py-2" onclick="filterJewelry('vong-tay-lac-tay', this)">
                    <i class="bi bi-circle me-1"></i> Vòng & Lắc Tay
                </button>
                <button type="button" class="btn btn-sm btn-outline-gold px-3 py-2" onclick="filterJewelry('day-chuyen-mat-day', this)">
                    <i class="bi bi-heart me-1"></i> Dây Chuyền & Mặt Dây
                </button>
                <button type="button" class="btn btn-sm btn-outline-gold px-3 py-2" onclick="filterJewelry('bong-tai-cao-cap', this)">
                    <i class="bi bi-gem me-1"></i> Bông Tai Cao Cấp
                </button>
                <button type="button" class="btn btn-sm btn-outline-gold px-3 py-2" onclick="filterJewelry('trang-suc-da-tiec', this)">
                    <i class="bi bi-stars me-1"></i> Tuyệt Tác Dạ Yến
                </button>
            </div>
        </div>

        <!-- Lưới sản phẩm trang sức -->
        <div class="row g-4" id="jewelryGrid">
            @foreach (var item in luxuryJewelry)
            {
                <div class="col-lg-4 col-md-6 jewelry-card-item" data-category="@item.Category">
                    <div class="card h-100 border-0 rounded-4 overflow-hidden position-relative" 
                         style="background: rgba(18, 22, 32, 0.88); border: 1px solid rgba(212,175,55,0.22) !important; transition: all 0.4s ease;">
                        
                        <!-- Badge nổi góc -->
                        <div class="position-absolute top-0 start-0 m-3" style="z-index: 3;">
                            <span class="badge px-3 py-2 rounded-pill font-monospace" 
                                  style="background: linear-gradient(135deg, rgba(212,175,55,0.9), rgba(170,134,36,0.9)); color: #0b0c10; font-weight: 700; font-size: 0.7rem; letter-spacing: 0.05em;">
                                @item.Badge
                            </span>
                        </div>

                        <!-- Mã GIA góc phải -->
                        <div class="position-absolute top-0 end-0 m-3" style="z-index: 3;">
                            <span class="badge bg-dark bg-opacity-75 border border-secondary text-warning small px-2 py-1 font-monospace" style="font-size: 0.65rem;">
                                <i class="bi bi-shield-check me-1"></i>@item.GiaNumber
                            </span>
                        </div>

                        <!-- Hình ảnh sản phẩm với hiệu ứng zoom nhẹ -->
                        <div class="position-relative overflow-hidden" style="height: 280px; background: #0b0d13;">
                            <img src="@item.Image" alt="@item.Name" 
                                 class="w-100 h-100 object-fit-cover jewelry-thumb" 
                                 style="transition: transform 0.6s ease;" />
                            <div class="position-absolute bottom-0 start-0 end-0 p-3" 
                                 style="background: linear-gradient(to top, rgba(14,18,26,0.95), transparent);">
                                <span class="text-warning small font-monospace"><i class="bi bi-gem me-1"></i>@item.CategoryName</span>
                            </div>
                        </div>

                        <!-- Nội dung chi tiết & thông số 4Cs -->
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <h5 class="font-serif fw-bold text-white mb-2" style="min-height: 52px; line-height: 1.3;">
                                    @item.Name
                                </h5>
                                
                                <p class="text-secondary small mb-3" style="line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @item.Desc
                                </p>

                                <!-- Bảng thông số kỹ thuật 4Cs & Chất liệu -->
                                <div class="p-3 rounded-3 mb-3" style="background: rgba(255,255,255,0.03); border: 1px dashed rgba(212,175,55,0.25);">
                                    <div class="row g-2 text-start small">
                                        <div class="col-6">
                                            <span class="text-muted d-block" style="font-size: 0.7rem;">Chất liệu đúc:</span>
                                            <strong class="text-light">@item.Material</strong>
                                        </div>
                                        <div class="col-6">
                                            <span class="text-muted d-block" style="font-size: 0.7rem;">Trọng lượng kim:</span>
                                            <strong class="text-warning font-monospace">@item.Carat</strong>
                                        </div>
                                        <div class="col-6">
                                            <span class="text-muted d-block" style="font-size: 0.7rem;">Nước màu:</span>
                                            <strong class="text-light font-monospace">@item.Color</strong>
                                        </div>
                                        <div class="col-6">
                                            <span class="text-muted d-block" style="font-size: 0.7rem;">Độ sạch & Giác:</span>
                                            <strong class="text-light font-monospace">@item.Clarity / 3EX</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Giá bán & Nút đặt mua / tư vấn -->
                            <div>
                                <div class="d-flex align-items-baseline justify-content-between mb-3">
                                    <div>
                                        <span class="fs-4 fw-bold font-serif text-warning">
                                            @item.Price.ToString("N0") <small style="font-size: 0.75rem;">VNĐ</small>
                                        </span>
                                        <del class="text-muted small ms-2" style="font-size: 0.8rem;">
                                            @item.OldPrice.ToString("N0") VNĐ
                                        </del>
                                    </div>
                                    <span class="badge bg-success-subtle text-success small">Có sẵn tại Showroom</span>
                                </div>

                                <div class="d-grid gap-2">
                                    <button type="button" class="btn btn-gold-luxury py-2" onclick="orderJewelry('@item.Name', '@item.Price.ToString("N0")')">
                                        <i class="bi bi-cart-plus me-1"></i> ĐẶT MUA / GIỮ HÀNG VIP
                                    </button>
                                    <button type="button" class="btn btn-outline-light btn-sm py-2" 
                                            onclick="openQuickView('@item.Name', '@item.Material', '@item.Carat', '@item.Color', '@item.Clarity', '@item.GiaNumber', '@item.Price.ToString("N0")', '@item.Image', '@item.Desc')">
                                        <i class="bi bi-eye me-1"></i> Xem Giấy Kiểm Định GIA
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ==========================================================================
     CẨM NANG 4CS KIM CƯƠNG GIA TƯƠNG TÁC (DIAMOND 4CS GUIDE)
     ========================================================================== -->
<section id="gia-guide" class="py-5 position-relative" style="background: rgba(14,18,26,0.85); border-top: 1px solid rgba(212,175,55,0.2);">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="badge px-3 py-2 rounded-pill mb-2 font-monospace" 
                      style="background: rgba(212,175,55,0.15); color: #f7e8bd; border: 1px solid rgba(212,175,55,0.3);">
                    TIÊU CHUẨN ĐỊNH DANH QUỐC TẾ
                </span>
                <h2 class="display-6 font-serif fw-bold text-white mb-3">
                    Tiêu Chuẩn 4Cs Của Viện Ngọc Học Hoa Kỳ (GIA)
                </h2>
                <p class="text-secondary leading-relaxed mb-4">
                    GIA là tổ chức sáng lập ra hệ thống đánh giá 4Cs được toàn cầu công nhận. Tại AURA BRILLIANCE, từng viên kim cương được tuyển chọn gắt gao vượt qua 4 tiêu chuẩn vàng:
                </p>

                <div class="accordion accordion-flush" id="accordion4Cs">
                    <!-- 1. Carat -->
                    <div class="accordion-item mb-2 rounded-3 border-0" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(212,175,55,0.2) !important;">
                        <h2 class="accordion-header" id="headingCarat">
                            <button class="accordion-button collapsed bg-transparent text-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCarat">
                                <i class="bi bi-gem text-warning me-2"></i> 1. Carat (Trọng Lượng Kim Cương)
                            </button>
                        </h2>
                        <div id="collapseCarat" class="accordion-collapse collapse" data-bs-parent="#accordion4Cs">
                            <div class="accordion-body text-secondary small pt-0">
                                1 Carat tương đương 200 miligam (khoảng 6.5mm đối với giác cắt tròn). Trọng lượng càng lớn, độ quý hiếm tăng theo cấp số nhân.
                            </div>
                        </div>
                    </div>

                    <!-- 2. Color -->
                    <div class="accordion-item mb-2 rounded-3 border-0" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(212,175,55,0.2) !important;">
                        <h2 class="accordion-header" id="headingColor">
                            <button class="accordion-button collapsed bg-transparent text-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseColor">
                                <i class="bi bi-droplet-half text-warning me-2"></i> 2. Color (Nước Màu - Thang Đo D Đến Z)
                            </button>
                        </h2>
                        <div id="collapseColor" class="accordion-collapse collapse" data-bs-parent="#accordion4Cs">
                            <div class="accordion-body text-secondary small pt-0">
                                AURA BRILLIANCE ưu tiên kim cương nước <strong>D, E, F (Colorless)</strong> - nhóm màu hoàn toàn không màu tinh khiết, mang lại vẻ lấp lánh như băng tuyết ngàn năm.
                            </div>
                        </div>
                    </div>

                    <!-- 3. Clarity -->
                    <div class="accordion-item mb-2 rounded-3 border-0" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(212,175,55,0.2) !important;">
                        <h2 class="accordion-header" id="headingClarity">
                            <button class="accordion-button collapsed bg-transparent text-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseClarity">
                                <i class="bi bi-eye text-warning me-2"></i> 3. Clarity (Độ Tinh Khiết)
                            </button>
                        </h2>
                        <div id="collapseClarity" class="accordion-collapse collapse" data-bs-parent="#accordion4Cs">
                            <div class="accordion-body text-secondary small pt-0">
                                Đo lường các tạp chất và tì vết dưới kính hiển vi phóng đại 10x. Tuyển chọn độc quyền cấp độ <strong>FL (Flawless), IF, VVS1, VVS2</strong> không tì vết.
                            </div>
                        </div>
                    </div>

                    <!-- 4. Cut -->
                    <div class="accordion-item mb-2 rounded-3 border-0" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(212,175,55,0.2) !important;">
                        <h2 class="accordion-header" id="headingCut">
                            <button class="accordion-button collapsed bg-transparent text-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCut">
                                <i class="bi bi-scissors text-warning me-2"></i> 4. Cut (Giác Cắt - Yếu Tố Quyết Định Độ Lửa)
                            </button>
                        </h2>
                        <div id="collapseCut" class="accordion-collapse collapse" data-bs-parent="#accordion4Cs">
                            <div class="accordion-body text-secondary small pt-0">
                                Giác cắt quyết định khả năng phản xạ và khúc xạ ánh sáng. 100% sản phẩm của chúng tôi đạt chuẩn <strong>Triple Excellent (3EX)</strong> đỉnh cao.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Thước đo size nhẫn & Hẹn lịch thử trực tiếp -->
            <div class="col-lg-6">
                <div class="p-4 rounded-4" style="background: linear-gradient(135deg, rgba(22,28,40,0.9), rgba(10,13,18,0.95)); border: 1px solid rgba(212,175,55,0.3); box-shadow: 0 20px 50px rgba(0,0,0,0.7);">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-calendar2-check-fill text-warning fs-3"></i>
                        <h4 class="font-serif fw-bold text-white mb-0">Đặt Lịch Thử Kim Cương VIP</h4>
                    </div>
                    <p class="text-secondary small mb-4">
                        Trải nghiệm phòng thử trang sức riêng tư (VIP Suite) với kính hiển vi quang học GIA và trà thảo mộc thượng hạng.
                    </p>

                    <form onsubmit="event.preventDefault(); alert('Cảm ơn Quý Khách! Chuyên viên kim hoàn VIP của AURA BRILLIANCE sẽ liên hệ xác nhận lịch hẹn trong 15 phút.');">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small text-secondary">Họ và tên Quý Khách (*):</label>
                                <input type="text" class="form-control bg-dark border-secondary text-white" placeholder="ví dụ: Nguyễn Hoàng Nam" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-secondary">Số điện thoại liên hệ (*):</label>
                                <input type="tel" class="form-control bg-dark border-secondary text-white" placeholder="ví dụ: 0988 668 888" required />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small text-secondary">Showroom trải nghiệm:</label>
                                <select class="form-select bg-dark border-secondary text-white">
                                    <option>Showroom Hà Nội (Số 1 Duy Tân, Cầu Giấy)</option>
                                    <option>Showroom TP. HCM (123 Nguyễn Thị Minh Khai, Q.1)</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-secondary">Dòng sản phẩm quan tâm:</label>
                                <select class="form-select bg-dark border-secondary text-white">
                                    <option>Nhẫn Cầu Hôn / Kim Cương Viên GIA</option>
                                    <option>Lắc Tay Tennis Platinum 950</option>
                                    <option>Dây Chuyền Mặt Kim Cương</option>
                                    <option>Bông Tai & Tuyệt Tác Dạ Yến</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small text-secondary">Ghi chú yêu cầu đặc biệt (khắc tên, size nhẫn, ngân sách):</label>
                            <textarea class="form-control bg-dark border-secondary text-white" rows="2" placeholder="Ví dụ: Cần tư vấn kim cương nước D 1.5ct, ngân sách khoảng 200 triệu..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-gold-luxury w-100 py-3">
                            <i class="bi bi-clock-history me-2"></i> XÁC NHẬN ĐẶT LỊCH HẸN VIP
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     MODAL XEM CHI TIẾT & CHỨNG THƯ GIA
     ========================================================================== -->
<div class="modal fade" id="quickViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 text-white" style="background: #0f131c; border: 1px solid rgba(212,175,55,0.4) !important;">
            <div class="modal-header border-bottom border-secondary border-opacity-25">
                <h5 class="modal-title font-serif fw-bold text-warning" id="modalJewelName">Chi Tiết Tuyệt Tác</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4">
                    <div class="col-md-5 text-center">
                        <img id="modalJewelImg" src="" alt="Jewelry Image" class="img-fluid rounded-3 mb-3 border border-secondary" style="max-height: 260px; object-fit: cover;" />
                        <div class="p-2 rounded bg-dark border border-warning border-opacity-50 text-warning small font-monospace">
                            <i class="bi bi-patch-check-fill me-1"></i> <span id="modalGiaNum">GIA-000000</span>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <h4 class="font-serif fw-bold text-white mb-2" id="modalJewelTitle">Tên Sản Phẩm</h4>
                        <div class="fs-4 fw-bold font-serif text-warning mb-3" id="modalJewelPrice">0 VNĐ</div>
                        
                        <p class="text-secondary small mb-3" id="modalJewelDesc">Mô tả chi tiết</p>

                        <div class="p-3 rounded-3 mb-4" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(212,175,55,0.2);">
                            <div class="row g-2 small">
                                <div class="col-6"><strong>Chất liệu:</strong> <span id="modalMaterial" class="text-secondary"></span></div>
                                <div class="col-6"><strong>Carat:</strong> <span id="modalCarat" class="text-warning"></span></div>
                                <div class="col-6"><strong>Nước màu:</strong> <span id="modalColor" class="text-secondary"></span></div>
                                <div class="col-6"><strong>Độ tinh khiết:</strong> <span id="modalClarity" class="text-secondary"></span></div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-gold-luxury flex-grow-1" onclick="alert('Đã gửi thông tin đến chuyên viên tư vấn kim cương.');">
                                <i class="bi bi-telephone-outbound me-1"></i> Gọi Hotline Tư Vấn Ngay
                            </button>
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Thông Báo Thêm Giỏ Hàng -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
    <div id="cartToast" class="toast text-white border-0" role="alert" aria-live="assertive" aria-atomic="true" style="background: #111520; border: 1px solid var(--pf-gold) !important;">
        <div class="toast-header border-0 text-white" style="background: rgba(212,175,55,0.15);">
            <i class="bi bi-check-circle-fill text-warning me-2"></i>
            <strong class="me-auto text-warning font-serif">AURA BRILLIANCE VIP</strong>
            <small class="text-secondary">Vừa xong</small>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body" id="toastMessage">
            Đã thêm trang sức vào danh mục quan tâm!
        </div>
    </div>
</div>

<!-- ==========================================================================
     SCRIPTS: LỌC TRANG SỨC & TƯƠNG TÁC
     ========================================================================== -->
<script>
    function filterJewelry(cat, btn) {
        var items = document.querySelectorAll('.jewelry-card-item');
        items.forEach(function(el) {
            if (cat === 'all' || el.getAttribute('data-category') === cat) {
                el.style.display = 'block';
            } else {
                el.style.display = 'none';
            }
        });

        var btns = document.querySelectorAll('#jewelryFilterBtns button');
        btns.forEach(function(b) {
            b.classList.remove('btn-gold-luxury', 'active');
            b.classList.add('btn-outline-gold');
        });
        btn.classList.remove('btn-outline-gold');
        btn.classList.add('btn-gold-luxury', 'active');
    }

    function orderJewelry(name, price) {
        var msg = 'Quý khách đã chọn tuyệt tác "' + name + '" (' + price + ' VNĐ). Chuyên viên CSKH VIP sẽ gọi ngay để hỗ trợ đo size và giao hàng!';
        document.getElementById('toastMessage').innerText = msg;
        var toastEl = document.getElementById('cartToast');
        var toast = new bootstrap.Toast(toastEl);
        toast.show();
    }

    function openQuickView(name, mat, carat, color, clarity, gia, price, img, desc) {
        document.getElementById('modalJewelName').innerText = name;
        document.getElementById('modalJewelTitle').innerText = name;
        document.getElementById('modalJewelPrice').innerText = price + ' VNĐ';
        document.getElementById('modalJewelDesc').innerText = desc;
        document.getElementById('modalMaterial').innerText = mat;
        document.getElementById('modalCarat').innerText = carat;
        document.getElementById('modalColor').innerText = color;
        document.getElementById('modalClarity').innerText = clarity;
        document.getElementById('modalGiaNum').innerText = gia;
        document.getElementById('modalJewelImg').src = img;

        var myModal = new bootstrap.Modal(document.getElementById('quickViewModal'));
        myModal.show();
    }
</script>
