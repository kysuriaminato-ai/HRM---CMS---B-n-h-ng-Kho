@section Scripts {
    <script>
        // 1. LIVE DIGITAL CLOCK (VIETNAM TIME)
        function updateLiveClock() {
            const now = new Date();
            // Vietnam Time GMT+7
            const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
            const vnNow = new Date(utc + (3600000 * 7));
            const hours = String(vnNow.getHours()).padStart(2, '0');
            const minutes = String(vnNow.getMinutes()).padStart(2, '0');
            const seconds = String(vnNow.getSeconds()).padStart(2, '0');
            const el = document.getElementById('liveClockFace');
            if (el) el.textContent = `${hours}:${minutes}:${seconds}`;
        }
        setInterval(updateLiveClock, 1000);
        updateLiveClock();

        // 2. TAB SWITCHER
        function switchEssTab(tabKey) {
            document.querySelectorAll('.ess-tab-pane').forEach(el => el.classList.add('d-none'));
            document.querySelectorAll('.ess-tab-btn').forEach(el => {
                el.classList.remove('bg-white', 'text-dark', 'shadow');
                el.classList.add('btn-outline-light', 'border-0');
            });

            const pane = document.getElementById(`tab-${tabKey}`);
            if (pane) pane.classList.remove('d-none');

            // Find button matching
            const buttons = document.querySelectorAll('.ess-tab-btn');
            buttons.forEach(btn => {
                if (btn.getAttribute('onclick')?.includes(tabKey)) {
                    btn.classList.add('bg-white', 'text-dark', 'shadow');
                    btn.classList.remove('btn-outline-light', 'border-0');
                }
            });

            // Update URL without reload
            const url = new URL(window.location);
            url.searchParams.set('tab', tabKey);
            window.history.replaceState({}, '', url);
        }

        // 3. WEB CHECK-IN / CHECK-OUT
        async function handleCheckIn() {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            try {
                const res = await fetch('/CongNhanVien/CheckIn', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                const data = await res.json();
                if (data.success) {
                    if (window.ERP?.toast) ERP.toast.success(data.message);
                    else alert(data.message);
                    setTimeout(() => location.reload(), 1200);
                } else {
                    if (window.ERP?.toast) ERP.toast.warning(data.message);
                    else alert(data.message);
                }
            } catch (err) {
                if (window.ERP?.toast) ERP.toast.error('Lỗi kết nối khi Check-in.');
            }
        }

        async function handleCheckOut() {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            try {
                const res = await fetch('/CongNhanVien/CheckOut', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                const data = await res.json();
                if (data.success) {
                    if (window.ERP?.toast) ERP.toast.success(data.message);
                    else alert(data.message);
                    setTimeout(() => location.reload(), 1200);
                } else {
                    if (window.ERP?.toast) ERP.toast.warning(data.message);
                    else alert(data.message);
                }
            } catch (err) {
                if (window.ERP?.toast) ERP.toast.error('Lỗi kết nối khi Check-out.');
            }
        }

        // 4. TẠO ĐƠN & HỦY ĐƠN
        async function submitLeaveRequest(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);

            try {
                const res = await fetch('/CongNhanVien/TaoDon', {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await res.json();
                if (data.success) {
                    if (window.ERP?.toast) ERP.toast.success(data.message);
                    else alert(data.message);
                    if (window.ERP?.drawer) ERP.drawer.close('createLeaveDrawer');
                    setTimeout(() => location.reload(), 1200);
                } else {
                    if (window.ERP?.toast) ERP.toast.error(data.message);
                    else alert(data.message);
                }
            } catch (err) {
                if (window.ERP?.toast) ERP.toast.error('Có lỗi xảy ra khi gửi đơn.');
            }
        }

        async function cancelRequest(id, code) {
            if (!confirm(`Bạn có chắc chắn muốn rút lại (hủy) đơn ${code}?`)) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append('id', id);

            try {
                const res = await fetch('/CongNhanVien/HuyDon', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                const data = await res.json();
                if (data.success) {
                    if (window.ERP?.toast) ERP.toast.success(data.message);
                    else alert(data.message);
                    setTimeout(() => location.reload(), 1200);
                } else {
                    if (window.ERP?.toast) ERP.toast.error(data.message);
                    else alert(data.message);
                }
            } catch (err) {
                if (window.ERP?.toast) ERP.toast.error('Lỗi khi hủy đơn.');
            }
        }

        // 5. GIẢI TRÌNH CHẤM CÔNG
        function openAdjustmentForDate(dateStr) {
            const input = document.getElementById('adjWorkDate');
            if (input) input.value = dateStr;
            if (window.ERP?.drawer) ERP.drawer.open('adjustmentDrawer');
        }

        async function submitAdjustmentRequest(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);

            try {
                const res = await fetch('/CongNhanVien/GuiGiaiTrinh', {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await res.json();
                if (data.success) {
                    if (window.ERP?.toast) ERP.toast.success(data.message);
                    else alert(data.message);
                    if (window.ERP?.drawer) ERP.drawer.close('adjustmentDrawer');
                    setTimeout(() => location.reload(), 1200);
                } else {
                    if (window.ERP?.toast) ERP.toast.error(data.message);
                    else alert(data.message);
                }
            } catch (err) {
                if (window.ERP?.toast) ERP.toast.error('Có lỗi xảy ra khi gửi giải trình.');
            }
        }

        // 6. XÁC THỰC MẬT KHẨU PHIẾU LƯƠNG
        function promptUnlockPayslip() {
            const modalEl = document.getElementById('unlockPayslipModal');
            if (modalEl) {
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
                setTimeout(() => document.getElementById('unlockPasswordInput')?.focus(), 400);
            }
        }

        async function submitUnlockPassword() {
            const pwd = document.getElementById('unlockPasswordInput')?.value;
            if (!pwd) {
                alert('Vui lòng nhập mật khẩu.');
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            try {
                const res = await fetch('/CongNhanVien/XacThucMatKhauPhieuLuong', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ password: pwd })
                });
                const data = await res.json();
                if (data.success) {
                    if (window.ERP?.toast) ERP.toast.success(data.message);
                    bootstrap.Modal.getInstance(document.getElementById('unlockPayslipModal'))?.hide();
                    setTimeout(() => {
                        const url = new URL(window.location);
                        url.searchParams.set('tab', 'payslips');
                        window.location.href = url.toString();
                    }, 800);
                } else {
                    alert(data.message);
                }
            } catch (err) {
                alert('Lỗi xác thực.');
            }
        }

        // 7. XEM CHI TIẾT PHÂN RÃ PHIẾU LƯƠNG
        async function viewPayslipDetail(slipId) {
            if (window.ERP?.drawer) ERP.drawer.open('payslipDetailDrawer');
            const container = document.getElementById('payslipDetailContent');
            if (!container) return;

            try {
                const res = await fetch(`/CongNhanVien/ChiTietPhieuLuong/${slipId}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (res.status === 403) {
                    promptUnlockPayslip();
                    if (window.ERP?.drawer) ERP.drawer.close('payslipDetailDrawer');
                    return;
                }

                const data = await res.json();
                if (!data.success) {
                    container.innerHTML = `<div class="alert alert-danger">${data.message}</div>`;
                    return;
                }

                const d = data.data;
                container.innerHTML = `
                    <div class="mb-3 pb-2 border-bottom d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold mb-0">${d.periodName}</h5>
                            <span class="small text-muted">Tháng ${d.month}/${d.year} | Nhân viên: ${d.employeeName}</span>
                        </div>
                        <a href="/CongNhanVien/InPhieuLuong/${d.id}" target="_blank" class="erp-btn erp-btn-primary btn-sm">
                            <i class="bi bi-printer me-1"></i>Bản In A4
                        </a>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <div class="p-2 border rounded text-center bg-light">
                                <span class="text-muted" style="font-size:11px;">Công chuẩn</span>
                                <div class="fw-bold num">${d.standardDays}</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded text-center bg-light">
                                <span class="text-muted" style="font-size:11px;">Công thực tế</span>
                                <div class="fw-bold text-success num">${d.actualWorkDays.toFixed(1)}</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded text-center bg-light">
                                <span class="text-muted" style="font-size:11px;">Giờ tăng ca</span>
                                <div class="fw-bold text-primary num">${d.overtimeHours.toFixed(1)}h</div>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold text-primary small text-uppercase mb-2">1. Các khoản thu nhập (Gross)</h6>
                    <table class="table table-sm table-bordered small mb-3">
                        <tbody>
                            <tr><td>Lương cơ bản hợp đồng:</td><td class="text-end num">${d.basicSalary.toLocaleString()} đ</td></tr>
                            <tr><td>Lương theo ngày công thực tế:</td><td class="text-end num fw-bold">${d.standardWorkSalary.toLocaleString()} đ</td></tr>
                            <tr><td>Tiền làm thêm giờ (OT 150%):</td><td class="text-end num">${d.overtimeSalary.toLocaleString()} đ</td></tr>
                            <tr><td>Tổng phụ cấp (Chức vụ, ăn trưa, đi lại):</td><td class="text-end num">${d.totalAllowance.toLocaleString()} đ</td></tr>
                            <tr><td>Thưởng hiệu suất & KPI:</td><td class="text-end num">${d.bonus.toLocaleString()} đ</td></tr>
                            <tr class="table-light fw-bold"><td>TỔNG THU NHẬP (GROSS):</td><td class="text-end num text-success">${d.grossSalary.toLocaleString()} đ</td></tr>
                        </tbody>
                    </table>

                    <h6 class="fw-bold text-danger small text-uppercase mb-2">2. Các khoản khấu trừ & Thuế</h6>
                    <table class="table table-sm table-bordered small mb-3">
                        <tbody>
                            <tr><td>Bảo hiểm xã hội (BHXH 8%):</td><td class="text-end num">-${d.socialInsurance.toLocaleString()} đ</td></tr>
                            <tr><td>Bảo hiểm y tế (BHYT 1.5%):</td><td class="text-end num">-${d.healthInsurance.toLocaleString()} đ</td></tr>
                            <tr><td>Bảo hiểm thất nghiệp (BHTN 1%):</td><td class="text-end num">-${d.unemploymentInsurance.toLocaleString()} đ</td></tr>
                            <tr><td>Thuế TNCN (sau giảm trừ gia cảnh):</td><td class="text-end num">-${d.personalIncomeTax.toLocaleString()} đ</td></tr>
                            ${d.latePenalty > 0 ? `<tr><td>Phạt đi muộn không phép:</td><td class="text-end num">-${d.latePenalty.toLocaleString()} đ</td></tr>` : ''}
                            <tr class="table-light fw-bold"><td>TỔNG KHẤU TRỪ:</td><td class="text-end num text-danger">-${(d.totalInsurance + d.personalIncomeTax + d.latePenalty).toLocaleString()} đ</td></tr>
                        </tbody>
                    </table>

                    <div class="p-3 bg-indigo-subtle rounded-3 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-primary">THỰC LĨNH CHUYỂN KHOẢN (NET):</span>
                        <h4 class="fw-bold text-primary mb-0 num">${d.netSalary.toLocaleString()} VNĐ</h4>
                    </div>
                `;
            } catch (err) {
                container.innerHTML = `<div class="alert alert-danger">Lỗi tải dữ liệu.</div>`;
            }
        }

        // 8. CẬP NHẬT LIÊN HỆ & ĐĂNG KÝ PHỤ THUỘC
        async function submitContactUpdate(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);

            try {
                const res = await fetch('/CongNhanVien/CapNhatLienHe', {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await res.json();
                if (data.success) {
                    if (window.ERP?.toast) ERP.toast.success(data.message);
                    else alert(data.message);
                    setTimeout(() => location.reload(), 1000);
                } else {
                    alert(data.message);
                }
            } catch (err) {
                alert('Lỗi cập nhật.');
            }
        }

