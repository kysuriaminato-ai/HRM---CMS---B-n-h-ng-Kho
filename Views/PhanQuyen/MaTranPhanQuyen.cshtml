@model ERP_HRM_CMS.Models.ViewModels.MaTranPhanQuyenViewModel
@{
    ViewData["Title"] = "Ma Trận Phân Quyền Vai Trò (RBAC)";
    ViewData["Module"] = "system";
}

<erp-page-header title="Ma Trận Phân Quyền Vai Trò (RBAC)"
                 subtitle="Quản lý và thiết lập ma trận cấp quyền cho từng Nhóm / Vai trò trong doanh nghiệp"
                 icon="bi-shield-lock-fill">
    <a href="/PhanQuyen/PhanQuyenCaNhan" class="btn btn-outline-secondary">
        <i class="bi bi-person-gear me-1"></i> Ngoại Lệ Cá Nhân (ACL)
    </a>
    <button type="button" class="btn btn-primary" id="btnSaveMatrix" onclick="luuMaTran()">
        <i class="bi bi-check2-circle me-1"></i> Lưu Thiết Lập
    </button>
</erp-page-header>

<div class="mb-4">
    <label class="form-label small fw-semibold text-muted text-uppercase mb-2" for="roleFilterSelect">
        Chọn vai trò cần thiết lập
    </label>

    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-4 col-lg-3">
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="search" id="roleFilterKeyword" class="form-control"
                       placeholder="Lọc theo tên hoặc mã vai trò" autocomplete="off"
                       aria-label="Lọc danh sách vai trò" />
            </div>
        </div>

        <div class="col-12 col-md-5 col-lg-4">
            <select id="roleFilterSelect" class="form-select form-select-sm" aria-label="Vai trò đang thiết lập">
                @foreach (var r in Model.Roles)
                {
                    <option value="@Url.Action("MaTranPhanQuyen", new { roleId = r.Id })"
                            data-search="@($"{r.Name} {r.Code}".ToLowerInvariant())"
                            selected="@(r.Id == Model.SelectedRoleId)">
                        @r.Name (@r.Code)
                    </option>
                }
            </select>
        </div>

        <div class="col-12 col-md-3 col-lg-5 d-flex align-items-center gap-2">
            <span class="small text-muted">
                Có <strong id="roleFilterCount">@Model.Roles.Count()</strong> vai trò
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="roleFilterReset">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Xoá lọc
            </button>
        </div>
    </div>
</div>

<script>
(function () {
    'use strict';
    var sel = document.getElementById('roleFilterSelect');
    var kw = document.getElementById('roleFilterKeyword');
    var countEl = document.getElementById('roleFilterCount');
    var reset = document.getElementById('roleFilterReset');
    if (!sel || !kw) { return; }

    // Giữ bản gốc để khôi phục khi xoá lọc
    var all = Array.prototype.map.call(sel.options, function (o) {
        return { value: o.value, text: o.text, search: o.getAttribute('data-search') || '', selected: o.selected };
    });

    function strip(v) {
        return (v || '').toLowerCase().normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd');
    }

    function render(term) {
        var t = strip(term).trim();
        var keep = all.filter(function (o) { return t === '' || strip(o.search).indexOf(t) !== -1; });
        sel.innerHTML = '';
        keep.forEach(function (o) {
            var el = document.createElement('option');
            el.value = o.value;
            el.text = o.text;
            el.selected = o.selected;
            sel.appendChild(el);
        });
        if (countEl) { countEl.textContent = String(keep.length); }
        sel.disabled = keep.length === 0;
    }

    kw.addEventListener('input', function () { render(this.value); });

    // Đổi vai trò thì tải lại trang theo roleId tương ứng
    sel.addEventListener('change', function () {
        if (this.value) { window.location.href = this.value; }
    });

    if (reset) {
        reset.addEventListener('click', function () {
            kw.value = '';
            render('');
            kw.focus();
        });
    }
})();
</script>

<div class="erp-table-wrapper stagger-rows">
    <div class="erp-table-toolbar">
        <span class="small text-muted">
            <i class="bi bi-info-circle me-1"></i> Tích chọn vào quyền để kích hoạt cho vai trò đang chọn
        </span>
        <div class="erp-table-toolbar-actions">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="chonTatCa(true)">Chọn tất cả</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="chonTatCa(false)">Bỏ chọn tất cả</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="text-center">#</th>
                    <th>Mã Quyền (Code)</th>
                    <th>Tên Quyền Hạn</th>
                    <th>Mô Tả Chức Năng</th>
                    <th class="text-center">Kích Hoạt</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mod in Model.Modules)
                {
                    <tr class="erp-module-group-row">
                        <td colspan="4">
                            <i class="@mod.ModuleIcon me-2 text-primary"></i> @mod.ModuleName.ToUpper()
                        </td>
                        <td class="text-center">
                            <input type="checkbox" class="erp-checkbox-accent module-master"
                                   aria-label="Chọn cả phân hệ @mod.ModuleName"
                                   onchange="toggleModuleGroup(this, @mod.ModuleId)" />
                        </td>
                    </tr>
                    @foreach (var p in mod.Permissions)
                    {
                        bool isChecked = Model.ActivePermissionIds.Contains(p.Id);
                        <tr>
                            <td class="text-center text-muted small">@p.Id</td>
                            <td><code>@p.Code</code></td>
                            <td class="fw-semibold">@p.Name</td>
                            <td class="small text-secondary">@p.Description</td>
                            <td class="text-center">
                                <input type="checkbox"
                                       class="erp-checkbox-accent perm-checkbox mod-@mod.ModuleId"
                                       value="@p.Id"
                                       @(isChecked ? "checked" : "") />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function toggleModuleGroup(masterCheckbox, moduleId) {
            const checkboxes = document.querySelectorAll('.mod-' + moduleId);
            checkboxes.forEach(cb => cb.checked = masterCheckbox.checked);
        }

        function chonTatCa(status) {
            document.querySelectorAll('.perm-checkbox').forEach(cb => cb.checked = status);
            document.querySelectorAll('.module-master').forEach(cb => cb.checked = status);
        }

        function luuMaTran() {
            const btn = document.getElementById('btnSaveMatrix');
            const roleId = @Model.SelectedRoleId;
            const checkedPerms = [];
            document.querySelectorAll('.perm-checkbox:checked').forEach(cb => {
                checkedPerms.push(parseInt(cb.value, 10));
            });

            ERP.btnLoading(btn);
            fetch('/PhanQuyen/LuuMaTranQuyenRole', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ roleId: roleId, permissionIds: checkedPerms })
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        ERP.toast(data.message || 'Đã lưu ma trận phân quyền.', 'success');
                    } else {
                        ERP.toast(data.message || 'Không thể lưu phân quyền.', 'danger');
                    }
                })
                .catch(() => {
                    ERP.toast('Không thể kết nối đến máy chủ.', 'danger');
                })
                .finally(() => ERP.btnReset(btn));
        }
    </script>
}
