@model ERP_HRM_CMS.Models.ViewModels.MaTranPhanQuyenViewModel
@{
    ViewData["Title"] = "Ma Trận Phân Quyền Vai Trò (RBAC)";
    ViewData["Module"] = "system";
}

<erp-page-header title="Ma Trận Phân Quyền Vai Trò (RBAC)"
                 subtitle="Quản lý và thiết lập ma trận cấp quyền cho từng Nhóm / Vai trò trong doanh nghiệp"
                 icon="bi-shield-lock-fill">
    <a href="/PhanQuyen/PhanQuyenCaNhan" class="btn btn-outline-secondary">
        <i class="bi bi-person-gear me-1"></i> Ngoại Lệ Cá Nhân (ACL)
    </a>
    <button type="button" class="btn btn-primary" id="btnSaveMatrix" onclick="luuMaTran()">
        <i class="bi bi-check2-circle me-1"></i> Lưu Thiết Lập
    </button>
</erp-page-header>

<div class="mb-4">
    <label class="form-label small fw-semibold text-muted text-uppercase mb-2">Chọn vai trò cần thiết lập</label>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var r in Model.Roles)
        {
            <a href="@Url.Action("MaTranPhanQuyen", new { roleId = r.Id })"
               class="erp-role-pill @(r.Id == Model.SelectedRoleId ? "active" : "")">
                <i class="bi bi-shield"></i>
                <span>@r.Name (@r.Code)</span>
            </a>
        }
    </div>
</div>

<div class="erp-table-wrapper stagger-rows">
    <div class="erp-table-toolbar">
        <span class="small text-muted">
            <i class="bi bi-info-circle me-1"></i> Tích chọn vào quyền để kích hoạt cho vai trò đang chọn
        </span>
        <div class="erp-table-toolbar-actions">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="chonTatCa(true)">Chọn tất cả</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="chonTatCa(false)">Bỏ chọn tất cả</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="text-center">#</th>
                    <th>Mã Quyền (Code)</th>
                    <th>Tên Quyền Hạn</th>
                    <th>Mô Tả Chức Năng</th>
                    <th class="text-center">Kích Hoạt</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mod in Model.Modules)
                {
                    <tr class="erp-module-group-row">
                        <td colspan="4">
                            <i class="@mod.ModuleIcon me-2 text-primary"></i> @mod.ModuleName.ToUpper()
                        </td>
                        <td class="text-center">
                            <input type="checkbox" class="erp-checkbox-accent module-master"
                                   aria-label="Chọn cả phân hệ @mod.ModuleName"
                                   onchange="toggleModuleGroup(this, @mod.ModuleId)" />
                        </td>
                    </tr>
                    @foreach (var p in mod.Permissions)
                    {
                        bool isChecked = Model.ActivePermissionIds.Contains(p.Id);
                        <tr>
                            <td class="text-center text-muted small">@p.Id</td>
                            <td><code>@p.Code</code></td>
                            <td class="fw-semibold">@p.Name</td>
                            <td class="small text-secondary">@p.Description</td>
                            <td class="text-center">
                                <input type="checkbox"
                                       class="erp-checkbox-accent perm-checkbox mod-@mod.ModuleId"
                                       value="@p.Id"
                                       @(isChecked ? "checked" : "") />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function toggleModuleGroup(masterCheckbox, moduleId) {
            const checkboxes = document.querySelectorAll('.mod-' + moduleId);
            checkboxes.forEach(cb => cb.checked = masterCheckbox.checked);
        }

        function chonTatCa(status) {
            document.querySelectorAll('.perm-checkbox').forEach(cb => cb.checked = status);
            document.querySelectorAll('.module-master').forEach(cb => cb.checked = status);
        }

        function luuMaTran() {
            const btn = document.getElementById('btnSaveMatrix');
            const roleId = @Model.SelectedRoleId;
            const checkedPerms = [];
            document.querySelectorAll('.perm-checkbox:checked').forEach(cb => {
                checkedPerms.push(parseInt(cb.value, 10));
            });

            ERP.btnLoading(btn);
            fetch('/PhanQuyen/LuuMaTranQuyenRole', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ roleId: roleId, permissionIds: checkedPerms })
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        ERP.toast(data.message || 'Đã lưu ma trận phân quyền.', 'success');
                    } else {
                        ERP.toast(data.message || 'Không thể lưu phân quyền.', 'danger');
                    }
                })
                .catch(() => {
                    ERP.toast('Không thể kết nối đến máy chủ.', 'danger');
                })
                .finally(() => ERP.btnReset(btn));
        }
    </script>
}
