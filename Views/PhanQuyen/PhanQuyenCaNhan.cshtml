@model ERP_HRM_CMS.Models.ViewModels.PhanQuyenCaNhanViewModel
@{
    ViewData["Title"] = "Ngoại Lệ Phân Quyền Cá Nhân (ACL Override)";
    ViewData["Module"] = "system";
}

<erp-page-header title="Ngoại Lệ Quyền Cá Nhân (ACL Override)"
                 subtitle="Thiết lập quyền vượt cấp (Cấp riêng) hoặc tước quyền (Chặn riêng) cho từng người dùng cụ thể"
                 icon="bi-person-gear">
    <a href="/PhanQuyen/MaTranPhanQuyen" class="btn btn-outline-secondary">
        <i class="bi bi-shield-lock me-1"></i> Về Ma Trận Vai Trò
    </a>
    <button type="button" class="btn btn-primary" id="btnSaveAcl" onclick="luuAclCaNhan()">
        <i class="bi bi-check2-circle me-1"></i> Lưu Ngoại Lệ
    </button>
</erp-page-header>

<div class="mb-4">
    <label class="form-label small fw-semibold text-muted text-uppercase mb-2">Chọn tài khoản người dùng</label>
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle fw-semibold" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-person-circle me-1 text-primary"></i> @Model.FullName (@Model.Username)
        </button>
        <ul class="dropdown-menu">
            @foreach (var u in Model.Users)
            {
                <li>
                    <a class="dropdown-item @(u.Id == Model.SelectedUserId ? "active" : "")"
                       href="@Url.Action("PhanQuyenCaNhan", new { userId = u.Id })">
                        @u.FullName (<code>@u.Username</code>)
                    </a>
                </li>
            }
        </ul>
    </div>
</div>

<div class="erp-table-wrapper stagger-rows">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã Quyền</th>
                    <th>Tên Quyền Hạn</th>
                    <th class="text-center">Kế Thừa Từ Role</th>
                    <th class="text-center">Ngoại Lệ Cá Nhân (ACL)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mod in Model.Modules)
                {
                    <tr class="erp-module-group-row">
                        <td colspan="4"><i class="@mod.ModuleIcon me-2 text-primary"></i> @mod.ModuleName</td>
                    </tr>
                    @foreach (var p in mod.Permissions)
                    {
                        bool inherited = Model.RoleInheritedPermissionIds.Contains(p.Id);
                        bool hasOverride = Model.UserAclOverrides.TryGetValue(p.Id, out bool isGranted);

                        <tr>
                            <td><code>@p.Code</code></td>
                            <td class="fw-medium">@p.Name</td>
                            <td class="text-center">
                                @if (inherited)
                                {
                                    <span class="erp-badge erp-badge-success erp-badge-dot">Có quyền</span>
                                }
                                else
                                {
                                    <span class="erp-badge erp-badge-neutral">Không có</span>
                                }
                            </td>
                            <td class="text-center">
                                <select class="form-select form-select-sm erp-acl-select d-inline-block w-auto acl-item"
                                        data-perm-id="@p.Id" onchange="capNhatMauSelect(this)">
                                    <option value="" selected="@(!hasOverride)">-- Mặc định theo Role --</option>
                                    <option value="true" selected="@(hasOverride && isGranted)">[+] CẤP VƯỢT CẤP</option>
                                    <option value="false" selected="@(hasOverride && !isGranted)">[-] CHẶN TRUY CẬP</option>
                                </select>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function capNhatMauSelect(elem) {
            elem.classList.remove('state-default', 'state-grant', 'state-deny');
            if (elem.value === 'true') elem.classList.add('state-grant');
            else if (elem.value === 'false') elem.classList.add('state-deny');
            else elem.classList.add('state-default');
        }

        document.querySelectorAll('.erp-acl-select').forEach(elem => capNhatMauSelect(elem));

        function luuAclCaNhan() {
            const btn = document.getElementById('btnSaveAcl');
            const userId = @Model.SelectedUserId;
            const overrides = [];

            document.querySelectorAll('.acl-item').forEach(sel => {
                const permId = parseInt(sel.getAttribute('data-perm-id'), 10);
                const val = sel.value;
                if (val === 'true') overrides.push({ permissionId: permId, state: true });
                else if (val === 'false') overrides.push({ permissionId: permId, state: false });
                else overrides.push({ permissionId: permId, state: null });
            });

            ERP.btnLoading(btn);
            fetch('/PhanQuyen/LuuPhanQuyenCaNhan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId: userId, overrides: overrides })
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        ERP.toast(data.message || 'Đã lưu ngoại lệ quyền cá nhân.', 'success');
                    } else {
                        ERP.toast(data.message || 'Không thể lưu ngoại lệ.', 'danger');
                    }
                })
                .catch(() => {
                    ERP.toast('Không thể kết nối đến máy chủ.', 'danger');
                })
                .finally(() => ERP.btnReset(btn));
        }
    </script>
}
