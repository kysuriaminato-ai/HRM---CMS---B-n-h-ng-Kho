@model ERP_HRM_CMS.Models.ViewModels.AttendanceDailyIndexViewModel
@{
    Layout = "_HRMLayout";
    ViewData["Title"] = "Chấm Công Hàng Ngày";
    var activeEmps = ViewBag.ActiveEmployees as List<ERP_HRM_CMS.Models.Entities.Employee>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Bảng Chấm Công Hàng Ngày</h4>
        <p class="text-secondary small mb-0">Theo dõi giờ vào/ra, điểm danh và ghi nhận biến động công trong ngày</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/ChamCong/BangCongThang" class="btn btn-erp-outline btn-sm">
            <i class="bi bi-calendar3 me-1"></i> Bảng Tổng Hợp Tháng
        </a>
    </div>
</div>

<div class="erp-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-secondary mb-1">Chọn ngày:</label>
            <input type="date" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold text-secondary mb-1">Lọc theo phòng ban:</label>
            <select name="departmentId" class="form-select form-select-sm" asp-items="ViewBag.Departments">
                <option value="">-- Tất cả phòng ban --</option>
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-sm btn-erp-black w-100">Tra cứu</button>
        </div>
    </form>
</div>

<!-- Điểm danh nhanh nếu là ngày hôm nay -->
@if (Model.SelectedDate.Date == DateTime.Today)
{
    <div class="erp-card p-3 mb-4 bg-light">
        <h6 class="fw-bold mb-3 small text-uppercase">Check-In / Check-Out Nhanh Cho Nhân Viên</h6>
        <form asp-action="QuickAction" method="post" class="row g-2 align-items-center">
            @Html.AntiForgeryToken()
            <div class="col-md-5">
                <select name="EmployeeId" class="form-select form-select-sm" required>
                    <option value="">-- Chọn nhân viên điểm danh --</option>
                    @if (activeEmps != null)
                    {
                        foreach (var emp in activeEmps)
                        {
                            <option value="@emp.Id">@emp.FullName (@emp.EmployeeCode) - @emp.Department?.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="ShiftId" class="form-select form-select-sm" required>
                    @foreach (var s in Model.Shifts)
                    {
                        <option value="@s.Id">@s.Name (@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm"))</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" name="ActionType" value="CheckIn" class="btn btn-sm btn-erp-black flex-grow-1">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Ghi Nhận Giờ Vào/Ra
                </button>
            </div>
        </form>
    </div>
}

<div class="erp-card">
    <div class="table-responsive">
        <table class="table erp-table mb-0 align-middle">
            <thead>
                <tr>
                    <th>Mã NV</th>
                    <th>Họ Và Tên</th>
                    <th>Phòng Ban</th>
                    <th>Ca Làm Việc</th>
                    <th class="text-center">Giờ Vào</th>
                    <th class="text-center">Giờ Ra</th>
                    <th class="text-center">Đi Muộn</th>
                    <th class="text-center">Số Giờ Công</th>
                    <th class="text-center">Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.AttendanceList.Any())
                {
                    foreach (var item in Model.AttendanceList)
                    {
                        <tr>
                            <td><code>@item.Employee?.EmployeeCode</code></td>
                            <td class="fw-bold">@item.Employee?.FullName</td>
                            <td>@item.Employee?.Department?.Name</td>
                            <td>@item.Shift?.Name</td>
                            <td class="text-center">@(item.FirstInTime?.ToString(@"hh\:mm") ?? "-")</td>
                            <td class="text-center">@(item.LastOutTime?.ToString(@"hh\:mm") ?? "-")</td>
                            <td class="text-center">
                                @if (item.LateMinutes > 0)
                                {
                                    <span class="text-danger fw-semibold">+@item.LateMinutes phút</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center"><strong>@item.WorkHourCount.ToString("0.#")h</strong></td>
                            <td class="text-center">
                                @if (item.AttendanceStatus == "Present")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Đúng giờ</span>
                                }
                                else if (item.AttendanceStatus == "Late")
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Đi muộn</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">Vắng</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">Chưa có dữ liệu chấm công cho ngày @Model.SelectedDate.ToString("dd/MM/yyyy").</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
