@model ERP_HRM_CMS.Models.ViewModels.PaginatedList<ERP_HRM_CMS.Services.HRM.LeaveRequestListItemDto>
@{
    ViewData["Title"] = "Trung Tâm Phê Duyệt Đơn Từ & Nghỉ Phép";
    ViewData["Module"] = "hrm";
    ViewData["BreadcrumbSection"] = "Nhân sự & Chấm công";
    var filter = ViewBag.Filter as ERP_HRM_CMS.Services.HRM.LeaveRequestFilterDto ?? new();
    var departments = ViewBag.Departments as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    bool canApproveLeave = ViewBag.CanApproveLeave as bool? ?? false;
    bool isSuperAdmin = ViewBag.IsSuperAdmin as bool? ?? false;
    int? currentEmpId = ViewBag.CurrentEmployeeId as int?;
    int? currentUsrId = ViewBag.CurrentUserId as int?;
}

<erp-page-header title="Quy Trình Phê Duyệt Đơn Từ & Nghỉ Phép"
                 subtitle="Tiếp nhận, phê duyệt đa cấp (Trưởng phòng &rarr; Ban Giám Đốc), tự động trừ quỹ phép và đồng bộ ngày công"
                 icon="bi-file-earmark-check-fill"
                 breadcrumbs="Dashboard:/|Nhân sự & Chấm công:/NhanSu/Index|Đơn từ & Phê duyệt">
    <a asp-action="QuyPhepNam" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-wallet2 me-1"></i> Quỹ phép năm
    </a>
    <a asp-action="GiaiTrinh" class="btn btn-outline-warning btn-sm text-dark">
        <i class="bi bi-patch-question me-1"></i> Đơn giải trình chấm công
    </a>
    <a asp-action="Create" class="btn btn-primary btn-sm ripple">
        <i class="bi bi-plus-circle me-1"></i> Tạo đơn từ mới
    </a>
</erp-page-header>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Thống kê trạng thái phê duyệt (Bento Stat Cards) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <erp-stat-card label="Tổng Số Đơn Từ" value="@ViewBag.TotalCount" icon="bi-files" variant="primary" />
    </div>
    <div class="col-6 col-md-3">
        <erp-stat-card label="Chờ Trưởng Phòng Duyệt" value="@ViewBag.PendingCount" icon="bi-hourglass-split" variant="warning" />
    </div>
    <div class="col-6 col-md-3">
        <erp-stat-card label="Chờ Ban Giám Đốc" value="@ViewBag.DeptApprovedCount" icon="bi-person-check" variant="info" />
    </div>
    <div class="col-6 col-md-3">
        <erp-stat-card label="Đã Hoàn Tất Phê Duyệt" value="@ViewBag.ApprovedCount" icon="bi-check-all" variant="success" />
    </div>
</div>

<!-- Thanh công cụ duyệt hàng loạt -->
@if (canApproveLeave)
{
    <div class="card bg-light border mb-3 py-2 px-3 d-flex flex-row justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <input type="checkbox" id="selectAllCheckbox" class="form-check-input" />
            <label for="selectAllCheckbox" class="form-check-label small fw-bold">Chọn tất cả</label>
            <span class="text-muted small">| Đã chọn: <strong id="selectedCount">0</strong> đơn</span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="executeBatchApprove('TP')">
                <i class="bi bi-check-lg me-1"></i> Duyệt nhanh cấp Trưởng phòng
            </button>
            <button type="button" class="btn btn-success btn-sm text-white" onclick="executeBatchApprove('GD')">
                <i class="bi bi-check2-all me-1"></i> Duyệt nhanh cấp Giám đốc / HR
            </button>
        </div>
    </div>
}

<!-- Bộ lọc tìm kiếm đa chiều -->
<erp-filter-bar method="get">
    <div class="col-md-3">
        <label class="form-label small fw-semibold mb-1">Trạng thái xử lý</label>
        <select name="status" class="form-select form-select-sm">
            <option value="">-- Tất cả trạng thái --</option>
            <option value="CHO_DUYET" selected="@(filter.Status == "CHO_DUYET")">Chờ Trưởng phòng duyệt</option>
            <option value="TRUONG_PHONG_DUYET" selected="@(filter.Status == "TRUONG_PHONG_DUYET")">Trưởng phòng đã duyệt (Chờ GĐ)</option>
            <option value="GIAM_DOC_DUYET" selected="@(filter.Status == "GIAM_DOC_DUYET")">Giám đốc đã duyệt (Hoàn tất)</option>
            <option value="TU_CHOI" selected="@(filter.Status == "TU_CHOI")">Bị từ chối</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small fw-semibold mb-1">Loại đơn từ</label>
        <select name="type" class="form-select form-select-sm">
            <option value="">-- Tất cả loại đơn --</option>
            <option value="ANNUAL_LEAVE" selected="@(filter.Type == "ANNUAL_LEAVE")">Nghỉ phép năm</option>
            <option value="SICK_LEAVE" selected="@(filter.Type == "SICK_LEAVE")">Nghỉ ốm / Khám bệnh</option>
            <option value="LATE_EARLY" selected="@(filter.Type == "LATE_EARLY")">Đi muộn / Về sớm</option>
            <option value="BUSINESS_TRIP" selected="@(filter.Type == "BUSINESS_TRIP")">Công tác</option>
            <option value="UNPAID_LEAVE" selected="@(filter.Type == "UNPAID_LEAVE")">Nghỉ không lương</option>
            <option value="OVERTIME" selected="@(filter.Type == "OVERTIME")">Làm thêm giờ (OT)</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small fw-semibold mb-1">Phòng ban</label>
        <select name="departmentId" asp-items="departments" class="form-select form-select-sm">
            <option value="">-- Tất cả phòng ban --</option>
        </select>
    </div>
    <div class="col-md-3 d-flex gap-1 align-items-end">
        <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-funnel-fill me-1"></i>Lọc</button>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Đặt lại bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
    </div>
</erp-filter-bar>

<!-- Bảng danh sách đơn từ -->
<div class="card erp-card shadow-sm">
    <div class="table-responsive">
        <table class="table erp-table sticky-thead mb-0 align-middle">
            <thead>
                <tr>
                    @if (canApproveLeave)
                    {
                        <th style="width: 40px;" class="text-center">#</th>
                    }
                    <th class="sticky-col-1" style="width: 130px;">Mã Đơn</th>
                    <th class="sticky-col-2">Nhân Sự Nộp Đơn</th>
                    <th>Loại Đơn</th>
                    <th>Khoảng Thời Gian</th>
                    <th class="text-center" style="width: 90px;">Số Ngày</th>
                    <th>Lý Do &amp; Ý Kiến Phê Duyệt</th>
                    <th class="text-center" style="width: 170px;">Trạng Thái</th>
                    <th class="text-end sticky-col-actions" style="width: 170px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        bool isPending = item.Status == "PendingApproval" || item.Status == "CHO_DUYET";
                        bool isDeptApproved = item.Status == "DepartmentApproved" || item.Status == "TRUONG_PHONG_DUYET";
                        bool isFinished = item.Status == "DirectorApproved" || item.Status == "GIAM_DOC_DUYET";
                        bool isRejected = item.Status == "Rejected" || item.Status == "TU_CHOI";

                        bool isOwnRequest = currentEmpId.HasValue && currentEmpId.Value == item.EmployeeId;
                        bool allowApproveButton = canApproveLeave && (isSuperAdmin || !isOwnRequest);

                        <tr>
                            @if (canApproveLeave)
                            {
                                <td class="text-center">
                                    @if (allowApproveButton && (isPending || isDeptApproved))
                                    {
                                        <input type="checkbox" class="form-check-input item-checkbox" value="@item.Id" />
                                    }
                                </td>
                            }
                            <td class="sticky-col-1 tabular-nums fw-semibold">
                                <code>@item.RequestCode</code>
                                <div class="text-muted" style="font-size: 11px;">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td class="sticky-col-2">
                                <div class="fw-bold">@item.FullName</div>
                                <div class="text-muted small tabular-nums">
                                    <span class="badge bg-light text-dark border">@item.EmployeeCode</span>
                                    @item.DepartmentName
                                </div>
                            </td>
                            <td>
                                @switch (item.RequestType)
                                {
                                    case "ANNUAL_LEAVE":
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-calendar-heart me-1"></i>Phép Năm</span>
                                        break;
                                    case "SICK_LEAVE":
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-heart-pulse me-1"></i>Nghỉ Ốm</span>
                                        break;
                                    case "LATE_EARLY":
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle"><i class="bi bi-clock-history me-1"></i>Đi Muộn/Về Sớm</span>
                                        break;
                                    case "BUSINESS_TRIP":
                                        <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-briefcase me-1"></i>Công Tác</span>
                                        break;
                                    case "OVERTIME":
                                        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-lightning-charge me-1"></i>Tăng Ca (OT)</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-secondary border">@item.RequestTypeName</span>
                                        break;
                                }
                            </td>
                            <td class="small tabular-nums">
                                <div>@item.FromDate.ToString("dd/MM/yyyy") &rarr; @item.ToDate.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td class="text-center tabular-nums">
                                <span class="badge bg-light text-dark fw-bold border">@item.TotalDays.ToString("0.#") ngày</span>
                            </td>
                            <td>
                                <div class="small text-truncate" style="max-width: 260px;" title="@item.Reason">@item.Reason</div>
                                @if (!string.IsNullOrEmpty(item.DepartmentHeadName))
                                {
                                    <div class="text-info small" style="font-size: 11px;">
                                        <i class="bi bi-person-check me-1"></i>TP @item.DepartmentHeadName đã duyệt
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(item.DirectorName))
                                {
                                    <div class="text-success small" style="font-size: 11px;">
                                        <i class="bi bi-check-all me-1"></i>GĐ @item.DirectorName đã duyệt
                                    </div>
                                }
                            </td>
                            <td class="text-center">
                                @if (isPending)
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                        <i class="bi bi-hourglass-split me-1"></i> Chờ TP duyệt
                                    </span>
                                }
                                else if (isDeptApproved)
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                                        <i class="bi bi-person-check me-1"></i> Chờ GĐ/HR duyệt
                                    </span>
                                }
                                else if (isFinished)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle-fill me-1"></i> Hoàn tất duyệt
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                        <i class="bi bi-x-circle me-1"></i> Bị từ chối
                                    </span>
                                }
                            </td>
                            <td class="text-end sticky-col-actions">
                                <div class="btn-group btn-group-sm">
                                    @if (allowApproveButton && isPending)
                                    {
                                        <button type="button" class="btn btn-outline-primary" onclick="openApprovalModal(@item.Id, '@item.RequestCode', 'TP')" title="Trưởng phòng duyệt"><i class="bi bi-check-lg"></i> Duyệt TP</button>
                                        <button type="button" class="btn btn-outline-danger" onclick="openRejectModal(@item.Id, '@item.RequestCode')" title="Từ chối"><i class="bi bi-x-lg"></i></button>
                                    }
                                    else if (allowApproveButton && isDeptApproved)
                                    {
                                        <button type="button" class="btn btn-success text-white" onclick="openApprovalModal(@item.Id, '@item.RequestCode', 'GD')" title="Giám đốc duyệt hoàn tất"><i class="bi bi-check-all"></i> Duyệt GĐ</button>
                                        <button type="button" class="btn btn-outline-danger" onclick="openRejectModal(@item.Id, '@item.RequestCode')" title="Từ chối"><i class="bi bi-x-lg"></i></button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">&mdash;</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="p-0 border-0">
                            <erp-empty-state icon="bi-file-earmark-x"
                                             title="Không tìm thấy đơn từ nào"
                                             description="Không có đơn từ nào phù hợp với bộ lọc hiện tại."
                                             action-text="Tạo đơn từ mới"
                                             action-url="/DonTu/Create" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Hiển thị trang @Model.PageIndex / @Model.TotalPages (Tổng @Model.TotalCount đơn từ)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)"
                       asp-route-status="@filter.Status" asp-route-type="@filter.Type" asp-route-departmentId="@filter.DepartmentId">Trước</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p"
                           asp-route-status="@filter.Status" asp-route-type="@filter.Type" asp-route-departmentId="@filter.DepartmentId">@p</a>
                    </li>
                }
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)"
                       asp-route-status="@filter.Status" asp-route-type="@filter.Type" asp-route-departmentId="@filter.DepartmentId">Sau</a>
                </li>
            </ul>
        </div>
    }
</div>

<!-- MODAL DUYỆT ĐƠN -->
<div class="modal fade" id="modalDuyetDon" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-action="Duyet" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="duyetDonId" />
            <input type="hidden" name="level" id="duyetDonLevel" />
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="duyetDonTitle"><i class="bi bi-check-circle-fill text-success me-2"></i>Phê Duyệt Đơn Từ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info py-2 small mb-3">
                    Đơn đang xử lý: <strong id="duyetDonCodeText"></strong>.
                    <div id="duyetDonHelpText" class="mt-1"></div>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Ý Kiến Phê Duyệt / Ghi Chú Phân Công</label>
                    <textarea name="note" class="form-control" rows="3" placeholder="Nhập ý kiến chỉ đạo hoặc ghi chú..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg me-1"></i>Xác Nhận Phê Duyệt</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL TỪ CHỐI ĐƠN -->
<div class="modal fade" id="modalTuChoiDon" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-action="TuChoi" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="tuChoiDonId" />
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-x-circle-fill me-2"></i>Từ Chối Đơn Từ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning py-2 small mb-3">
                    Đơn bị từ chối: <strong id="tuChoiDonCodeText"></strong>. Hệ thống sẽ gửi thông báo giải thích lý do tới nhân sự.
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-danger">Lý Do Từ Chối <span class="text-danger">*</span></label>
                    <textarea name="reason" class="form-control" rows="3" required placeholder="Nhập lý do từ chối cụ thể..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-x-lg me-1"></i>Xác Nhận Từ Chối</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openApprovalModal(id, code, level) {
            document.getElementById('duyetDonId').value = id;
            document.getElementById('duyetDonLevel').value = level;
            document.getElementById('duyetDonCodeText').innerText = code;

            if (level === 'TP') {
                document.getElementById('duyetDonTitle').innerHTML = '<i class="bi bi-person-check text-primary me-2"></i>Trưởng Bộ Phận Duyệt Đơn';
                document.getElementById('duyetDonHelpText').innerText = 'Sau khi duyệt, đơn sẽ chuyển lên cấp Ban Giám Đốc/HR phê duyệt cuối cùng.';
            } else {
                document.getElementById('duyetDonTitle').innerHTML = '<i class="bi bi-check2-all text-success me-2"></i>Ban Giám Đốc / HR Phê Duyệt Cuối Cùng';
                document.getElementById('duyetDonHelpText').innerText = 'Sau khi duyệt, hệ thống sẽ tự động trừ quỹ phép năm và cập nhật vào bảng chấm công ngày.';
            }

            new bootstrap.Modal(document.getElementById('modalDuyetDon')).show();
        }

        function openRejectModal(id, code) {
            document.getElementById('tuChoiDonId').value = id;
            document.getElementById('tuChoiDonCodeText').innerText = code;
            new bootstrap.Modal(document.getElementById('modalTuChoiDon')).show();
        }

        // Chọn tất cả checkboxes
        const selectAll = document.getElementById('selectAllCheckbox');
        if (selectAll) {
            selectAll.addEventListener('change', function () {
                const checkboxes = document.querySelectorAll('.item-checkbox');
                checkboxes.forEach(cb => cb.checked = selectAll.checked);
                updateSelectedCount();
            });
        }

        document.querySelectorAll('.item-checkbox').forEach(cb => {
            cb.addEventListener('change', updateSelectedCount);
        });

        function updateSelectedCount() {
            const count = document.querySelectorAll('.item-checkbox:checked').length;
            const el = document.getElementById('selectedCount');
            if (el) el.textContent = count;
        }

        // Thực hiện duyệt hàng loạt
        function executeBatchApprove(level) {
            const checked = document.querySelectorAll('.item-checkbox:checked');
            const ids = Array.from(checked).map(cb => parseInt(cb.value));

            if (ids.length === 0) {
                alert('Vui lòng chọn ít nhất 1 đơn từ để duyệt.');
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            if (!confirm(`Bạn có chắc chắn muốn duyệt hàng loạt ${ids.length} đơn từ ở cấp ${level === 'TP' ? 'Trưởng phòng' : 'Giám đốc/HR'}?`)) {
                return;
            }

            fetch('/DonTu/DuyetHangLoat', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: new URLSearchParams({
                    ids: ids,
                    level: level,
                    note: 'Duyệt hàng loạt từ màn hình quản lý'
                })
            })
            .then(r => r.json())
            .then(res => {
                if (window.ERP && window.ERP.toast) {
                    window.ERP.toast(res.message, res.success ? 'success' : 'danger');
                } else {
                    alert(res.message);
                }
                setTimeout(() => window.location.reload(), 800);
            })
            .catch(err => alert('Lỗi: ' + err));
        }
    </script>
}
