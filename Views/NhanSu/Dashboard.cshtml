@model ERP_HRM_CMS.Services.HRM.HrDashboardDto
@{
    Layout = "_HRMLayout";
    ViewData["Title"] = "Dashboard Nhân Sự";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Dashboard Nhân Sự</h4>
        <p class="text-secondary small mb-0">Tổng quan tình hình nhân sự toàn công ty</p>
    </div>
    <a asp-action="Index" class="btn btn-erp-outline">
        <i class="bi bi-list me-1"></i> Danh sách nhân viên
    </a>
</div>

<!-- Thống kê tổng quan -->
<div class="row g-3 mb-4">
    <div class="col-md-2">
        <div class="erp-card p-3 text-center">
            <div class="text-secondary small fw-semibold">Tổng NV</div>
            <h2 class="fw-bold m-0">@Model.TotalEmployees</h2>
        </div>
    </div>
    <div class="col-md-2">
        <div class="erp-card p-3 text-center">
            <div class="text-secondary small fw-semibold">Đang làm</div>
            <h2 class="fw-bold m-0 text-success">@Model.ActiveEmployees</h2>
        </div>
    </div>
    <div class="col-md-2">
        <div class="erp-card p-3 text-center">
            <div class="text-secondary small fw-semibold">Thử việc</div>
            <h2 class="fw-bold m-0 text-primary">@Model.ProbationEmployees</h2>
        </div>
    </div>
    <div class="col-md-2">
        <div class="erp-card p-3 text-center">
            <div class="text-secondary small fw-semibold">Nghỉ phép</div>
            <h2 class="fw-bold m-0 text-warning">@Model.OnLeaveEmployees</h2>
        </div>
    </div>
    <div class="col-md-2">
        <div class="erp-card p-3 text-center">
            <div class="text-secondary small fw-semibold">NV mới tháng</div>
            <h2 class="fw-bold m-0 text-info">@Model.NewHiresThisMonth</h2>
        </div>
    </div>
    <div class="col-md-2">
        <div class="erp-card p-3 text-center">
            <div class="text-secondary small fw-semibold">HĐ sắp hết</div>
            <h2 class="fw-bold m-0 text-danger">@Model.ExpiringContracts30Days</h2>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Biểu đồ: Phân bố theo phòng ban -->
    <div class="col-lg-6">
        <div class="erp-card p-4">
            <h6 class="fw-bold mb-3">Phân Bố Theo Phòng Ban</h6>
            <canvas id="chartDepartment" height="260"></canvas>
        </div>
    </div>

    <!-- Biểu đồ: Giới tính -->
    <div class="col-lg-3">
        <div class="erp-card p-4">
            <h6 class="fw-bold mb-3">Giới Tính</h6>
            <canvas id="chartGender" height="260"></canvas>
        </div>
    </div>

    <!-- Biểu đồ: Trạng thái -->
    <div class="col-lg-3">
        <div class="erp-card p-4">
            <h6 class="fw-bold mb-3">Trạng Thái</h6>
            <canvas id="chartStatus" height="260"></canvas>
        </div>
    </div>
</div>

<div class="row g-4 mt-0">
    <!-- Nhân viên mới nhất -->
    <div class="col-lg-6">
        <div class="erp-card">
            <div class="erp-card-header">
                <i class="bi bi-person-plus me-1"></i> Nhân Viên Mới Nhất
            </div>
            <div class="table-responsive">
                <table class="table erp-table mb-0 small">
                    <thead>
                        <tr><th>Mã NV</th><th>Họ tên</th><th>Phòng ban</th><th>Ngày vào</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentHires.Any())
                        {
                            foreach (var e in Model.RecentHires)
                            {
                                <tr>
                                    <td><code>@e.EmployeeCode</code></td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@e.Id" class="text-dark text-decoration-none fw-semibold">@e.FullName</a>
                                    </td>
                                    <td>@e.DepartmentName</td>
                                    <td>@e.HireDate.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">Không có nhân viên mới.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Hợp đồng sắp hết hạn -->
    <div class="col-lg-6">
        <div class="erp-card">
            <div class="erp-card-header">
                <i class="bi bi-exclamation-triangle me-1"></i> Hợp Đồng Sắp Hết Hạn (30 ngày)
            </div>
            <div class="table-responsive">
                <table class="table erp-table mb-0 small">
                    <thead>
                        <tr><th>Số HĐ</th><th>Nhân viên</th><th>Phòng ban</th><th>Hết hạn</th><th>Còn</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.ExpiringContractList.Any())
                        {
                            foreach (var c in Model.ExpiringContractList)
                            {
                                <tr>
                                    <td><code>@c.ContractNumber</code></td>
                                    <td>@c.EmployeeName</td>
                                    <td>@c.DepartmentName</td>
                                    <td>@c.EndDate?.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (c.DaysLeft <= 7)
                                        {
                                            <span class="badge bg-danger">@c.DaysLeft ngày</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@c.DaysLeft ngày</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">Không có hợp đồng nào sắp hết hạn.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // Dữ liệu từ server
        const deptLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByDepartment.Keys.ToList()));
        const deptData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByDepartment.Values.ToList()));

        // Biểu đồ phòng ban (Bar)
        new Chart(document.getElementById('chartDepartment'), {
            type: 'bar',
            data: {
                labels: deptLabels,
                datasets: [{
                    label: 'Số nhân viên',
                    data: deptData,
                    backgroundColor: 'rgba(26, 26, 46, 0.8)',
                    borderColor: 'rgba(26, 26, 46, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { stepSize: 1 } },
                    x: { ticks: { font: { size: 10 }, maxRotation: 45 } }
                }
            }
        });

        // Biểu đồ giới tính (Doughnut)
        new Chart(document.getElementById('chartGender'), {
            type: 'doughnut',
            data: {
                labels: ['Nam', 'Nữ'],
                datasets: [{
                    data: [@Model.MaleCount, @Model.FemaleCount],
                    backgroundColor: ['#1a1a2e', '#6c757d']
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom', labels: { font: { size: 11 } } } }
            }
        });

        // Biểu đồ trạng thái (Doughnut)
        new Chart(document.getElementById('chartStatus'), {
            type: 'doughnut',
            data: {
                labels: ['Đang làm', 'Thử việc', 'Nghỉ phép', 'Đã nghỉ'],
                datasets: [{
                    data: [@Model.ActiveEmployees, @Model.ProbationEmployees, @Model.OnLeaveEmployees, @Model.ResignedEmployees],
                    backgroundColor: ['#198754', '#0d6efd', '#ffc107', '#adb5bd']
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom', labels: { font: { size: 11 } } } }
            }
        });
    </script>
}
