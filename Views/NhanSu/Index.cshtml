@model ERP_HRM_CMS.Models.ViewModels.PaginatedList<ERP_HRM_CMS.Services.HRM.EmployeeListItemDto>
@{
    ViewData["Module"] = "hrm";
    ViewData["Title"] = "Hồ sơ nhân sự";
    ViewData["BreadcrumbSection"] = "Nhân sự & Chấm công";
    var filter = ViewBag.Filter as ERP_HRM_CMS.Services.HRM.EmployeeFilterDto;
    int totalActive = ViewBag.TotalActive ?? 0;
    int totalProbation = ViewBag.TotalProbation ?? 0;
    int totalOnLeave = ViewBag.TotalOnLeave ?? 0;
    int totalResigned = ViewBag.TotalResigned ?? 0;
}

<erp-page-header title="Hồ Sơ Nhân Sự Doanh Nghiệp"
                 subtitle="Tra cứu, quản lý vòng đời nhân sự 360°, nhập xuất Excel và cảnh báo thông minh"
                 icon="bi-people-fill"
                 breadcrumbs="Dashboard:/|Nhân sự & Chấm công:/NhanSu/Index|Hồ sơ nhân sự">
    <a asp-action="CanhBao" class="btn btn-outline-warning btn-sm" title="Trung tâm cảnh báo nhân sự">
        <i class="bi bi-bell-fill me-1"></i> Cảnh báo
    </a>
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-speedometer2 me-1"></i> Dashboard
    </a>
    <div class="btn-group btn-group-sm">
        <a asp-action="ExportExcel"
           asp-route-keyword="@filter?.Keyword"
           asp-route-departmentId="@filter?.DepartmentId"
           asp-route-positionId="@filter?.PositionId"
           asp-route-status="@filter?.Status"
           class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
        </a>
        <button type="button" class="btn btn-outline-success dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown"></button>
        <ul class="dropdown-menu dropdown-menu-end small">
            <li><a class="dropdown-item" asp-action="DownloadImportTemplate"><i class="bi bi-download me-2"></i>Tải file mẫu (Template)</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#modalImportExcel"><i class="bi bi-upload me-2 text-primary"></i>Nhập dữ liệu từ Excel...</a></li>
        </ul>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm ripple">
        <i class="bi bi-person-plus-fill me-1"></i> Tiếp nhận nhân sự
    </a>
</erp-page-header>

<!-- Thống kê trạng thái nhân sự -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <erp-stat-card label="Đang Làm Việc" value="@totalActive" icon="bi-person-check-fill" variant="success" />
    </div>
    <div class="col-6 col-md-3">
        <erp-stat-card label="Thử Việc" value="@totalProbation" icon="bi-person-badge" variant="primary" />
    </div>
    <div class="col-6 col-md-3">
        <erp-stat-card label="Nghỉ Phép" value="@totalOnLeave" icon="bi-pause-circle-fill" variant="warning" />
    </div>
    <div class="col-6 col-md-3">
        <erp-stat-card label="Đã Nghỉ Việc" value="@totalResigned" icon="bi-person-x-fill" variant="neutral" />
    </div>
</div>

<!-- Cảnh báo lỗi Import Excel (nếu có) -->
@if (TempData["ImportErrors"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show p-3 mb-4" role="alert">
        <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Báo Cáo Lỗi Khi Nhập File Excel:</h6>
        <p class="small mb-1">Hệ thống phát hiện một số dòng dữ liệu không hợp lệ. Vui lòng kiểm tra lại theo danh sách dưới đây:</p>
        <div class="bg-white p-2 rounded border small font-monospace text-dark" style="max-height: 150px; overflow-y: auto;">
            @TempData["ImportErrors"]
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Bộ lọc tìm kiếm -->
<erp-filter-bar method="get">
    <div class="col-md-3">
        <label class="form-label small fw-semibold mb-1">Từ khóa tìm kiếm</label>
        <div class="input-group input-group-sm">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" name="keyword" value="@filter?.Keyword" class="form-control" placeholder="Tên, mã NV, email..." />
        </div>
    </div>
    <div class="col-md-2">
        <label class="form-label small fw-semibold mb-1">Phòng ban</label>
        <select name="departmentId" class="form-select form-select-sm" asp-items="ViewBag.Departments">
            <option value="">-- Tất cả phòng ban --</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small fw-semibold mb-1">Chức vụ</label>
        <select name="positionId" class="form-select form-select-sm" asp-items="ViewBag.Positions">
            <option value="">-- Tất cả chức vụ --</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small fw-semibold mb-1">Trạng thái</label>
        <select name="status" class="form-select form-select-sm">
            <option value="">-- Tất cả trạng thái --</option>
            <option value="Active" selected="@(filter?.Status == "Active")">Đang làm việc</option>
            <option value="Probation" selected="@(filter?.Status == "Probation")">Thử việc</option>
            <option value="OnLeave" selected="@(filter?.Status == "OnLeave")">Nghỉ phép</option>
            <option value="Resigned" selected="@(filter?.Status == "Resigned")">Đã nghỉ việc</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small fw-semibold mb-1">Sắp xếp theo</label>
        <select name="sortBy" class="form-select form-select-sm">
            <option value="HireDate" selected="@(filter?.SortBy == "HireDate")">Ngày vào làm</option>
            <option value="FullName" selected="@(filter?.SortBy == "FullName")">Họ và tên</option>
            <option value="EmployeeCode" selected="@(filter?.SortBy == "EmployeeCode")">Mã nhân viên</option>
            <option value="Department" selected="@(filter?.SortBy == "Department")">Phòng ban</option>
        </select>
    </div>
    <div class="col-md-1 d-flex gap-1 align-items-end">
        <button type="submit" class="btn btn-sm btn-primary w-100" title="Tìm kiếm"><i class="bi bi-funnel-fill"></i></button>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Đặt lại bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
    </div>
    <input type="hidden" name="sortDesc" value="@filter?.SortDesc.ToString().ToLower()" />
    <input type="hidden" name="pageSize" value="@filter?.PageSize" />
</erp-filter-bar>

<!-- Bảng hiển thị danh sách hồ sơ -->
<div class="card erp-card">
    <div class="table-responsive">
        <table class="table erp-table sticky-thead mb-0 align-middle">
            <thead>
                <tr>
                    <th class="sticky-col-1" style="width: 50px;"></th>
                    <th class="sticky-col-2" style="width: 110px;">Mã NV</th>
                    <th>Họ Và Tên</th>
                    <th>Phòng Ban</th>
                    <th>Chức Vụ</th>
                    <th>Thông Tin Liên Hệ</th>
                    <th>Ngày Vào Làm</th>
                    <th class="text-center">Trạng Thái</th>
                    <th class="text-end sticky-col-actions" style="width: 110px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var e in Model)
                    {
                        var statusVariant = e.Status switch
                        {
                            "Active" => "success",
                            "Probation" => "primary",
                            "OnLeave" => "warning",
                            _ => "neutral"
                        };
                        var statusLabel = e.Status switch
                        {
                            "Active" => "Đang làm việc",
                            "Probation" => "Thử việc",
                            "OnLeave" => "Nghỉ phép",
                            _ => "Đã nghỉ việc"
                        };
                        <tr>
                            <td class="sticky-col-1 text-center">
                                @if (!string.IsNullOrEmpty(e.AvatarUrl))
                                {
                                    <img src="@e.AvatarUrl" alt="@e.FullName" class="rounded-circle border" style="width: 32px; height: 32px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="avatar avatar-sm bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 12px;">
                                        @e.FullName[..Math.Min(2, e.FullName.Length)].ToUpper()
                                    </div>
                                }
                            </td>
                            <td class="sticky-col-2 tabular-nums">
                                <code>@e.EmployeeCode</code>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@e.Id" class="fw-semibold text-decoration-none text-dark hover-primary">
                                    @e.FullName
                                </a>
                                @if (e.Gender == "Nam")
                                {
                                    <span class="badge bg-info-subtle text-info border ms-1" style="font-size: 10px;">Nam</span>
                                }
                                else if (e.Gender == "Nữ")
                                {
                                    <span class="badge bg-danger-subtle text-danger border ms-1" style="font-size: 10px;">Nữ</span>
                                }
                            </td>
                            <td class="small">
                                <span class="fw-medium">@e.DepartmentName</span>
                                <small class="text-muted d-block">@e.BranchName</small>
                            </td>
                            <td class="small text-secondary">@e.PositionName</td>
                            <td class="small">
                                <div class="text-truncate" style="max-width: 180px;"><i class="bi bi-envelope text-muted me-1"></i>@e.Email</div>
                                @if (!string.IsNullOrEmpty(e.Phone))
                                {
                                    <div class="tabular-nums text-muted"><i class="bi bi-telephone text-muted me-1"></i>@e.Phone</div>
                                }
                            </td>
                            <td class="small tabular-nums text-secondary">
                                @e.HireDate.ToString("dd/MM/yyyy")
                            </td>
                            <td class="text-center">
                                <erp-status-badge variant="@statusVariant" label="@statusLabel" dot="true" />
                            </td>
                            <td class="text-end sticky-col-actions">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-outline-secondary py-0 px-2" title="Xem hồ sơ 360°">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-outline-primary py-0 px-2" title="Chỉnh sửa hồ sơ">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="p-0 border-0">
                            <erp-empty-state icon="bi-people-slash"
                                             title="Không tìm thấy nhân sự"
                                             description="Không có bản ghi nhân sự nào phù hợp với bộ lọc tìm kiếm hiện tại." />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-transparent py-3">
            <erp-pagination current-page="@Model.PageIndex"
                            total-pages="@Model.TotalPages"
                            url-template='@Url.Action("Index", new { keyword = filter?.Keyword, departmentId = filter?.DepartmentId, positionId = filter?.PositionId, status = filter?.Status, sortBy = filter?.SortBy, sortDesc = filter?.SortDesc, pageSize = filter?.PageSize, page = "__PAGE__" })' />
        </div>
    }
</div>

<!-- Modal Nhập Excel Hàng Loạt -->
<div class="modal fade" id="modalImportExcel" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content erp-card border-0 shadow">
            <form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h6 class="modal-title fw-bold"><i class="bi bi-file-earmark-spreadsheet me-2"></i>Nhập Danh Sách Nhân Sự Hàng Loạt</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">
                        Vui lòng tải file mẫu Excel trước khi nhập dữ liệu để đảm bảo cấu trúc cột và định dạng hợp lệ.
                    </p>
                    <div class="mb-3 text-center">
                        <a asp-action="DownloadImportTemplate" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-download me-1"></i> Tải file Excel Template mẫu
                        </a>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Chọn file Excel (.xlsx):</label>
                        <input type="file" name="excelFile" class="form-control form-control-sm" accept=".xlsx" required />
                    </div>
                    <div class="alert alert-info small mb-0">
                        <i class="bi bi-info-circle me-1"></i> Hệ thống tự động kiểm tra trùng mã nhân viên, trùng email và tính hợp lệ của mã phòng ban/chức vụ.
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-sm btn-primary px-3"><i class="bi bi-upload me-1"></i> Tiến hành Import</button>
                </div>
            </form>
        </div>
    </div>
</div>
