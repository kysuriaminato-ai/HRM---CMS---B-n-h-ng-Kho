@model ERP_HRM_CMS.Models.ViewModels.EmployeeListViewModel
@{
    Layout = "_HRMLayout";
    ViewData["Title"] = "Danh Sách Hồ Sơ Nhân Sự";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Quản Trị Hồ Sơ Nhân Sự</h4>
        <p class="text-secondary small mb-0">Tra cứu, cập nhật thông tin và cấp tài khoản làm việc nội bộ</p>
    </div>
    <a href="/NhanSu/Create" class="btn btn-erp-black">
        <i class="bi bi-person-plus-fill me-1"></i> Tiếp Nhận Nhân Sự Mới
    </a>
</div>

<!-- Thống kê trạng thái -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="erp-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-secondary small fw-semibold">Đang Hoạt Động</span>
                <h3 class="fw-bold m-0 text-dark">@Model.TotalActive</h3>
            </div>
            <i class="bi bi-person-check fs-2 text-dark"></i>
        </div>
    </div>
    <div class="col-md-4">
        <div class="erp-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-secondary small fw-semibold">Đang Nghỉ Phép / Tạm Hoãn</span>
                <h3 class="fw-bold m-0 text-secondary">@Model.TotalOnLeave</h3>
            </div>
            <i class="bi bi-pause-circle fs-2 text-secondary"></i>
        </div>
    </div>
    <div class="col-md-4">
        <div class="erp-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-secondary small fw-semibold">Đã Thôi Việc</span>
                <h3 class="fw-bold m-0 text-muted">@Model.TotalResigned</h3>
            </div>
            <i class="bi bi-person-x fs-2 text-muted"></i>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="erp-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <input type="text" name="keyword" value="@Model.Keyword" class="form-control form-control-sm" placeholder="Tìm theo tên, mã NV, email hoặc SĐT..." />
        </div>
        <div class="col-md-3">
            <select name="departmentId" class="form-select form-select-sm" asp-items="ViewBag.Departments">
                <option value="">-- Tất cả phòng ban --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="positionId" class="form-select form-select-sm" asp-items="ViewBag.Positions">
                <option value="">-- Tất cả chức vụ --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select form-select-sm">
                <option value="">-- Trạng thái --</option>
                <option value="Active" selected="@(Model.Status == "Active")">Đang làm việc</option>
                <option value="OnLeave" selected="@(Model.Status == "OnLeave")">Nghỉ phép</option>
                <option value="Resigned" selected="@(Model.Status == "Resigned")">Đã nghỉ việc</option>
            </select>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-sm btn-erp-black w-100"><i class="bi bi-search"></i></button>
        </div>
    </form>
</div>

<!-- Bảng hiển thị -->
<div class="erp-card">
    <div class="table-responsive">
        <table class="table erp-table mb-0 align-middle">
            <thead>
                <tr>
                    <th style="width: 100px;">Mã NV</th>
                    <th>Họ Và Tên</th>
                    <th>Phòng Ban</th>
                    <th>Chức Vụ</th>
                    <th>Liên Hệ</th>
                    <th>Ngày Vào Làm</th>
                    <th class="text-center">Trạng Thái</th>
                    <th class="text-end" style="width: 140px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Employees.Any())
                {
                    foreach (var e in Model.Employees)
                    {
                        <tr>
                            <td><code>@e.EmployeeCode</code></td>
                            <td>
                                <a href="/NhanSu/Details/@e.Id" class="fw-bold text-dark text-decoration-none">@e.FullName</a>
                            </td>
                            <td>@e.Department?.Name</td>
                            <td><span class="badge bg-light text-dark border">@e.Position?.Name</span></td>
                            <td class="small">
                                <div><i class="bi bi-envelope me-1"></i>@e.Email</div>
                                <div><i class="bi bi-telephone me-1"></i>@(e.Phone ?? "-")</div>
                            </td>
                            <td class="small text-secondary">@e.HireDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                @if (e.Status == "Active")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Làm việc</span>
                                }
                                else if (e.Status == "OnLeave")
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Nghỉ phép</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">Thôi việc</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/NhanSu/Details/@e.Id" class="btn btn-sm btn-erp-outline py-1 px-2" title="Xem hồ sơ"><i class="bi bi-eye"></i></a>
                                <a href="/NhanSu/Edit/@e.Id" class="btn btn-sm btn-erp-outline py-1 px-2" title="Sửa thông tin"><i class="bi bi-pencil"></i></a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Không tìm thấy bản ghi nhân viên nào phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>