@model ERP_HRM_CMS.Models.ViewModels.ProductCreateEditViewModel
@{
    ViewData["Module"] = "sales";
    ViewData["Title"] = "Thêm Mới Hàng Hóa / Sản Phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-plus-square me-2 text-primary"></i>Thêm Mới Hàng Hóa</h4>
        <p class="text-muted small mb-0">Khai báo thông tin sản phẩm mới, thiết lập đơn giá và số lượng tồn ban đầu</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary px-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="SKU" class="form-label fw-semibold small"></label>
                            <input asp-for="SKU" class="form-control font-monospace" placeholder="VD: SKU-20261002-001" />
                            <span asp-validation-for="SKU" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Barcode" class="form-label fw-semibold small"></label>
                            <input asp-for="Barcode" class="form-control font-monospace" placeholder="VD: 893500000001" />
                            <span asp-validation-for="Barcode" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Name" class="form-label fw-semibold small"></label>
                            <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm hoặc thiết bị..." />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold small"></label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                <option value="">-- Chọn danh mục ngành hàng --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Unit" class="form-label fw-semibold small"></label>
                            <input asp-for="Unit" class="form-control" placeholder="Cái, Chiếc, Bộ, Thùng..." />
                            <span asp-validation-for="Unit" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CostPrice" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <input asp-for="CostPrice" class="form-control text-end" type="number" step="1000" />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                            <span asp-validation-for="CostPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SalePrice" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <input asp-for="SalePrice" class="form-control text-end fw-bold text-primary" type="number" step="1000" />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                            <span asp-validation-for="SalePrice" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="InitialStock" class="form-label fw-semibold small"></label>
                            <input asp-for="InitialStock" class="form-control" type="number" min="0" />
                            <div class="form-text small">Số lượng tồn kho ban đầu sẽ phân bổ đồng đều tới các chi nhánh</div>
                            <span asp-validation-for="InitialStock" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MinStockAlert" class="form-label fw-semibold small"></label>
                            <input asp-for="MinStockAlert" class="form-control" type="number" min="1" />
                            <div class="form-text small">Hệ thống sẽ báo động đỏ khi tồn kho chạm ngưỡng này</div>
                            <span asp-validation-for="MinStockAlert" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Description" class="form-label fw-semibold small"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả tóm tắt tính năng, cấu hình kỹ thuật..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                                <label class="form-check-label fw-semibold small" asp-for="IsActive">Kích hoạt đưa vào kinh doanh ngay</label>
                            </div>
                        </div>

                        <div class="col-12 text-end pt-3">
                            <a asp-action="Index" class="btn btn-light px-4 me-2">Hủy</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-save me-1"></i> Lưu sản phẩm
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
