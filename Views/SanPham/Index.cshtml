@model ERP_HRM_CMS.Models.ViewModels.ProductListViewModel
@{
    Layout = "_SalesLayout";
    ViewData["Title"] = "Danh Mục Hàng Hóa & Sản Phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-box-seam me-2 text-primary"></i>Danh Mục Hàng Hóa & Sản Phẩm</h4>
        <p class="text-muted small mb-0">Quản lý danh sách thiết bị, vật tư, cấu hình giá bán và kiểm soát tồn kho theo chi nhánh</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Thêm mới sản phẩm
        </a>
    </div>
</div>

<!-- BỘ LỌC TÌM KIẾM -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Tên sản phẩm, SKU, Barcode..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select form-select-sm" asp-items="ViewBag.Categories">
                    <option value="">-- Tất cả ngành hàng --</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="branchId" class="form-select form-select-sm" asp-items="ViewBag.Branches"></select>
            </div>
            <div class="col-md-2">
                <div class="form-check form-switch pt-1">
                    <input class="form-check-input" type="checkbox" name="lowStockOnly" id="lowStockOnly" value="true" @(Model.LowStockOnly == true ? "checked" : "") />
                    <label class="form-check-label small" for="lowStockOnly">Sắp hết hàng</label>
                </div>
            </div>
            <div class="col-md-1 text-end">
                <button type="submit" class="btn btn-sm btn-dark w-100">Lọc</button>
            </div>
        </form>
    </div>
</div>

<!-- BẢNG DỮ LIỆU SẢN PHẨM -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 120px;">Mã SKU</th>
                        <th>Tên sản phẩm</th>
                        <th>Ngành hàng</th>
                        <th class="text-center">ĐVT</th>
                        <th class="text-end">Giá vốn</th>
                        <th class="text-end">Giá niêm yết</th>
                        <th class="text-center">Tồn chi nhánh</th>
                        <th class="text-center">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Products != null && Model.Products.Any())
                    {
                        foreach (var item in Model.Products)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="badge bg-light text-dark border font-monospace">@item.SKU</span>
                                    @if (!string.IsNullOrEmpty(item.Barcode))
                                    {
                                        <div class="text-muted" style="font-size: 11px;"><i class="bi bi-upc"></i> @item.Barcode</div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.Name</div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border">@item.CategoryName</span>
                                </td>
                                <td class="text-center">@item.Unit</td>
                                <td class="text-end text-muted">@item.CostPrice.ToString("N0") đ</td>
                                <td class="text-end fw-bold text-primary">@item.SalePrice.ToString("N0") đ</td>
                                <td class="text-center">
                                    @if (item.IsLowStock)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">
                                            <i class="bi bi-exclamation-circle me-1"></i> @item.StockQuantity
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                            @item.StockQuantity
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Đang kinh doanh</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ngừng kinh doanh</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Không tìm thấy sản phẩm nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white border-0 py-3 text-muted small">
        Tổng số sản phẩm hiển thị: <strong>@(Model.Products?.Count ?? 0)</strong>
    </div>
</div>
