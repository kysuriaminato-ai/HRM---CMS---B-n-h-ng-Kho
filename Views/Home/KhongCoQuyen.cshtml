@model ERP_HRM_CMS.Models.ErrorViewModel
@{
    Layout = null;
    var vm = Model ?? new ERP_HRM_CMS.Models.ErrorViewModel();
    vm.StatusCode = 403;
    vm.Variant = "danger";
    vm.IconClass = "bi-shield-lock-fill";
    vm.Title ??= "Truy cập bị giới hạn";
    vm.Message ??= "Bạn không có quyền hạn truy cập chức năng này theo chính sách bảo mật RBAC/ACL. Hãy liên hệ Super Admin để được cấp quyền.";
}
<partial name="~/Views/Shared/UI/_ErrorDocument.cshtml" model="vm" />
