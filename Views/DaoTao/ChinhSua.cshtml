@model ERP_HRM_CMS.Models.ViewModels.TrainingCreateEditDto
@{
    ViewData["Title"] = $"Chỉnh Sửa Khóa Đào Tạo - {Model.Title}";
    ViewData["Module"] = "hrm_training";
    ViewData["BreadcrumbSection"] = "Đào tạo & Phát triển";
}

<erp-page-header title="Chỉnh Sửa Khóa Đào Tạo"
                 subtitle="Cập nhật chương trình đào tạo, thời gian và cấu hình tự động cấp chứng chỉ"
                 icon="bi-pencil"
                 breadcrumbs="Dashboard:/|HRM:/NhanSu/Index|Đào tạo:/DaoTao/Index|Chỉnh sửa">
    <a href="/DaoTao/HocVien/@Model.Id" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-people me-1"></i> Danh sách học viên
    </a>
    <a href="/DaoTao/Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
</erp-page-header>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card erp-card">
            <div class="card-body p-4">
                <form method="post" asp-action="ChinhSua" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="All" class="alert alert-danger mb-4" role="alert"></div>

                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-info-circle me-2"></i>1. Thông Tin Khóa Đào Tạo</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Mã khóa học <span class="text-danger">*</span></label>
                            <input asp-for="Code" class="form-control font-monospace" required />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Tên khóa đào tạo / Chuyên đề <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Giảng viên / Đơn vị đào tạo</label>
                            <input asp-for="TrainerName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Địa điểm / Phòng học</label>
                            <input asp-for="Location" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Ngày bắt đầu <span class="text-danger">*</span></label>
                            <input asp-for="StartDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Ngày kết thúc <span class="text-danger">*</span></label>
                            <input asp-for="EndDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Ngân sách (VNĐ)</label>
                            <input asp-for="Budget" type="number" step="100000" class="form-control text-end tabular-nums" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Trạng thái khóa học</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Planned">Dự kiến (Planned)</option>
                                <option value="InProgress">Đang diễn ra (InProgress)</option>
                                <option value="Completed">Đã hoàn thành (Completed)</option>
                                <option value="Cancelled">Đã hủy (Cancelled)</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Nội dung chi tiết &amp; Mục tiêu đầu ra</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <h5 class="fw-bold text-success mb-3"><i class="bi bi-award me-2"></i>2. Tự Động Hóa Đầu Ra (Kỹ Năng &amp; Chứng Chỉ)</h5>
                    <div class="p-3 bg-light rounded border mb-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Tên Kỹ năng được nâng cấp</label>
                                <input asp-for="TargetSkillName" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Tên Chứng chỉ nội bộ được cấp</label>
                                <input asp-for="CertificateName" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/DaoTao/HocVien/@Model.Id" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 ripple">
                            <i class="bi bi-check-circle me-1"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

