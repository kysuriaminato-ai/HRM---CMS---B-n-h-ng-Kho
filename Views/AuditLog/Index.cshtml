@model IEnumerable<ERP_HRM_CMS.Models.Entities.AuditLog>
@{
    ViewData["Title"] = "Nhật Ký Kiểm Toán Hệ Thống (Audit Trail)";
    var entities = ViewBag.Entities as List<string> ?? new();
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalRecords = ViewBag.TotalRecords ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-shield-check me-2 text-primary"></i>Nhật Ký Kiểm Toán Hệ Thống (Audit Trail)</h4>
        <p class="text-muted small mb-0">Ghi vết toàn bộ hành vi thêm mới, sửa đổi và xóa dữ liệu trọng yếu theo chuẩn tuân thủ doanh nghiệp</p>
    </div>
    <div class="text-muted small">
        Tổng số bản ghi: <strong class="text-dark">@totalRecords</strong>
    </div>
</div>

<!-- BỘ LỌC TÌM KIẾM -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-2">
                <select name="entityName" class="form-select form-select-sm">
                    <option value="">-- Tất cả Bảng / Entity --</option>
                    @foreach (var e in entities)
                    {
                        <option value="@e" selected="@(ViewBag.EntityName == e)">@e</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="actionType" class="form-select form-select-sm">
                    <option value="">-- Tất cả Thao tác --</option>
                    <option value="CREATE" selected="@(ViewBag.ActionType == "CREATE")">CREATE (Thêm mới)</option>
                    <option value="UPDATE" selected="@(ViewBag.ActionType == "UPDATE")">UPDATE (Chỉnh sửa)</option>
                    <option value="DELETE" selected="@(ViewBag.ActionType == "DELETE")">DELETE (Xóa bỏ)</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="text" name="username" value="@ViewBag.Username" class="form-control form-control-sm" placeholder="Tên tài khoản thực hiện..." />
            </div>
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <input type="date" name="fromDate" value="@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")" class="form-control" title="Từ ngày" />
                    <span class="input-group-text">-</span>
                    <input type="date" name="toDate" value="@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")" class="form-control" title="Đến ngày" />
                </div>
            </div>
            <div class="col-md-2 text-end d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-dark w-100">Lọc dữ liệu</button>
                <a asp-action="Index" class="btn btn-sm btn-light" title="Bỏ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- BẢNG NHẬT KÝ KIỂM TOÁN -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 160px;">Thời gian</th>
                        <th>Người thực hiện</th>
                        <th class="text-center">Thao tác</th>
                        <th>Bảng dữ liệu</th>
                        <th>Mã bản ghi (ID)</th>
                        <th>Các cột thay đổi</th>
                        <th>IP Address</th>
                        <th class="text-end pe-3">Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var log in Model)
                        {
                            string actionBadge = log.Action switch
                            {
                                "CREATE" => "bg-success-subtle text-success border border-success",
                                "UPDATE" => "bg-primary-subtle text-primary border border-primary",
                                "DELETE" => "bg-danger-subtle text-danger border border-danger",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td class="ps-3 text-muted small font-monospace">
                                    @log.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">
                                        <i class="bi bi-person me-1 text-secondary"></i>@(log.Username ?? "Hệ thống")
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge @actionBadge px-2 py-1">@log.Action</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">@log.EntityName</span>
                                </td>
                                <td class="font-monospace text-muted small">
                                    @(log.RecordId ?? "-")
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(log.AffectedColumns))
                                    {
                                        <span class="text-muted small font-monospace text-truncate d-inline-block" style="max-width: 200px;" title="@log.AffectedColumns">
                                            @log.AffectedColumns
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><em>-</em></span>
                                    }
                                </td>
                                <td class="text-muted small font-monospace">
                                    @(log.IpAddress ?? "Localhost")
                                </td>
                                <td class="text-end pe-3">
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" onclick="viewAuditDetails(@log.Id)">
                                        <i class="bi bi-code-slash me-1"></i> Xem Diff
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-shield-slash fs-2 d-block mb-2 text-secondary"></i>
                                Chưa có nhật ký kiểm toán nào được ghi nhận.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Trang @currentPage / @totalPages</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-entityName="@ViewBag.EntityName" asp-route-actionType="@ViewBag.ActionType" asp-route-username="@ViewBag.Username">Trước</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        if (p == currentPage || p == 1 || p == totalPages || Math.Abs(p - currentPage) <= 2)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-entityName="@ViewBag.EntityName" asp-route-actionType="@ViewBag.ActionType" asp-route-username="@ViewBag.Username">@p</a>
                            </li>
                        }
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-entityName="@ViewBag.EntityName" asp-route-actionType="@ViewBag.ActionType" asp-route-username="@ViewBag.Username">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<!-- Modal Xem Chi Tiết Diff JSON -->
<div class="modal fade" id="auditDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle"><i class="bi bi-journal-code text-primary me-2"></i>Chi Tiết Thay Đổi Dữ Liệu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <h6 class="fw-semibold text-danger mb-2"><i class="bi bi-dash-circle me-1"></i>Giá Trị Ban Đầu (Old Values)</h6>
                        <pre class="bg-light p-3 border rounded small font-monospace" id="oldValuesJson" style="max-height: 350px; overflow-y: auto;">-</pre>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-semibold text-success mb-2"><i class="bi bi-plus-circle me-1"></i>Giá Trị Mới (New Values)</h6>
                        <pre class="bg-light p-3 border rounded small font-monospace" id="newValuesJson" style="max-height: 350px; overflow-y: auto;">-</pre>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function viewAuditDetails(id) {
        fetch('/AuditLog/GetDetails?id=' + id)
            .then(res => res.json())
            .then(data => {
                document.getElementById('modalTitle').innerHTML = `<i class="bi bi-journal-code text-primary me-2"></i>Chi Tiết [${HRM.escapeHtml(data.action)}] Bảng ${HRM.escapeHtml(data.entityName)} (ID: ${HRM.escapeHtml(data.recordId || '-')})`;
                
                try {
                    document.getElementById('oldValuesJson').textContent = data.oldValues ? JSON.stringify(JSON.parse(data.oldValues), null, 2) : 'Không có giá trị cũ';
                } catch {
                    document.getElementById('oldValuesJson').textContent = data.oldValues || 'Không có giá trị cũ';
                }

                try {
                    document.getElementById('newValuesJson').textContent = data.newValues ? JSON.stringify(JSON.parse(data.newValues), null, 2) : 'Không có giá trị mới';
                } catch {
                    document.getElementById('newValuesJson').textContent = data.newValues || 'Không có giá trị mới';
                }

                const modal = new bootstrap.Modal(document.getElementById('auditDetailModal'));
                modal.show();
            });
    }
</script>
}
