@model ERP_HRM_CMS.Models.ErrorViewModel
@{
    Layout = null;
    var vm = Model ?? new ERP_HRM_CMS.Models.ErrorViewModel { StatusCode = 500 };
    string targetView = vm.StatusCode switch
    {
        403 => "~/Views/Shared/Error403.cshtml",
        404 => "~/Views/Shared/Error404.cshtml",
        _ => "~/Views/Shared/Error500.cshtml"
    };
}
<partial name="@targetView" model="vm" />
