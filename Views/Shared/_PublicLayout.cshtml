@inject ERP_HRM_CMS.Data.AppDbContext Db
@{
    var settings = Db.SiteSettings.ToDictionary(s => s.SettingKey, s => s.SettingValue ?? string.Empty);
    string siteName = "AURA BRILLIANCE";
    string hotline = settings.GetValueOrDefault("Site_Hotline") ?? "1900 6868";
    string email = settings.GetValueOrDefault("Site_Email") ?? "concierge@aurabrilliance.com";
    string copyright = $"© {ERP_HRM_CMS.Helpers.VietnamTime.Now.Year} AURA BRILLIANCE HAUTE JOAILLERIE. All rights reserved.";
    string keyword = Context.Request.Query["keyword"].ToString();
    string hotlineDigits = new string(hotline.Where(char.IsDigit).ToArray());
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    string userName = User.Identity?.Name ?? "Thành viên VIP";
    bool isSuperAdmin = User.IsInRole("SUPERADMIN") || string.Equals(User.FindFirst("IsSuperAdmin")?.Value, "True", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <erp-seo-head title="@((string?)ViewData["Title"] ?? "AURA BRILLIANCE - Tuyệt Tác Trang Sức Kim Cương & Đá Quý")"
                  description="@((string?)ViewData["Description"] ?? "Thế giới trang sức xa xỉ, nhẫn kim cương tự nhiên chứng nhận GIA, vòng tay, dây chuyền vàng 18K và bạch kim Platinum thượng hạng.")"
                  canonical="@((string?)ViewData["CanonicalUrl"])"
                  og-image="@((string?)ViewData["OgImage"] ?? "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=1200&q=80")"
                  og-type="@((string?)ViewData["OgType"] ?? "website")"
                  entity-type="@((string?)ViewData["SeoEntityType"])"
                  entity-id="@((int?)ViewData["SeoEntityId"])"
                  custom-json-ld="@((string?)ViewData["CustomJsonLd"])"></erp-seo-head>
    <title>@ViewData["Title"] - AURA BRILLIANCE Joaillerie</title>
    
    <!-- Google Fonts: Cormorant Garamond / Playfair Display & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    
    <!-- Base styles & Luxury Jewelry Styling -->
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/public-site.css" rel="stylesheet" />
    <link href="~/css/perfume-luxury.css" rel="stylesheet" />
</head>
<body class="pf-luxury-body">
    <a class="ps-skip-link" href="#noi-dung-chinh">Bỏ qua điều hướng</a>

    <!-- 1. Thanh Marquee Chuyển Động Tĩnh Lấp Lánh Kim Cương -->
    <div class="pf-marquee-wrap">
        <div class="pf-marquee-content">
            <span class="mx-4 text-uppercase small" style="letter-spacing: 0.15em; color: var(--pf-gold-light);">
                ✦ 100% KIM CƯƠNG TỰ NHIÊN CHỨNG NHẬN GIA QUỐC TẾ
            </span>
            <span class="mx-4 text-uppercase small" style="letter-spacing: 0.15em; color: var(--pf-text-secondary);">
                ✦ BẢO HÀNH ĐÁNH BÓNG & SI LÀM SẠCH MIỄN PHÍ TRỌN ĐỜI
            </span>
            <span class="mx-4 text-uppercase small" style="letter-spacing: 0.15em; color: var(--pf-gold-light);">
                ✦ MIỄN PHÍ KHẮC CHỮ LASER TÊN RIÊNG & DẤU VÂN TAY Ý NGHĨA
            </span>
            <span class="mx-4 text-uppercase small" style="letter-spacing: 0.15em; color: var(--pf-text-secondary);">
                ✦ CAM KẾT THU ĐỔI LÊN ĐẾN 95% GIÁ TRỊ TRÊN TOÀN HỆ THỐNG
            </span>
            <span class="mx-4 text-uppercase small" style="letter-spacing: 0.15em; color: var(--pf-gold-light);">
                ✦ GIAO HỎA TỐC BẢO HIỂM 100% TRONG 2 GIỜ
            </span>
            <span class="mx-4 text-uppercase small" style="letter-spacing: 0.15em; color: var(--pf-gold-light);">
                ✦ 100% KIM CƯƠNG TỰ NHIÊN CHỨNG NHẬN GIA QUỐC TẾ
            </span>
            <span class="mx-4 text-uppercase small" style="letter-spacing: 0.15em; color: var(--pf-text-secondary);">
                ✦ BẢO HÀNH ĐÁNH BÓNG & SI LÀM SẠCH MIỄN PHÍ TRỌN ĐỜI
            </span>
        </div>
    </div>

    <!-- 2. Thanh Topbar Tiện Ích & Đăng Ký / Đăng Nhập -->
    <div class="pf-top-bar d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-4">
                <span><i class="bi bi-geo-alt me-1 text-warning"></i>Boutique: 88 Đồng Khởi, Q.1, TP.HCM & 12 Tràng Tiền, Hà Nội</span>
                <a href="tel:@hotlineDigits" class="text-decoration-none text-secondary hover-gold">
                    <i class="bi bi-telephone me-1 text-warning"></i>Hotline VIP: <strong>@hotline</strong>
                </a>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="#bang-do-size" class="text-decoration-none text-secondary hover-gold"><i class="bi bi-rulers me-1"></i>Đo Size Nhẫn</a>
                <a href="/Public/GioiThieu" class="text-decoration-none text-secondary hover-gold"><i class="bi bi-gem me-1"></i>Về Aura Brilliance</a>
                <a href="/tuyen-dung" class="text-decoration-none text-secondary hover-gold"><i class="bi bi-briefcase me-1"></i>Tuyển dụng</a>
                
                @if (isAuthenticated)
                {
                    <div class="dropdown d-inline-block">
                        <button class="btn btn-sm btn-outline-warning dropdown-toggle rounded-pill px-3" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i> @userName
                            @if (isSuperAdmin)
                            {
                                <span class="badge bg-danger ms-1">Admin Tổng</span>
                            }
                            else
                            {
                                <span class="badge bg-primary ms-1">Thành viên / Admin Con</span>
                            }
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow">
                            <li>
                                <a class="dropdown-item py-2" href="/Home/Index">
                                    <i class="bi bi-speedometer2 text-warning me-2"></i> Bảng điều khiển Quản trị ERP
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="/CongNhanVien">
                                    <i class="bi bi-person-workspace text-primary me-2"></i> Cổng Nhân viên (ESS)
                                </a>
                            </li>
                            <li><hr class="dropdown-divider border-secondary" /></li>
                            <li>
                                <a class="dropdown-item py-2 text-danger" href="/Auth/Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2">
                        <a href="/Auth/Register" class="text-decoration-none text-light px-2 py-1 rounded hover-gold small">
                            <i class="bi bi-person-plus me-1 text-warning"></i> Đăng ký
                        </a>
                        <span class="text-secondary opacity-50">|</span>
                        <a href="/Auth/Login" class="pf-erp-badge-link" title="Đăng nhập tài khoản hoặc cổng quản trị">
                            <i class="bi bi-shield-lock"></i> Đăng nhập / Cổng ERP
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 3. Thanh Navigation Chính Cửa Hàng Trang Sức -->
    <header class="pf-navbar">
        <div class="container d-flex justify-content-between align-items-center py-3">
            <!-- Brand Logo -->
            <a href="/" class="d-flex align-items-center gap-3 text-decoration-none">
                <div class="pf-sparkle-icon" style="font-size: 2rem; color: var(--pf-gold);">
                    <i class="bi bi-gem"></i>
                </div>
                <div>
                    <span class="pf-brand-name">AURA BRILLIANCE</span>
                    <span class="pf-brand-subtitle">HAUTE JOAILLERIE & DIAMONDS • PARIS</span>
                </div>
            </a>

            <!-- Desktop Nav Links -->
            <nav class="d-none d-lg-flex align-items-center gap-1">
                <a href="/" class="pf-nav-link active">Trang Chủ</a>
                <a href="#bo-suu-tap" class="pf-nav-link">Nhẫn Kim Cương</a>
                <a href="#bo-suu-tap" class="pf-nav-link">Vòng &amp; Lắc Tay</a>
                <a href="#bo-suu-tap" class="pf-nav-link">Dây Chuyền</a>
                <a href="#bo-suu-tap" class="pf-nav-link">Bông Tai</a>
                <a href="#tieu-chuan-4c" class="pf-nav-link">Tiêu Chuẩn 4Cs</a>
                <a href="#bang-do-size" class="pf-nav-link">Bảng Đo Size</a>
                <a href="/Public/LienHe" class="pf-nav-link">Showroom VIP</a>
            </nav>

            <!-- Action Buttons -->
            <div class="d-flex align-items-center gap-3">
                <!-- Search Button -->
                <button type="button" class="btn btn-outline-secondary border-0 text-light rounded-circle p-2" 
                        data-bs-toggle="modal" data-bs-target="#pfSearchModal" aria-label="Tìm kiếm trang sức">
                    <i class="bi bi-search" style="font-size: 1.15rem;"></i>
                </button>

                <!-- Giỏ hàng -->
                <a href="/GioHang" class="btn btn-outline-warning border-0 position-relative p-2" aria-label="Giỏ hàng trang sức">
                    <i class="bi bi-bag" style="font-size: 1.25rem; color: var(--pf-gold-light);"></i>
                    <span id="pfCartBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark" style="font-size: 0.7rem; font-weight: 700;">
                        2
                    </span>
                </a>

                <!-- Mobile menu toggle -->
                <button class="btn btn-dark d-lg-none border-secondary" type="button" data-bs-toggle="offcanvas" data-bs-target="#pfMobileNav">
                    <i class="bi bi-list fs-4 text-warning"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile Offcanvas Menu -->
    <div class="offcanvas offcanvas-start bg-dark text-light" tabindex="-1" id="pfMobileNav">
        <div class="offcanvas-header border-bottom border-secondary">
            <div>
                <span class="pf-brand-name fs-4">AURA BRILLIANCE</span>
                <span class="pf-brand-subtitle">HAUTE JOAILLERIE</span>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column gap-3">
            <a href="/" class="text-light text-decoration-none py-2 border-bottom border-secondary"><i class="bi bi-house me-2 text-warning"></i>Trang Chủ</a>
            <a href="#bo-suu-tap" class="text-light text-decoration-none py-2 border-bottom border-secondary"><i class="bi bi-gem me-2 text-warning"></i>Nhẫn Kim Cương</a>
            <a href="#bo-suu-tap" class="text-light text-decoration-none py-2 border-bottom border-secondary"><i class="bi bi-circle me-2 text-warning"></i>Vòng &amp; Lắc Tay</a>
            <a href="#bo-suu-tap" class="text-light text-decoration-none py-2 border-bottom border-secondary"><i class="bi bi-link-45deg me-2 text-warning"></i>Dây Chuyền &amp; Mặt Dây</a>
            <a href="#bo-suu-tap" class="text-light text-decoration-none py-2 border-bottom border-secondary"><i class="bi bi-stars me-2 text-warning"></i>Bông Tai Cao Cấp</a>
            <a href="#tieu-chuan-4c" class="text-light text-decoration-none py-2 border-bottom border-secondary"><i class="bi bi-patch-check me-2 text-warning"></i>Tiêu Chuẩn 4Cs GIA</a>
            <a href="#bang-do-size" class="text-light text-decoration-none py-2 border-bottom border-secondary"><i class="bi bi-rulers me-2 text-warning"></i>Bảng Đo Size Nhẫn</a>
            <a href="/Public/LienHe" class="text-light text-decoration-none py-2 border-bottom border-secondary"><i class="bi bi-geo-alt me-2 text-warning"></i>Showroom &amp; Liên Hệ</a>
            
            <div class="mt-4 pt-3 border-top border-secondary d-flex flex-column gap-2">
                @if (isAuthenticated)
                {
                    <a href="/Home/Index" class="btn btn-warning w-100 fw-bold">
                        <i class="bi bi-speedometer2 me-1"></i> Bảng Điều Khiển Quản Trị (@userName)
                    </a>
                    <a href="/Auth/Logout" class="btn btn-outline-danger w-100">
                        <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                    </a>
                }
                else
                {
                    <a href="/Auth/Register" class="btn btn-outline-warning w-100 fw-bold">
                        <i class="bi bi-person-plus me-1"></i> Đăng Ký Tài Khoản Mới
                    </a>
                    <a href="/Auth/Login" class="btn btn-warning w-100 fw-bold">
                        <i class="bi bi-shield-lock me-1"></i> Đăng Nhập / Cổng ERP
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Search Modal -->
    <div class="modal fade" id="pfSearchModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" style="background: rgba(14, 18, 26, 0.98); border: 1px solid var(--pf-gold); backdrop-filter: blur(20px);">
                <div class="modal-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-warning fw-bold text-uppercase small" style="letter-spacing: 0.1em;">Tìm kiếm trang sức &amp; kim cương</span>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/Public/TinTuc" method="get" class="position-relative">
                        <input type="text" name="keyword" class="form-control form-control-lg bg-dark text-light border-secondary pe-5" 
                               placeholder="Nhập tên trang sức (Nhẫn Solitaire, Tennis Bracelet, Bạch kim, Vàng 18K, Kim cương GIA...)..." autofocus />
                        <button type="submit" class="btn btn-warning position-absolute end-0 top-0 h-100 px-4 rounded-start-0">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                    <div class="mt-3 d-flex flex-wrap gap-2 align-items-center">
                        <span class="text-muted small">Tìm kiếm phổ biến:</span>
                        <span class="badge bg-secondary cursor-pointer">Nhẫn Solitaire 1.5ct</span>
                        <span class="badge bg-secondary cursor-pointer">Tennis Bracelet</span>
                        <span class="badge bg-secondary cursor-pointer">Nhẫn Cưới Eternity</span>
                        <span class="badge bg-secondary cursor-pointer">Mặt Dây Kim Cương</span>
                        <span class="badge bg-secondary cursor-pointer">Sapphire Ceylon</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Nội Dung Chính Của Trang -->
    <main id="noi-dung-chinh" role="main">
        @RenderBody()
    </main>

    <!-- 5. Chân Trang Luxury Jewelry Chuyên Nghiệp -->
    <footer class="pf-footer">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-gem fs-3 text-warning"></i>
                        <span class="pf-brand-name fs-4">AURA BRILLIANCE</span>
                    </div>
                    <p class="small text-secondary mb-4" style="line-height: 1.8;">
                        Thương hiệu chế tác kim hoàn và phân phối kim cương tự nhiên chứng nhận GIA tiêu chuẩn Quốc tế hàng đầu. Nơi hội tụ tinh hoa nghệ thuật chạm khắc đá quý và vàng 18K/Bạch kim vĩnh cửu.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="#" class="btn btn-outline-warning btn-sm rounded-circle p-2" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-outline-warning btn-sm rounded-circle p-2" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="btn btn-outline-warning btn-sm rounded-circle p-2" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                        <a href="#" class="btn btn-outline-warning btn-sm rounded-circle p-2" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <h6 class="pf-footer-title">Bộ Sưu Tập</h6>
                    <ul class="pf-footer-links">
                        <li><a href="#bo-suu-tap">Nhẫn Kim Cương</a></li>
                        <li><a href="#bo-suu-tap">Vòng &amp; Lắc Tay</a></li>
                        <li><a href="#bo-suu-tap">Dây Chuyền &amp; Mặt Dây</a></li>
                        <li><a href="#bo-suu-tap">Bông Tai Cao Cấp</a></li>
                        <li><a href="#bo-suu-tap">Trang Sức Cưới</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <h6 class="pf-footer-title">Dịch Vụ VIP</h6>
                    <ul class="pf-footer-links">
                        <li><a href="#bang-do-size">Hướng Dẫn Đo Size</a></li>
                        <li><a href="#tieu-chuan-4c">Tiêu Chuẩn 4Cs GIA</a></li>
                        <li><a href="/Public/LienHe">Đặt Hẹn Phòng Chờ VIP</a></li>
                        <li><a href="/Auth/Register" class="text-warning fw-semibold"><i class="bi bi-person-plus me-1"></i>Đăng Ký Tài Khoản</a></li>
                        <li><a href="/Auth/Login" class="text-warning fw-semibold"><i class="bi bi-shield-lock me-1"></i>Cổng Quản Trị ERP</a></li>
                    </ul>
                </div>

                <div class="col-lg-4">
                    <h6 class="pf-footer-title">Hệ Thống Flagship Boutique</h6>
                    <ul class="pf-footer-links">
                        <li class="d-flex gap-2">
                            <i class="bi bi-geo-alt-fill text-warning mt-1"></i>
                            <span><strong>Flagship Sài Gòn:</strong> 88 Đồng Khởi, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh</span>
                        </li>
                        <li class="d-flex gap-2 mt-2">
                            <i class="bi bi-geo-alt-fill text-warning mt-1"></i>
                            <span><strong>Boutique Hà Nội:</strong> 12 Tràng Tiền, Quận Hoàn Kiếm, TP. Hà Nội</span>
                        </li>
                        <li class="d-flex gap-2 mt-2">
                            <i class="bi bi-telephone-fill text-warning mt-1"></i>
                            <span>Hotline Chăm Sóc VIP: <strong>@hotline</strong> (08:30 - 22:00)</span>
                        </li>
                    </ul>

                    <div class="mt-4 p-3 rounded" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(212,175,55,0.2);">
                        <span class="text-warning small fw-bold text-uppercase d-block mb-1">Đăng ký nhận thông tin bộ sưu tập mới</span>
                        <div class="input-group input-group-sm">
                            <input type="email" class="form-control bg-dark text-light border-secondary" placeholder="Nhập email của bạn...">
                            <button class="btn btn-warning fw-bold" type="button">Đăng ký</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-4 mt-5 border-top border-secondary d-flex flex-wrap justify-content-between align-items-center gap-2 small">
                <span>@copyright</span>
                <span class="text-secondary">Hệ thống ERP Kim hoàn, Quản lý kho đá quý &amp; Phân quyền Admin Con tích hợp thời gian thực.</span>
            </div>
        </div>
    </footer>

    <!-- Toast Thông Báo Khi Thêm Trang Sức Vào Giỏ Hàng -->
    <div id="pfCartToast" class="pf-toast">
        <div class="rounded-circle p-2" style="background: rgba(212,175,55,0.2); color: var(--pf-gold-light);">
            <i class="bi bi-gem fs-4"></i>
        </div>
        <div>
            <strong class="d-block text-light" style="font-size: 0.95rem;">Đã thêm trang sức vào giỏ hàng!</strong>
            <span id="pfToastProdName" class="text-secondary small">Tuyệt tác kim hoàn đã sẵn sàng trong giỏ của bạn.</span>
        </div>
        <a href="/GioHang" class="btn btn-warning btn-sm fw-bold ms-2 px-3">Xem Giỏ</a>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function showJewelryToast(productName) {
            var toast = document.getElementById('pfCartToast');
            var nameEl = document.getElementById('pfToastProdName');
            if (nameEl && productName) nameEl.textContent = productName;
            if (toast) {
                toast.style.display = 'flex';
                var badge = document.getElementById('pfCartBadge');
                if (badge) {
                    var cur = parseInt(badge.textContent) || 0;
                    badge.textContent = cur + 1;
                    badge.classList.add('pf-pulse-node');
                }
                setTimeout(function() {
                    toast.style.display = 'none';
                }, 4000);
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
