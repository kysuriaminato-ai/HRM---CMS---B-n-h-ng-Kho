@inject ERP_HRM_CMS.Data.AppDbContext Db
@{
    var settings = Db.SiteSettings.ToDictionary(s => s.SettingKey, s => s.SettingValue ?? string.Empty);
    string siteName = settings.GetValueOrDefault("Site_Name") ?? "TIEN PHONG ENTERPRISE";
    string hotline = settings.GetValueOrDefault("Site_Hotline") ?? "1900 6868";
    string email = settings.GetValueOrDefault("Site_Email") ?? "contact@tienphong.vn";
    string copyright = settings.GetValueOrDefault("Site_Copyright") ?? "© 2026 Tien Phong Corp.";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @siteName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body class="bg-white">
    <!-- Header Top -->
    <div class="bg-dark text-white py-2 small border-bottom border-secondary">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex gap-4">
                <span><i class="bi bi-telephone me-1"></i> Hotline: <strong>@hotline</strong></span>
                <span><i class="bi bi-envelope me-1"></i> Email: @email</span>
            </div>
            <div class="d-flex gap-3">
                <a href="/Auth/Login" class="text-white text-decoration-none"><i class="bi bi-shield-lock me-1"></i> Cổng Nội Bộ</a>
            </div>
        </div>
    </div>

    <!-- Dynamic Menu Component -->
    @await Component.InvokeAsync("DynamicMenu")

    <!-- Nội dung chính động -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer Main -->
    <footer class="bg-black text-white pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <h5 class="fw-bold mb-3">@siteName</h5>
                    <p class="text-secondary small">Giải pháp quản trị nguồn lực doanh nghiệp tích hợp Nhân sự, Bán hàng, Kho vận và CMS động.</p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-uppercase fw-bold mb-3 text-white">Liên Hệ</h6>
                    <p class="small text-secondary mb-1">Điện thoại: @hotline</p>
                    <p class="small text-secondary mb-1">Email: @email</p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-uppercase fw-bold mb-3 text-white">Chính Sách</h6>
                    <p class="small text-secondary">Tất cả dữ liệu và quy trình được bảo mật theo tiêu chuẩn ISO/IEC 27001.</p>
                </div>
            </div>
            <div class="border-top border-secondary mt-4 pt-3 text-center small text-secondary">
                @copyright
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
