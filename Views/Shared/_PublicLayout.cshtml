@inject ERP_HRM_CMS.Data.AppDbContext Db
@{
    var settings = Db.SiteSettings.ToDictionary(s => s.SettingKey, s => s.SettingValue ?? string.Empty);
    string siteName = settings.GetValueOrDefault("Site_Name") ?? "L'AURA NOIR";
    string hotline = settings.GetValueOrDefault("Site_Hotline") ?? "1900 8899";
    string email = settings.GetValueOrDefault("Site_Email") ?? "contact@lauranoir.paris";
    string address = settings.GetValueOrDefault("Site_Address") ?? "88 Đồng Khởi, Bến Nghé, Quận 1, TP. Hồ Chí Minh";
    string copyright = $"© {ERP_HRM_CMS.Helpers.VietnamTime.Now.Year} L'AURA NOIR HAUTE PARFUMERIE. All rights reserved.";
    string keyword = Context.Request.Query["keyword"].ToString();
    string hotlineDigits = new string(hotline.Where(char.IsDigit).ToArray());
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    string userName = User.Identity?.Name ?? "Quản trị";
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <erp-seo-head title="@((string?)ViewData["Title"] ?? "L'AURA NOIR - Nước Hoa Cao Cấp & Niche Chính Hãng")"
                  description="@((string?)ViewData["Description"] ?? "Thế giới nước hoa cao cấp, Niche & Designer chính hãng nhập khẩu từ Pháp và Ý. Đẳng cấp lưu hương vượt trội, tư vấn chọn mùi hương chuyên nghiệp.")"
                  canonical="@((string?)ViewData["CanonicalUrl"])"
                  og-image="@((string?)ViewData["OgImage"] ?? "https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?auto=format&fit=crop&w=1200&q=80")"
                  og-type="@((string?)ViewData["OgType"] ?? "website")"
                  entity-type="@((string?)ViewData["SeoEntityType"])"
                  entity-id="@((int?)ViewData["SeoEntityId"])"
                  custom-json-ld="@((string?)ViewData["CustomJsonLd"])"></erp-seo-head>
    <title>@ViewData["Title"] - L'AURA NOIR Parfums</title>
    
    <!-- Google Fonts: Playfair Display (Serif sang trọng) & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    
    <!-- Base styles & Luxury Perfume Styling -->
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/public-site.css" rel="stylesheet" />
    <link href="~/css/perfume-luxury.css" rel="stylesheet" />
</head>
<body class="pf-luxury-body">
    <a class="ps-skip-link" href="#noi-dung-chinh">Bỏ qua điều hướng</a>

    <!-- 1. Thanh Marquee Chuyển Động Tĩnh Thông Báo Cao Cấp -->
    <div class="pf-marquee-wrap">
        <div class="pf-marquee-content">
            <span class="mx-4 text-uppercase small" style="letter-spacing: 0.15em; color: var(--pf-gold-light);">
                ✦ 100% NƯỚC HOA CHÍNH HÃNG NHẬP KHẨU PHÁP & Ý
            </span>
            <span class="mx-4 text-uppercase small" style="letter-spacing: 0.15em; color: var(--pf-text-secondary);">
                ✦ TẶNG KÈM 2 SAMPLE 2ML CAO CẤP VỚI MỌI ĐƠN HÀNG
            </span>
            <span class="mx-4 text-uppercase small" style="letter-spacing: 0.15em; color: var(--pf-gold-light);">
                ✦ BẢO HÀNH MÙI HƯƠNG & ĐỘ LƯU HƯƠNG 14H+ TRỌN ĐỜI
            </span>
            <span class="mx-4 text-uppercase small" style="letter-spacing: 0.15em; color: var(--pf-text-secondary);">
                ✦ GIAO HỎA TỐC 2 GIỜ TẠI HÀ NỘI & TP. HỒ CHÍ MINH
            </span>
            <span class="mx-4 text-uppercase small" style="letter-spacing: 0.15em; color: var(--pf-gold-light);">
                ✦ ĐẶT LỊCH THỬ MÙI VIP MIỄN PHÍ TẠI BOUTIQUE
            </span>
            <span class="mx-4 text-uppercase small" style="letter-spacing: 0.15em; color: var(--pf-gold-light);">
                ✦ 100% NƯỚC HOA CHÍNH HÃNG NHẬP KHẨU PHÁP & Ý
            </span>
            <span class="mx-4 text-uppercase small" style="letter-spacing: 0.15em; color: var(--pf-text-secondary);">
                ✦ TẶNG KÈM 2 SAMPLE 2ML CAO CẤP VỚI MỌI ĐƠN HÀNG
            </span>
        </div>
    </div>

    <!-- 2. Thanh Topbar Tiện Ích -->
    <div class="pf-top-bar d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-4">
                <span><i class="bi bi-geo-alt me-1 text-warning"></i>Boutique: 88 Đồng Khởi, Q.1, TP.HCM & 12 Tràng Tiền, Hà Nội</span>
                <a href="tel:@hotlineDigits" class="text-decoration-none text-secondary hover-gold">
                    <i class="bi bi-telephone me-1 text-warning"></i>Hotline VIP: <strong>@hotline</strong>
                </a>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="/Public/GioiThieu" class="text-decoration-none text-secondary hover-gold"><i class="bi bi-gem me-1"></i>Về L'Aura Noir</a>
                <a href="/tuyen-dung" class="text-decoration-none text-secondary hover-gold"><i class="bi bi-briefcase me-1"></i>Tuyển dụng</a>
                
                @if (isAuthenticated)
                {
                    <a href="/Home/Index" class="pf-erp-badge-link">
                        <i class="bi bi-speedometer2"></i> Quản trị ERP (@userName)
                    </a>
                    <a href="/Auth/Logout" class="text-decoration-none text-secondary hover-gold small">
                        <i class="bi bi-box-arrow-right"></i> Thoát
                    </a>
                }
                else
                {
                    <a href="/Auth/Login" class="pf-erp-badge-link" title="Đăng nhập dành cho nhân viên & quản trị viên">
                        <i class="bi bi-shield-lock"></i> Cổng Quản Trị ERP / CMS
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- 3. Thanh Navigation Chính -->
    <header class="pf-navbar">
        <div class="container d-flex justify-content-between align-items-center py-3">
            <!-- Brand Logo -->
            <a href="/" class="d-flex align-items-center gap-3 text-decoration-none">
                <div class="pf-sparkle-icon" style="font-size: 1.85rem; color: var(--pf-gold);">
                    <i class="bi bi-droplet-half"></i>
                </div>
                <div>
                    <span class="pf-brand-name">L'AURA NOIR</span>
                    <span class="pf-brand-subtitle">HAUTE PARFUMERIE • PARIS</span>
                </div>
            </a>

            <!-- Desktop Nav Links -->
            <nav class="d-none d-lg-flex align-items-center gap-1">
                <a href="/" class="pf-nav-link active">Trang Chủ</a>
                <a href="#bo-suu-tap" class="pf-nav-link">Nước Hoa Nam</a>
                <a href="#bo-suu-tap" class="pf-nav-link">Nước Hoa Nữ</a>
                <a href="#bo-suu-tap" class="pf-nav-link">Bộ Sưu Tập Niche</a>
                <a href="#thap-mui-huong" class="pf-nav-link">Tháp Mùi Hương</a>
                <a href="#trac-nghiem-huong" class="pf-nav-link">Chọn Mùi Theo Gu</a>
                <a href="/Public/LienHe" class="pf-nav-link">Boutique & Showroom</a>
            </nav>

            <!-- Action Buttons -->
            <div class="d-flex align-items-center gap-3">
                <!-- Search Button -->
                <button type="button" class="btn btn-outline-secondary border-0 text-light rounded-circle p-2" 
                        data-bs-toggle="modal" data-bs-target="#pfSearchModal" aria-label="Tìm kiếm nước hoa">
                    <i class="bi bi-search" style="font-size: 1.15rem;"></i>
                </button>

                <!-- Giỏ hàng -->
                <a href="/GioHang" class="btn btn-outline-warning border-0 position-relative p-2" aria-label="Giỏ hàng">
                    <i class="bi bi-bag" style="font-size: 1.25rem; color: var(--pf-gold-light);"></i>
                    <span id="pfCartBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark" style="font-size: 0.7rem; font-weight: 700;">
                        3
                    </span>
                </a>

                <!-- Mobile menu toggle -->
                <button class="btn btn-dark d-lg-none border-secondary" type="button" data-bs-toggle="offcanvas" data-bs-target="#pfMobileNav">
                    <i class="bi bi-list fs-4 text-warning"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile Offcanvas Menu -->
    <div class="offcanvas offcanvas-start bg-dark text-light" tabindex="-1" id="pfMobileNav">
        <div class="offcanvas-header border-bottom border-secondary">
            <div>
                <span class="pf-brand-name fs-4">L'AURA NOIR</span>
                <span class="pf-brand-subtitle">HAUTE PARFUMERIE</span>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column gap-3">
            <a href="/" class="text-light text-decoration-none py-2 border-bottom border-secondary"><i class="bi bi-house me-2 text-warning"></i>Trang Chủ</a>
            <a href="#bo-suu-tap" class="text-light text-decoration-none py-2 border-bottom border-secondary"><i class="bi bi-gender-male me-2 text-warning"></i>Nước Hoa Nam</a>
            <a href="#bo-suu-tap" class="text-light text-decoration-none py-2 border-bottom border-secondary"><i class="bi bi-gender-female me-2 text-warning"></i>Nước Hoa Nữ</a>
            <a href="#bo-suu-tap" class="text-light text-decoration-none py-2 border-bottom border-secondary"><i class="bi bi-stars me-2 text-warning"></i>Bộ Sưu Tập Niche</a>
            <a href="#thap-mui-huong" class="text-light text-decoration-none py-2 border-bottom border-secondary"><i class="bi bi-triangle me-2 text-warning"></i>Tháp Mùi Hương</a>
            <a href="#trac-nghiem-huong" class="text-light text-decoration-none py-2 border-bottom border-secondary"><i class="bi bi-magic me-2 text-warning"></i>Chọn Mùi Theo Gu</a>
            <a href="/Public/LienHe" class="text-light text-decoration-none py-2 border-bottom border-secondary"><i class="bi bi-geo-alt me-2 text-warning"></i>Showroom & Liên Hệ</a>
            
            <div class="mt-4 pt-3 border-top border-secondary">
                <a href="/Auth/Login" class="btn btn-warning w-100 fw-bold">
                    <i class="bi bi-shield-lock me-1"></i> Cổng Quản Trị ERP / CMS
                </a>
            </div>
        </div>
    </div>

    <!-- Search Modal -->
    <div class="modal fade" id="pfSearchModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" style="background: rgba(14, 18, 26, 0.98); border: 1px solid var(--pf-gold); backdrop-filter: blur(20px);">
                <div class="modal-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-warning fw-bold text-uppercase small" style="letter-spacing: 0.1em;">Tìm kiếm tuyệt tác nước hoa</span>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/Public/TinTuc" method="get" class="position-relative">
                        <input type="text" name="keyword" class="form-control form-control-lg bg-dark text-light border-secondary pe-5" 
                               placeholder="Nhập tên nước hoa, thương hiệu (Tom Ford, Chanel, Baccarat 540, Le Labo...)..." autofocus />
                        <button type="submit" class="btn btn-warning position-absolute end-0 top-0 h-100 px-4 rounded-start-0">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                    <div class="mt-3 d-flex flex-wrap gap-2 align-items-center">
                        <span class="text-muted small">Gợi ý tìm kiếm:</span>
                        <span class="badge bg-secondary cursor-pointer">Baccarat Rouge 540</span>
                        <span class="badge bg-secondary cursor-pointer">Tom Ford Oud Wood</span>
                        <span class="badge bg-secondary cursor-pointer">Santal 33</span>
                        <span class="badge bg-secondary cursor-pointer">Bleu De Chanel</span>
                        <span class="badge bg-secondary cursor-pointer">Sauvage Elixir</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Nội Dung Chính Của Trang -->
    <main id="noi-dung-chinh" role="main">
        @RenderBody()
    </main>

    <!-- 5. Chân Trang Luxury Chuyên Nghiệp -->
    <footer class="pf-footer">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-droplet-half fs-3 text-warning"></i>
                        <span class="pf-brand-name fs-4">L'AURA NOIR</span>
                    </div>
                    <p class="small text-secondary mb-4" style="line-height: 1.8;">
                        Nhà giám tuyển và phân phối nước hoa Niche, Haute Parfumerie & Designer cao cấp hàng đầu Việt Nam. Nơi lưu giữ và tôn vinh nghệ thuật điều hương thủ công từ những kinh đô nước hoa bậc nhất thế giới.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="#" class="btn btn-outline-warning btn-sm rounded-circle p-2" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-outline-warning btn-sm rounded-circle p-2" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="btn btn-outline-warning btn-sm rounded-circle p-2" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                        <a href="#" class="btn btn-outline-warning btn-sm rounded-circle p-2" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <h6 class="pf-footer-title">Bộ Sưu Tập</h6>
                    <ul class="pf-footer-links">
                        <li><a href="#bo-suu-tap">Nước Hoa Nam</a></li>
                        <li><a href="#bo-suu-tap">Nước Hoa Nữ</a></li>
                        <li><a href="#bo-suu-tap">Niche & Độc Bản</a></li>
                        <li><a href="#thap-mui-huong">Extrait de Parfum</a></li>
                        <li><a href="#bo-suu-tap">Gift Set & Chiết VIP</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <h6 class="pf-footer-title">Dịch Vụ VIP</h6>
                    <ul class="pf-footer-links">
                        <li><a href="#trac-nghiem-huong">Tư Vấn Chọn Mùi</a></li>
                        <li><a href="/Public/GioiThieu">Thử Mùi Tại Nhà</a></li>
                        <li><a href="/Public/LienHe">Đặt Lịch Boutique</a></li>
                        <li><a href="/tuyen-dung">Cơ Hội Nghề Nghiệp</a></li>
                        <li><a href="/Auth/Login" class="text-warning fw-bold"><i class="bi bi-shield-lock me-1"></i>Cổng Nội Bộ ERP</a></li>
                    </ul>
                </div>

                <div class="col-lg-4">
                    <h6 class="pf-footer-title">Hệ Thống Showroom</h6>
                    <ul class="pf-footer-links">
                        <li class="d-flex gap-2">
                            <i class="bi bi-geo-alt-fill text-warning mt-1"></i>
                            <span><strong>Flagship Sài Gòn:</strong> 88 Đồng Khởi, Bến Nghé, Quận 1, TP. Hồ Chí Minh</span>
                        </li>
                        <li class="d-flex gap-2 mt-2">
                            <i class="bi bi-geo-alt-fill text-warning mt-1"></i>
                            <span><strong>Boutique Hà Nội:</strong> 12 Tràng Tiền, Hoàn Kiếm, TP. Hà Nội</span>
                        </li>
                        <li class="d-flex gap-2 mt-2">
                            <i class="bi bi-telephone-fill text-warning mt-1"></i>
                            <span>Hotline CSKH: <strong>@hotline</strong> (08:30 - 22:00)</span>
                        </li>
                    </ul>

                    <div class="mt-4 p-3 rounded" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(212,175,55,0.2);">
                        <span class="text-warning small fw-bold text-uppercase d-block mb-1">Đăng ký nhận đặc quyền VIP</span>
                        <div class="input-group input-group-sm">
                            <input type="email" class="form-control bg-dark text-light border-secondary" placeholder="Nhập email của bạn...">
                            <button class="btn btn-warning fw-bold" type="button">Đăng ký</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-4 mt-5 border-top border-secondary d-flex flex-wrap justify-content-between align-items-center gap-2 small">
                <span>@copyright</span>
                <span class="text-secondary">Hệ thống ERP Bán hàng, Kho & Nhân sự tích hợp thời gian thực.</span>
            </div>
        </div>
    </footer>

    <!-- Toast Thông Báo Khi Thêm Nước Hoa Vào Giỏ Hàng -->
    <div id="pfCartToast" class="pf-toast">
        <div class="rounded-circle p-2" style="background: rgba(212,175,55,0.2); color: var(--pf-gold-light);">
            <i class="bi bi-check-circle-fill fs-4"></i>
        </div>
        <div>
            <strong class="d-block text-light" style="font-size: 0.95rem;">Đã thêm vào giỏ hàng thành công!</strong>
            <span id="pfToastProdName" class="text-secondary small">Tuyệt tác nước hoa đã sẵn sàng trong giỏ.</span>
        </div>
        <a href="/GioHang" class="btn btn-warning btn-sm fw-bold ms-2 px-3">Xem Giỏ</a>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Hàm hiển thị Toast thông báo thêm giỏ hàng
        function showPerfumeToast(productName) {
            var toast = document.getElementById('pfCartToast');
            var nameEl = document.getElementById('pfToastProdName');
            if (nameEl && productName) nameEl.textContent = productName;
            if (toast) {
                toast.style.display = 'flex';
                // Cập nhật số giỏ hàng
                var badge = document.getElementById('pfCartBadge');
                if (badge) {
                    var cur = parseInt(badge.textContent) || 0;
                    badge.textContent = cur + 1;
                    badge.classList.add('pf-pulse-node');
                }
                setTimeout(function() {
                    toast.style.display = 'none';
                }, 4000);
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
