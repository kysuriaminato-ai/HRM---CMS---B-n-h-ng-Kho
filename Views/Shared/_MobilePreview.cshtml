@{
    // Khung xem thử nạp trang bằng GET. Nếu trang hiện tại đến từ POST
    // (ví dụ /ThanhToan/DatHang) thì mở lại bằng GET sẽ trắng, nên lùi về trang chủ.
    var mpIsGet = string.Equals(Context.Request.Method, "GET", StringComparison.OrdinalIgnoreCase);
    var mpPath = mpIsGet
        ? (Context.Request.Path.Value ?? "/") + (Context.Request.QueryString.Value ?? string.Empty)
        : "/";
}
<style>
    /* Khung xem thử điện thoại — tự chứa để dùng được ở mọi layout */
    .pf-mobile-overlay { position: fixed; inset: 0; z-index: 2000; display: none;
        flex-direction: column; background: rgba(4,6,10,.96);
        backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
    .pf-mobile-overlay.is-open { display: flex; }
    .pf-mobile-toolbar { flex: 0 0 auto; display: flex; align-items: center;
        justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 12px 20px;
        background: rgba(10,13,19,.95); border-bottom: 1px solid rgba(212,175,55,.25); color: #f1f3f7; }
    .pf-mobile-stage { flex: 1 1 auto; display: flex; align-items: center;
        justify-content: center; overflow: auto; padding: 20px; }
    .pf-phone-frame { position: relative; flex: 0 0 auto; background: #0b0d13;
        border: 12px solid #1b1f28; border-radius: 42px;
        box-shadow: 0 30px 80px rgba(0,0,0,.75), 0 0 0 2px rgba(212,175,55,.3);
        overflow: hidden; transform-origin: center center; }
    .pf-phone-notch { position: absolute; top: 0; left: 50%; transform: translateX(-50%);
        width: 140px; height: 22px; background: #1b1f28;
        border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; z-index: 2; pointer-events: none; }
    .pf-phone-frame iframe { display: block; width: 100%; height: 100%; border: 0; background: #0b0d13; }
    .pf-mobile-overlay .pf-input { background-color: rgba(10,13,19,.85);
        border: 1px solid rgba(212,175,55,.28); color: #f1f3f7; border-radius: .25rem; padding: .25rem .5rem; }
    .pf-mobile-overlay .pf-input option { background-color: #10141c; color: #f1f3f7; }
    .pf-mobile-overlay .btn-outline-gold { color: #f7e8bd; border: 1px solid rgba(212,175,55,.45); background: transparent; }
    .pf-mobile-overlay .btn-outline-gold:hover { background: rgba(212,175,55,.15); color: #fff; }
</style>

<!-- ==========================================================================
     KHUNG XEM THỬ GIAO DIỆN ĐIỆN THOẠI
     ========================================================================== -->
<div id="mobilePreviewOverlay" class="pf-mobile-overlay" role="dialog" aria-modal="true" aria-label="Xem thử giao diện điện thoại">
    <div class="pf-mobile-toolbar">
        <span class="text-warning fw-semibold"><i class="bi bi-phone me-2"></i>Giao diện điện thoại</span>
        <div class="d-flex align-items-center gap-2">
            <select id="mobilePreviewDevice" class="form-select form-select-sm pf-input" style="width: auto;">
                <option value="390x844">iPhone 14 — 390 × 844</option>
                <option value="360x800">Android — 360 × 800</option>
                <option value="430x932">iPhone Pro Max — 430 × 932</option>
                <option value="768x1024">iPad — 768 × 1024</option>
            </select>
            <button type="button" id="mobilePreviewReload" class="btn btn-sm btn-outline-gold" title="Tải lại">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
            <button type="button" id="mobilePreviewClose" class="btn btn-sm btn-outline-light" title="Đóng">
                <i class="bi bi-x-lg"></i> Đóng
            </button>
        </div>
    </div>

    <div class="pf-mobile-stage">
        <div class="pf-phone-frame" id="mobilePhoneFrame">
            <div class="pf-phone-notch"></div>
            <iframe id="mobilePreviewFrame" title="Xem thử giao diện điện thoại" src="about:blank"></iframe>
        </div>
    </div>
</div>

<script>
(function () {
    'use strict';
    var btn = document.getElementById('btnMobilePreview');
    var overlay = document.getElementById('mobilePreviewOverlay');
    if (!btn || !overlay) { return; }

    // Đang nằm trong khung xem thử thì ẩn nút để không lồng nhau
    if (window.self !== window.top) {
        btn.remove();
        overlay.remove();
        return;
    }

    var frame = document.getElementById('mobilePreviewFrame');
    var phone = document.getElementById('mobilePhoneFrame');
    var sel = document.getElementById('mobilePreviewDevice');

    // Địa chỉ do máy chủ tính sẵn, luôn mở được bằng GET
    var basePath = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mpPath));

    function targetUrl() {
        var u = new URL(basePath, window.location.origin);
        u.searchParams.set('mobilepreview', '1');
        return u.toString();
    }

    function fitScale() {
        var parts = sel.value.split('x');
        var w = parseInt(parts[0], 10);
        var h = parseInt(parts[1], 10);
        phone.style.width = w + 'px';
        phone.style.height = h + 'px';

        // Thu nhỏ vừa màn hình nếu khung cao hơn vùng hiển thị
        var avail = window.innerHeight - 130;
        var scale = Math.min(1, avail / (h + 24));
        phone.style.transform = 'scale(' + scale + ')';
    }

    function open() {
        frame.src = targetUrl();
        overlay.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        fitScale();
    }

    function close() {
        overlay.classList.remove('is-open');
        document.body.style.overflow = '';
        frame.src = 'about:blank';
    }

    btn.addEventListener('click', open);
    document.getElementById('mobilePreviewClose').addEventListener('click', close);
    document.getElementById('mobilePreviewReload').addEventListener('click', function () { frame.src = targetUrl(); });
    sel.addEventListener('change', fitScale);
    window.addEventListener('resize', function () { if (overlay.classList.contains('is-open')) { fitScale(); } });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && overlay.classList.contains('is-open')) { close(); }
    });
})();
</script>
