@model ERP_HRM_CMS.Models.ErrorViewModel
@{
    Layout = null;
    var vm = Model ?? new ERP_HRM_CMS.Models.ErrorViewModel();
    vm.StatusCode = vm.StatusCode < 400 ? 500 : vm.StatusCode;
    vm.Variant ??= "warning";
    vm.IconClass ??= "bi-exclamation-triangle-fill";
    vm.Title ??= "Đã xảy ra lỗi hệ thống";
}
<partial name="~/Views/Shared/UI/_ErrorDocument.cshtml" model="vm" />

