@model List<ERP_HRM_CMS.Models.Entities.Menu>
@inject ERP_HRM_CMS.Data.AppDbContext Db
@{ var siteName = ERP_HRM_CMS.Helpers.SiteSettingReader.Get(Db, "Site_Name", "ERP"); }

<nav class="navbar navbar-expand-lg bg-white border-bottom border-light sticky-top shadow-sm py-3">
    <div class="container">
        <a class="navbar-brand fw-bold text-dark fs-4" href="/">
            <i class="bi bi-triangle-half me-1"></i> @siteName
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-1">
                @foreach (var menu in Model)
                {
                    if (menu.SubMenus != null && menu.SubMenus.Any())
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark fw-semibold px-3" href="#" role="button" data-bs-toggle="dropdown">
                                @if (!string.IsNullOrEmpty(menu.IconClass))
                                {
                                    <i class="@menu.IconClass me-1"></i>
                                }
                                @menu.Title
                            </a>
                            <ul class="dropdown-menu border-0 shadow-sm mt-2">
                                @foreach (var sub in menu.SubMenus)
                                {
                                    <li>
                                        <a class="dropdown-item py-2 small fw-medium" href="@sub.CustomUrl" target="@sub.Target">
                                            @if (!string.IsNullOrEmpty(sub.IconClass))
                                            {
                                                <i class="@sub.IconClass me-1"></i>
                                            }
                                            @sub.Title
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold px-3" href="@menu.CustomUrl" target="@menu.Target">
                                @if (!string.IsNullOrEmpty(menu.IconClass))
                                {
                                    <i class="@menu.IconClass me-1"></i>
                                }
                                @menu.Title
                            </a>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
</nav>