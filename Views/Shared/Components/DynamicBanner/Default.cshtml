@model List<ERP_HRM_CMS.Models.Entities.Banner>

@if (Model != null && Model.Any())
{
    <div id="erpMainCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (int i = 0; i < Model.Count; i++)
            {
                var banner = Model[i];
                <div class="carousel-item @(i == 0 ? "active" : "")" style="max-height: 480px; background-color: #111;">
                    <img src="@banner.ImageUrl" class="d-block w-100 object-fit-cover" style="height: 480px; opacity: 0.85;" alt="@banner.Title" />
                    <div class="carousel-caption text-center d-none d-md-block p-0" style="top: 50%; bottom: auto; left: 10%; right: 10%;">
                        <h2 class="fs-3 fw-semibold text-white mb-1">@banner.Title</h2>
                        @if (!string.IsNullOrEmpty(banner.SubTitle))
                        {
                            <p class="fs-5 text-light mb-3">@banner.SubTitle</p>
                        }
                        @if (!string.IsNullOrEmpty(banner.LinkUrl))
                        {
                            <a href="@banner.LinkUrl" class="btn btn-erp-black px-4 py-2 border-white">Xem Chi Tiết</a>
                        }
                    </div>
                </div>
            }
        </div>
        @if (Model.Count > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#erpMainCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#erpMainCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        }
    </div>
}
