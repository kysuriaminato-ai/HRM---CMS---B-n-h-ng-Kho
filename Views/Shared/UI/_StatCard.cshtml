@model StatCardModel
<erp-stat-card label="@Model.Label"
               value="@Model.Value"
               count-up-target="@Model.NumericTarget"
               prefix="@Model.Prefix"
               suffix="@Model.Suffix"
               decimals="@Model.Decimals"
               trend="@Model.Trend"
               trend-dir="@Model.TrendDirection"
               icon="@Model.Icon"
               variant="@Model.Variant" />

