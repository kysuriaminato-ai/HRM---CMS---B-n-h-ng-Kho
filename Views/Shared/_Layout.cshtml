@inject ERP_HRM_CMS.Data.AppDbContext Db
@{
    var brand = ERP_HRM_CMS.Helpers.SiteSettingReader.Get(Db, "Site_Short_Name", "ERP");
    var fullName = Context.Session.GetString("FullName") ?? User.Identity?.Name ?? "Quản trị viên";
    var avatarInitial = !string.IsNullOrEmpty(fullName) ? fullName[0].ToString().ToUpper() : "Q";
    var isAuth = User.Identity?.IsAuthenticated ?? false;
    var isSuperAdmin = User.IsInRole("SUPERADMIN") || string.Equals(User.FindFirst("IsSuperAdmin")?.Value, "True", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @brand</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/enterprise-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-animations.css" asp-append-version="true" />
    @* Chống nhấp nháy: áp dụng theme trước khi render *@
    <script>
        (function () {
            var m = document.cookie.match(/(^| )erp_theme=([^;]+)/);
            var t = localStorage.getItem('erp_theme') || (m ? m[2] : null);
            if (!t) { t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
            document.documentElement.setAttribute('data-bs-theme', t);
            if (t === 'dark') document.documentElement.classList.add('dark-mode');
            // Sidebar thu gọn
            if (localStorage.getItem('erp_sidebar_collapsed') === 'true') document.documentElement.classList.add('sidebar-collapsed');
        })();
    </script>
</head>
<body class="bg-body">

@if (isAuth)
{
    @* ═══════════════════════════════════════════════════════════════════
       SIDEBAR - Thu gọn được (toggle qua nút hoặc responsive)
       ═══════════════════════════════════════════════════════════════════ *@
    <aside class="erp-sidebar" id="erpSidebar">
        @* Logo & Brand *@
        <div class="erp-sidebar-brand">
            <div class="sidebar-brand-full">
                <i class="bi bi-layers-half fs-4 text-primary"></i>
                <span class="brand-text">@brand</span>
            </div>
            <div class="sidebar-brand-mini">
                <i class="bi bi-layers-half fs-4 text-primary"></i>
            </div>
        </div>

        @* Menu chính *@
        <nav class="erp-sidebar-nav" id="sidebarNav">
            @* — Tổng quan — *@
            <div class="nav-section-title">Tổng quan</div>
            <a href="/" class="erp-nav-item" data-path="/">
                <i class="bi bi-grid-1x2"></i>
                <span class="nav-label">Dashboard</span>
            </a>

            @* — Nhân sự — *@
            <div class="nav-section-title">Nhân sự</div>
            <a href="/NhanSu/Index" class="erp-nav-item" data-path="/NhanSu">
                <i class="bi bi-person-badge"></i>
                <span class="nav-label">Nhân sự</span>
            </a>
            <a href="/PhongBan/Index" class="erp-nav-item" data-path="/PhongBan">
                <i class="bi bi-diagram-3"></i>
                <span class="nav-label">Phòng ban</span>
            </a>
            <a href="/HopDong/Index" class="erp-nav-item" data-path="/HopDong">
                <i class="bi bi-file-earmark-text"></i>
                <span class="nav-label">Hợp đồng</span>
            </a>
            <a href="/ChamCong/Index" class="erp-nav-item" data-path="/ChamCong">
                <i class="bi bi-calendar2-check"></i>
                <span class="nav-label">Chấm công</span>
            </a>
            <a href="/DonTu/Index" class="erp-nav-item" data-path="/DonTu">
                <i class="bi bi-file-earmark-check"></i>
                <span class="nav-label">Đơn từ</span>
            </a>
            <a href="/BangLuong/Index" class="erp-nav-item" data-path="/BangLuong">
                <i class="bi bi-cash-stack"></i>
                <span class="nav-label">Bảng lương</span>
            </a>

            @* — Bán hàng & Kho — *@
            <div class="nav-section-title">Bán hàng & Kho</div>
            <a href="/BanHang/POS" class="erp-nav-item" data-path="/BanHang">
                <i class="bi bi-cart3"></i>
                <span class="nav-label">POS bán hàng</span>
            </a>
            <a href="/DonHang/Index" class="erp-nav-item" data-path="/DonHang">
                <i class="bi bi-receipt"></i>
                <span class="nav-label">Đơn hàng</span>
            </a>
            <a href="/SanPham/Index" class="erp-nav-item" data-path="/SanPham">
                <i class="bi bi-box-seam"></i>
                <span class="nav-label">Sản phẩm</span>
            </a>
            <a href="/Kho/Index" class="erp-nav-item" data-path="/Kho">
                <i class="bi bi-building"></i>
                <span class="nav-label">Kho hàng</span>
            </a>
            <a href="/PurchaseOrder/Index" class="erp-nav-item" data-path="/PurchaseOrder">
                <i class="bi bi-truck"></i>
                <span class="nav-label">Mua hàng (PO)</span>
            </a>
            <a href="/CongNo/Index" class="erp-nav-item" data-path="/CongNo">
                <i class="bi bi-cash-coin"></i>
                <span class="nav-label">Công nợ</span>
            </a>

            @* — CMS — *@
            <div class="nav-section-title">Nội dung</div>
            <a href="/Content/Index" class="erp-nav-item" data-path="/Content">
                <i class="bi bi-newspaper"></i>
                <span class="nav-label">Bài viết</span>
            </a>
            <a href="/Menu/Index" class="erp-nav-item" data-path="/Menu">
                <i class="bi bi-list-stars"></i>
                <span class="nav-label">Menu</span>
            </a>

            @* — Hệ thống — *@
            <div class="nav-section-title">Hệ thống</div>
            <a href="/PhanQuyen/MaTranPhanQuyen" class="erp-nav-item" data-path="/PhanQuyen">
                <i class="bi bi-shield-lock"></i>
                <span class="nav-label">Phân quyền</span>
            </a>
            @if (isSuperAdmin)
            {
                <a href="/QuanTriTaiKhoan/Index" class="erp-nav-item" data-path="/QuanTriTaiKhoan">
                    <i class="bi bi-people"></i>
                    <span class="nav-label">Tài khoản</span>
                </a>
                <a href="/VaiTro/Index" class="erp-nav-item" data-path="/VaiTro">
                    <i class="bi bi-diagram-3"></i>
                    <span class="nav-label">Nhóm quyền</span>
                </a>
            }
            <a href="/AuditLog/Index" class="erp-nav-item" data-path="/AuditLog">
                <i class="bi bi-shield-check"></i>
                <span class="nav-label">Audit Trail</span>
            </a>
            <a href="/Notification/Index" class="erp-nav-item" data-path="/Notification">
                <i class="bi bi-bell"></i>
                <span class="nav-label">Thông báo</span>
            </a>
        </nav>

        @* Nút thu gọn sidebar (ở đáy) *@
        <div class="erp-sidebar-footer">
            <button type="button" class="erp-sidebar-toggle" id="sidebarCollapseBtn" title="Thu gọn / Mở rộng">
                <i class="bi bi-chevron-bar-left" id="sidebarToggleIcon"></i>
            </button>
        </div>
    </aside>

    @* ═══════════════════════════════════════════════════════════════════
       MAIN CONTENT (Topbar + Breadcrumb + Body)
       ═══════════════════════════════════════════════════════════════════ *@
    <div class="erp-main-content" id="erpMainContent">

        @* — Topbar — *@
        <header class="erp-topbar" id="erpTopbar">
            <div class="topbar-left">
                @* Nút mở sidebar trên mobile *@
                <button type="button" class="erp-sidebar-mobile-toggle d-lg-none" id="sidebarMobileBtn" aria-label="Mở menu">
                    <i class="bi bi-list fs-4"></i>
                </button>
                @* Breadcrumb *@
                <nav aria-label="breadcrumb" class="d-none d-md-block">
                    <ol class="breadcrumb mb-0 small">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none"><i class="bi bi-house-door"></i></a></li>
                        @if (ViewData["BreadcrumbSection"] != null)
                        {
                            <li class="breadcrumb-item">@ViewData["BreadcrumbSection"]</li>
                        }
                        @if (ViewData["Title"] != null)
                        {
                            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                        }
                    </ol>
                </nav>
            </div>
            <div class="topbar-right">
                @* Tìm kiếm nhanh *@
                <button type="button" class="command-palette-trigger" onclick="window.openCommandPalette()" title="Tìm kiếm nhanh (Ctrl + K)">
                    <i class="bi bi-search"></i>
                    <span class="d-none d-xl-inline">Tìm kiếm...</span>
                    <kbd class="d-none d-lg-inline">Ctrl K</kbd>
                </button>

                @* Dark / Light *@
                <button type="button" class="topbar-icon-btn" onclick="window.toggleTheme()" title="Sáng / Tối">
                    <i class="bi bi-moon-stars-fill theme-toggle-icon"></i>
                </button>

                @* Thông báo *@
                <div class="dropdown">
                    <button class="topbar-icon-btn position-relative" type="button" id="notifDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Thông báo">
                        <i class="bi bi-bell"></i>
                        <span id="notificationBadge" class="notif-badge" style="display:none;">0</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0" aria-labelledby="notifDropdownBtn" style="width:360px; max-height:480px;">
                        <div class="p-3 d-flex justify-content-between align-items-center" style="background:var(--erp-bg-sidebar); color:#fff;">
                            <span class="fw-bold small"><i class="bi bi-bell-fill me-2 text-warning"></i>Thông báo</span>
                            <a href="javascript:void(0)" class="text-white-50 small text-decoration-none"
                               onclick="fetch('/Notification/MarkAllAsRead',{method:'POST'}).then(()=>window.refreshNotificationDropdown())">Đã đọc hết</a>
                        </div>
                        <div id="notificationDropdownList" style="max-height:340px; overflow-y:auto;">
                            <div class="text-center py-4 text-muted small"><i class="bi bi-arrow-repeat spin d-block mb-1"></i>Đang tải...</div>
                        </div>
                        <div class="p-2 text-center border-top">
                            <a href="/Notification/Index" class="small fw-semibold text-decoration-none text-primary">Xem tất cả &rarr;</a>
                        </div>
                    </div>
                </div>

                @* Avatar & tên *@
                <div class="dropdown">
                    <button class="topbar-avatar-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar-circle">@avatarInitial</span>
                        <span class="d-none d-lg-inline avatar-name">@fullName</span>
                        <i class="bi bi-chevron-down small d-none d-lg-inline"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg">
                        <li><a class="dropdown-item small" href="/" target="_blank"><i class="bi bi-globe me-2"></i>Trang công khai</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item small text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        @* — Thông báo hệ thống (TempData) — *@
        <div class="erp-content-wrapper">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="erp-toast-alert erp-toast-success fade-in" role="alert">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["SuccessMessage"]</span>
                    <button type="button" class="btn-close btn-close-sm" onclick="this.parentElement.remove()"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="erp-toast-alert erp-toast-danger fade-in" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@TempData["ErrorMessage"]</span>
                    <button type="button" class="btn-close btn-close-sm" onclick="this.parentElement.remove()"></button>
                </div>
            }

            @* — Nội dung chính — *@
            <main class="erp-page-content fade-in">
                @RenderBody()
            </main>
        </div>

        @* Footer *@
        <footer class="erp-footer">
            &copy; @ERP_HRM_CMS.Helpers.VietnamTime.Now.Year @brand &mdash; Hệ thống quản trị doanh nghiệp
        </footer>
    </div>

    @* Overlay khi sidebar mở trên mobile *@
    <div class="erp-sidebar-overlay" id="sidebarOverlay"></div>
}
else
{
    @* Layout cho trang chưa đăng nhập (login, register) *@
    <main class="container-fluid px-4 py-4">
        @RenderBody()
    </main>
}

@* ═══════ Scripts ═══════ *@
<script src="~/js/security.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@if (isAuth)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/enterprise-notifications.js" asp-append-version="true"></script>
}
<script src="~/js/enterprise-theme.js" asp-append-version="true"></script>
<script src="~/js/admin-ui.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
