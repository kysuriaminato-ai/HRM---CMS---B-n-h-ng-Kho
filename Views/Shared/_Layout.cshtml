@inject ERP_HRM_CMS.Data.AppDbContext Db
@{ var brand = ERP_HRM_CMS.Helpers.SiteSettingReader.Get(Db, "Site_Short_Name", "ERP"); }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ERP_HRM_CMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/enterprise-theme.css" asp-append-version="true" />
    <script>
        (function() {
            const match = document.cookie.match(/(^| )erp_theme=([^;]+)/);
            const savedTheme = localStorage.getItem('erp_theme') || (match ? match[2] : null) || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
            if (savedTheme === 'dark') {
                document.documentElement.classList.add('dark-mode');
            }
        })();
    </script>
</head>
<body class="bg-body">
    @{
        var fullName = Context.Session.GetString("FullName") ?? User.Identity?.Name ?? "Quản trị viên";
        var isAuth = User.Identity?.IsAuthenticated ?? false;
    }

    <!-- Topbar Navigation -->
    <header class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm py-2">
        <div class="container-fluid px-3">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
                <i class="bi bi-layers-half text-primary fs-4"></i>
                <span>@brand</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                @if (isAuth)
                {
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="/PhanQuyen/MaTranPhanQuyen"><i class="bi bi-shield-lock me-1"></i> Phân Quyền</a>
                        </li>
                        @if (User.IsInRole("SUPERADMIN") || string.Equals(User.FindFirst("IsSuperAdmin")?.Value, "True", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/QuanTriTaiKhoan/Index"><i class="bi bi-people me-1"></i> Tài khoản</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/VaiTro/Index"><i class="bi bi-diagram-3 me-1"></i> Nhóm quyền</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" href="/NhanSu/Index"><i class="bi bi-people me-1"></i> Nhân Sự (HRM)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/DonTu/Index"><i class="bi bi-file-earmark-check me-1"></i> Đơn Từ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/ChamCong/Index"><i class="bi bi-calendar2-check me-1"></i> Chấm Công</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/BangLuong/Index"><i class="bi bi-cash-stack me-1"></i> Bảng Lương</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/BanHang/POS"><i class="bi bi-cart3 me-1"></i> Bán Hàng & POS</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Kho/Index"><i class="bi bi-box-seam me-1"></i> Quản Lý Kho</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/PurchaseOrder/Index"><i class="bi bi-truck me-1"></i> Mua Hàng PO</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/CongNo/Index"><i class="bi bi-cash-coin me-1"></i> Công Nợ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Content/Index"><i class="bi bi-newspaper me-1"></i> CMS Bài Viết</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Menu/Index"><i class="bi bi-list-stars me-1"></i> CMS Menu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning" href="/AuditLog/Index"><i class="bi bi-shield-check me-1"></i> Audit Trail</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <!-- Quick Command Palette Trigger (Ctrl + K) -->
                        <button type="button" class="command-palette-trigger border-0 me-1" onclick="window.openCommandPalette()" title="Tìm kiếm nhanh toàn hệ thống (Ctrl + K)">
                            <i class="bi bi-search text-muted"></i>
                            <span class="d-none d-xl-inline text-muted small">Tìm kiếm...</span>
                            <kbd class="ms-1 d-none d-md-inline">Ctrl K</kbd>
                        </button>

                        <!-- Nút Chuyển đổi Dark / Light Mode -->
                        <button type="button" class="btn btn-sm btn-outline-light border-0 py-1 px-2" onclick="window.toggleTheme()" title="Chuyển đổi Chế độ Sáng / Tối">
                            <i class="bi bi-moon-stars-fill theme-toggle-icon fs-5"></i>
                        </button>

                        <!-- Chuông thông báo Real-time -->
                        <div class="dropdown">
                            <button class="btn btn-outline-light btn-sm position-relative py-1 px-2 border-0" type="button" id="notifDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Thông báo hệ thống">
                                <i class="bi bi-bell fs-5"></i>
                                <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none; font-size: 10px;">0</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0" aria-labelledby="notifDropdownBtn" style="width: 340px; max-height: 460px;">
                                <div class="p-3 bg-dark text-white rounded-top d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0 fw-bold fs-6"><i class="bi bi-bell-fill me-2 text-warning"></i>Thông Báo Real-time</h6>
                                    <a href="javascript:void(0)" class="text-white-50 small text-decoration-none" onclick="fetch('/Notification/MarkAllAsRead', {method:'POST'}).then(() => window.refreshNotificationDropdown())">Đã đọc hết</a>
                                </div>
                                <div id="notificationDropdownList" style="max-height: 320px; overflow-y: auto;">
                                    <div class="text-center py-4 text-muted small"><i class="bi bi-arrow-repeat spin d-block mb-1"></i>Đang tải...</div>
                                </div>
                                <div class="p-2 text-center bg-light rounded-bottom border-top">
                                    <a href="/Notification/Index" class="small fw-semibold text-decoration-none text-primary">Xem tất cả thông báo &rarr;</a>
                                </div>
                            </div>
                        </div>

                        <span class="text-light small"><i class="bi bi-person-circle me-1"></i> @fullName</span>
                        <a href="/" target="_blank" class="btn btn-sm btn-outline-light" title="Xem trang chủ công khai"><i class="bi bi-globe"></i> Trang Public</a>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2"><i class="bi bi-box-arrow-right me-1"></i> Đăng xuất</button>
                        </form>
                    </div>
                }
                else
                {
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-2">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Trang Chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-sm btn-primary px-3" href="/Auth/Login"><i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập</a>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </header>

    <!-- Global Alerts for Feedback Messages -->
    <div class="container-fluid px-4 pt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center py-2 px-3 mb-3" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <div class="small fw-semibold">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center py-2 px-3 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <div class="small fw-semibold">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Content Body -->
    <main class="container-fluid px-4 py-2">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="border-top bg-white py-3 text-center text-muted small mt-5">
        <div class="container">
            &copy; @ERP_HRM_CMS.Helpers.VietnamTime.Now.Year - Hệ Thống ERP_HRM_CMS Doanh Nghiệp Toàn Diện
        </div>
    </footer>

    <script src="~/js/security.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/enterprise-notifications.js"></script>
    <script src="~/js/enterprise-theme.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
