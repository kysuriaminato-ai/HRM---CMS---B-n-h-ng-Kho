@inject ERP_HRM_CMS.Data.AppDbContext Db
@inject ERP_HRM_CMS.Helpers.IPermissionService PermService
@{
    var brand = ERP_HRM_CMS.Helpers.SiteSettingReader.Get(Db, "Site_Short_Name", "ERP");
    var fullName = Context.Session.GetString("FullName") ?? User.Identity?.Name ?? "Quản trị viên";
    var isAuth = User.Identity?.IsAuthenticated ?? false;
    var isSuperAdmin = User.IsInRole("SUPERADMIN")
        || User.IsInRole("SuperAdmin")
        || string.Equals(User.FindFirst("IsSuperAdmin")?.Value, "True", StringComparison.OrdinalIgnoreCase);

    int currentUserId = int.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out int uid) ? uid : 0;
    var userPerms = (isAuth && !isSuperAdmin && currentUserId > 0)
        ? (await PermService.GetEffectivePermissionsAsync(currentUserId)).ToHashSet(StringComparer.OrdinalIgnoreCase)
        : new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    bool CanView(params string[] codes)
    {
        if (isSuperAdmin) return true;
        if (!isAuth) return false;
        if (codes == null || codes.Length == 0) return true;
        return codes.Any(c => userPerms.Contains(c));
    }

    bool showHrm = isSuperAdmin || CanView("hrm.employee.view", "hrm.employee.manage", "hrm.attendance.view", "hrm.attendance.manage", "hrm.leave.view", "hrm.leave.approve", "report.hrm");
    bool showPayroll = isSuperAdmin || CanView("hrm.payroll.view", "hrm.payroll.manage");
    bool showSales = isSuperAdmin || CanView("order.pos", "order.view", "order.manage", "product.view", "product.manage", "debt.view", "report.sales");
    bool showWarehouse = isSuperAdmin || CanView("inventory.view", "inventory.transaction", "inventory.stocktaking", "scm.po.view", "scm.po.manage", "scm.supplier.view", "scm.supplier.manage");
    bool showCms = isSuperAdmin || CanView("content.view", "content.create", "menu.view", "layout.manage");
    bool showSystem = isSuperAdmin || CanView("auth.matrix.view", "auth.user.manage");

    var controllerName = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var rawModule = ViewData["Module"]?.ToString()?.Trim().ToLowerInvariant();
    var module = rawModule switch
    {
        "hrm" or "payroll" or "sales" or "warehouse" or "cms" or "system" => rawModule,
        _ => controllerName switch
        {
            "nhansu" or "phongban" or "hopdong" or "chamcong" or "dontu" or "tuyendung" or "danhgiakpi" or "daotao" or "quyetdinhnhansu" or "taisannhansu" => "hrm",
            "bangluong" => "payroll",
            "banhang" or "donhang" or "sanpham" or "danhmuc" or "congno" or "giohang" => "sales",
            "kho" or "purchaseorder" or "supplier" => "warehouse",
            "content" or "menu" or "layoutconfig" => "cms",
            _ => "system"
        }
    };

    var (moduleLabel, moduleIcon) = module switch
    {
        "hrm"       => ("Nhân sự & Chấm công", "bi-people-fill"),
        "payroll"   => ("Tiền lương & Phúc lợi", "bi-cash-stack"),
        "sales"     => ("Bán hàng & POS", "bi-bag-check-fill"),
        "warehouse" => ("Kho vận & Mua hàng", "bi-box-seam-fill"),
        "cms"       => ("Nội dung CMS", "bi-newspaper"),
        _           => ("Hệ thống & Tổng quan", "bi-layers-half")
    };

    var breadcrumbSection = ViewData["BreadcrumbSection"]?.ToString() ?? moduleLabel;
}
<!DOCTYPE html>
<html lang="vi" data-module="@module">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="view-transition" content="same-origin" />
    <title>@ViewData["Title"] - @brand</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/enterprise-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hrm-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-print.css" asp-append-version="true" media="print" />
    @await RenderSectionAsync("Styles", required: false)
    <script>
        (function () {
            var m = document.cookie.match(/(^| )erp_theme=([^;]+)/);
            var t = localStorage.getItem('erp_theme') || (m ? decodeURIComponent(m[2]) : null);
            if (!t) { t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
            document.documentElement.setAttribute('data-bs-theme', t);
            if (t === 'dark') document.documentElement.classList.add('dark-mode');
            if (localStorage.getItem('erp_sidebar_collapsed') === 'true') document.documentElement.classList.add('sidebar-collapsed');

            var den = localStorage.getItem('erp_density');
            if (den === 'compact') {
                document.documentElement.setAttribute('data-density', 'compact');
                document.documentElement.classList.add('density-compact');
            } else {
                document.documentElement.setAttribute('data-density', 'comfortable');
            }
        })();
    </script>
</head>
