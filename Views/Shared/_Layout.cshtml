                                <span class="nav-label">Thông báo</span>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </nav>

        <div class="erp-sidebar-footer">
            <button type="button" class="erp-sidebar-toggle" id="sidebarCollapseBtn" title="Thu gọn / Mở rộng thanh bên" aria-label="Thu gọn hoặc mở rộng thanh bên">
                <i class="bi bi-chevron-bar-left" id="sidebarToggleIcon"></i>
            </button>
        </div>
    </aside>

    <div class="erp-main-content" id="erpMainContent">
        <header class="erp-topbar" id="erpTopbar">
            <div class="topbar-left">
                <button type="button" class="erp-sidebar-mobile-toggle d-lg-none" id="sidebarMobileBtn" aria-label="Mở menu">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <span class="erp-module-pill d-none d-sm-inline-flex">
                    <i class="bi @moduleIcon"></i>
                    <span>@moduleLabel</span>
                </span>
                <nav aria-label="breadcrumb" class="d-none d-md-block">
                    <ol class="breadcrumb mb-0 small">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none"><i class="bi bi-house-door"></i></a></li>
                        @if (!string.IsNullOrWhiteSpace(breadcrumbSection))
                        {
                            <li class="breadcrumb-item">@breadcrumbSection</li>
                        }
                        @if (ViewData["Title"] != null)
                        {
                            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                        }
                    </ol>
                </nav>
            </div>
            <div class="topbar-right">
                <button type="button" class="command-palette-trigger" onclick="window.openCommandPalette()" title="Tìm kiếm nhanh (Ctrl + K)">
                    <i class="bi bi-search"></i>
                    <span class="d-none d-xl-inline">Tìm kiếm...</span>
                    <kbd class="d-none d-lg-inline">Ctrl K</kbd>
                </button>

                <button type="button" class="topbar-icon-btn density-toggle-btn" id="densityToggleBtn" onclick="window.toggleDensity()" title="Độ giãn cách: Thoải mái / Thu gọn" aria-label="Chuyển đổi độ giãn cách bảng biểu">
                    <i class="bi bi-arrows-expand density-toggle-icon"></i>
                </button>

                <button type="button" class="topbar-icon-btn" id="themeToggleBtn" onclick="window.toggleTheme(event)" title="Chế độ Sáng / Tối" aria-label="Chuyển đổi chế độ Sáng hoặc Tối">
                    <i class="bi bi-moon-stars-fill theme-toggle-icon"></i>
                </button>

                <div class="dropdown">
                    <button class="topbar-icon-btn position-relative" type="button" id="notifDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Thông báo" aria-label="Thông báo">
                        <i class="bi bi-bell"></i>
                        <span id="notificationBadge" class="notif-badge">0</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0 erp-notif-dropdown" aria-labelledby="notifDropdownBtn">
                        <div class="p-3 d-flex justify-content-between align-items-center erp-notif-dropdown-header">
                            <span class="fw-bold small"><i class="bi bi-bell-fill me-2 text-warning"></i>Thông báo</span>
                            <a href="javascript:void(0)" class="text-white-50 small text-decoration-none"
                               onclick="fetch('/Notification/MarkAllAsRead',{method:'POST'}).then(()=>window.refreshNotificationDropdown && window.refreshNotificationDropdown())">Đã đọc hết</a>
                        </div>
                        <div id="notificationDropdownList" class="erp-notif-dropdown-list">
                            <div class="text-center py-4 text-muted small"><i class="bi bi-arrow-repeat spin d-block mb-1"></i>Đang tải...</div>
                        </div>
                        <div class="p-2 text-center border-top">
                            <a href="/Notification/Index" class="small fw-semibold text-decoration-none text-primary">Xem tất cả &rarr;</a>
                        </div>
                    </div>
                </div>

                <div class="dropdown">
                    <button class="topbar-avatar-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <erp-avatar name="@fullName" size="sm" status="online" />
                        <span class="d-none d-lg-inline avatar-name">@fullName</span>
                        <i class="bi bi-chevron-down small d-none d-lg-inline"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg">
                        <li><a class="dropdown-item small" href="/CongNhanVien"><i class="bi bi-person-workspace me-2 text-primary"></i>Cổng tự phục vụ (ESS)</a></li>
                        <li><a class="dropdown-item small" href="/Auth/ChangePassword"><i class="bi bi-key-fill me-2"></i>Đổi mật khẩu cá nhân</a></li>
                        <li><a class="dropdown-item small" href="/Public/TinTuc" target="_blank"><i class="bi bi-globe me-2"></i>Cổng thông tin công khai</a></li>
                        @if (isSuperAdmin)
                        {
                            <li><a class="dropdown-item small" href="/UI/Styleguide"><i class="bi bi-palette2 me-2"></i>UI Styleguide</a></li>
                        }
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item small text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <div id="erpToastContainer" class="erp-toast-container" aria-live="polite">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="erp-toast-alert erp-toast-success" role="alert">
                    <i class="bi bi-check-circle-fill"></i>
                    <span class="flex-grow-1">@TempData["SuccessMessage"]</span>
                    <button type="button" class="btn-close btn-close-sm" aria-label="Đóng"></button>
                    <div class="erp-toast-progress"></div>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="erp-toast-alert erp-toast-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span class="flex-grow-1">@TempData["ErrorMessage"]</span>
                    <button type="button" class="btn-close btn-close-sm" aria-label="Đóng"></button>
                    <div class="erp-toast-progress"></div>
                </div>
            }
        </div>

        <div class="erp-content-wrapper">
            <main class="erp-page-content fade-in">
                @RenderBody()
            </main>
        </div>

        <footer class="erp-footer">
            &copy; @ERP_HRM_CMS.Helpers.VietnamTime.Now.Year @brand &mdash; Hệ thống quản trị doanh nghiệp hợp nhất
        </footer>
    </div>

    <div class="erp-sidebar-overlay" id="sidebarOverlay"></div>
}
else
{
    <main class="container-fluid px-4 py-4">
        @RenderBody()
    </main>
}

<script src="~/js/security.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@if (isAuth)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/enterprise-notifications.js" asp-append-version="true"></script>
}
<script src="~/js/enterprise-theme.js" asp-append-version="true"></script>
<script src="~/js/admin-ui.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
