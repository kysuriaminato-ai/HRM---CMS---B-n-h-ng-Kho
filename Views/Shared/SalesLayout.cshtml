@{
    var fullName = Context.Session.GetString("FullName") ?? User.Identity?.Name ?? "Kinh Doanh";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Phân Hệ Bán Hàng & POS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <div class="erp-sidebar">
        <div class="erp-sidebar-brand text-dark">
            <i class="bi bi-bag-check-fill fs-5 text-success"></i> BÁN HÀNG & POS
        </div>
        <div class="py-3">
            <div class="px-3 pb-2 text-uppercase text-muted small fw-bold" style="font-size: 11px;">Giao Dịch Bán Hàng</div>
            <a href="/BanHang/POS" class="erp-nav-item"><i class="bi bi-cash-coin"></i> Thu Ngân & Điểm Bán POS</a>
            <a href="/DonHang/Index" class="erp-nav-item"><i class="bi bi-receipt"></i> Tra Cứu Đơn Hàng</a>
            <a href="/DonHang/BaoCaoDoanhSo" class="erp-nav-item"><i class="bi bi-graph-up-arrow"></i> Báo Cáo Doanh Thu</a>

            <div class="px-3 pt-3 pb-2 text-uppercase text-muted small fw-bold" style="font-size: 11px;">Hàng Hóa & Danh Mục</div>
            <a href="/SanPham/Index" class="erp-nav-item"><i class="bi bi-tags"></i> Danh Sách Sản Phẩm</a>
            <a href="/DanhMuc/Index" class="erp-nav-item"><i class="bi bi-diagram-2"></i> Danh Mục Ngành Hàng</a>

            <div class="px-3 pt-3 pb-2 text-uppercase text-muted small fw-bold" style="font-size: 11px;">Phân hệ khác</div>
            <a href="/Kho/Index" class="erp-nav-item"><i class="bi bi-box-seam"></i> Tồn Kho Thực Tế</a>
            <a href="/NhanSu/Index" class="erp-nav-item"><i class="bi bi-people"></i> Quản Trị Nhân Sự</a>
        </div>
    </div>

    <div class="erp-main-content">
        <header class="erp-topbar">
            <span class="fw-semibold text-secondary small">Phân hệ: <span class="text-dark">Kinh Doanh & Quản Trị Đơn Hàng</span></span>
            <div class="d-flex align-items-center gap-3">
                <span class="small fw-semibold"><i class="bi bi-person-circle me-1"></i> @fullName</span>
                <a href="/" target="_blank" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Xem trang chủ"><i class="bi bi-globe"></i> Trang Public</a>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-erp-outline py-1 px-2 text-danger">Đăng xuất</button>
                </form>
            </div>
        </header>
        <main class="p-4 flex-grow-1">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center py-2 px-3 mb-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <div class="small fw-semibold">@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center py-2 px-3 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div class="small fw-semibold">@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>