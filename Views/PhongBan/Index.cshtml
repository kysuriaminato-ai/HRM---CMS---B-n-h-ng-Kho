@model List<ERP_HRM_CMS.Services.HRM.DepartmentTreeNodeDto>
@{
    ViewData["Module"] = "hrm";
    ViewData["Title"] = "Cơ cấu tổ chức & Phòng ban";
    ViewData["BreadcrumbSection"] = "Nhân sự & Chấm công";
    var branches = ViewBag.Branches as List<ERP_HRM_CMS.Models.Entities.Branch>;
    var positions = ViewBag.Positions as List<ERP_HRM_CMS.Models.Entities.Position>;
    var flatDepts = ViewBag.FlatDepartments as List<ERP_HRM_CMS.Services.HRM.DepartmentFlatDto>;
}

@functions {
    async Task RenderTree(List<ERP_HRM_CMS.Services.HRM.DepartmentTreeNodeDto> nodes, int level)
    {
        foreach (var node in nodes)
        {
            <tr class="@(node.IsActive ? "" : "text-muted opacity-75") dept-clickable-row" data-dept-id="@node.Id" style="cursor: pointer;">
                <td class="tabular-nums">
                    <code>@node.Code</code>
                </td>
                <td>
                    <span style="padding-left: @(level * 24)px;">
                        @if (level > 0)
                        {
                            <span class="text-muted me-1">└─</span>
                        }
                        @if (node.Children.Any())
                        {
                            <i class="bi bi-diagram-3 me-1 text-primary"></i>
                        }
                        <span class="fw-semibold">@node.Name</span>
                    </span>
                </td>
                <td class="small text-secondary">@node.BranchName</td>
                <td class="text-center tabular-nums">
                    <span class="badge bg-light text-dark border">@node.EmployeeCount</span>
                </td>
                <td class="text-center">
                    <erp-status-badge variant="@(node.IsActive ? "success" : "neutral")" label="@(node.IsActive ? "Hoạt động" : "Ngừng")" dot="true" />
                </td>
                <td class="text-end" onclick="event.stopPropagation();">
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-primary py-0 px-2 btn-view-drawer" data-dept-id="@node.Id" title="Xem thành viên & biên chế">
                            <i class="bi bi-layout-sidebar-inset-reverse"></i>
                        </button>
                        <form asp-action="ToggleActive" asp-route-id="@node.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary py-0 px-2" title="@(node.IsActive ? "Tạm ngừng" : "Kích hoạt")">
                                <i class="bi @(node.IsActive ? "bi-pause" : "bi-play")"></i>
                            </button>
                        </form>
                        <form asp-action="XoaPhongBan" asp-route-id="@node.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa phòng ban này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger py-0 px-2" title="Xóa phòng ban"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </td>
            </tr>
            @if (node.Children.Any())
            {
                await RenderTree(node.Children, level + 1);
            }
        }
    }

    async Task RenderOrgChartTree(List<ERP_HRM_CMS.Services.HRM.DepartmentTreeNodeDto> nodes, bool isRoot = false)
    {
        <ul>
            @foreach (var node in nodes)
            {
                <li class="@(node.Children.Any() ? "" : "no-children")">
                    <div class="org-node-card @(isRoot ? "root-node" : "") dept-clickable-node" data-dept-id="@node.Id" style="cursor: pointer;" title="Nhấn để xem thành viên & định biên">
                        <div class="org-node-header">
                            <span class="org-node-dept"><i class="bi bi-building me-1"></i>@node.Code</span>
                            <span class="badge bg-white text-primary border border-primary-subtle small ms-auto"><i class="bi bi-eye"></i></span>
                        </div>
                        <div class="org-node-leader">
                            <div class="org-node-avatar bg-primary text-white d-flex align-items-center justify-content-center fw-bold small">
                                @if (!string.IsNullOrWhiteSpace(node.ManagerAvatar))
                                {
                                    <img src="@node.ManagerAvatar" alt="@node.ManagerName" class="rounded-circle w-100 h-100" style="object-fit:cover;" />
                                }
                                else
                                {
                                    @(node.Name[..Math.Min(2, node.Name.Length)].ToUpper())
                                }
                            </div>
                            <div class="org-node-info">
                                <div class="org-node-name" title="@node.Name">@node.Name</div>
                                <div class="org-node-title text-truncate" style="max-width: 140px;" title="@(node.ManagerName ?? "Chưa bổ nhiệm TP")">
                                    <i class="bi bi-person-badge me-1"></i>@(node.ManagerName ?? "Chưa bổ nhiệm TP")
                                </div>
                            </div>
                        </div>
                        <div class="org-node-footer">
                            <span class="org-node-count tabular-nums">
                                <i class="bi bi-people-fill"></i> @node.EmployeeCount nhân sự
                            </span>
                            @if (node.Children.Any())
                            {
                                <button type="button" class="org-toggle-btn" title="Thu gọn / Mở rộng nhánh con" onclick="event.stopPropagation();">
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                            }
                        </div>
                    </div>
                    @if (node.Children.Any())
                    {
                        await RenderOrgChartTree(node.Children, false);
                    }
                </li>
            }
        </ul>
    }
}

<erp-page-header title="Cơ Cấu Tổ Chức & Phòng Ban"
                 subtitle="Sơ đồ cây tổ chức trực quan, danh sách phòng ban và bảng phân định chức danh doanh nghiệp"
                 icon="bi-diagram-3-fill"
                 breadcrumbs="Dashboard:/|Nhân sự & Chấm công:/NhanSu/Index|Cơ cấu tổ chức">
    <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#formPos">
        <i class="bi bi-award me-1"></i> Thêm chức vụ
    </button>
    <button class="btn btn-primary btn-sm ripple" data-bs-toggle="collapse" data-bs-target="#formDept">
        <i class="bi bi-plus-lg me-1"></i> Thêm phòng ban
    </button>
</erp-page-header>

<!-- Form Thêm Phòng Ban (Collapsible) -->
<div class="collapse mb-4" id="formDept">
    <div class="card erp-card p-4">
        <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-plus-circle me-1"></i> Thêm Phòng Ban / Bộ Phận Mới</h6>
        <form asp-action="TaoPhongBan" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Mã phòng ban (*)</label>
                <input type="text" name="Code" class="form-control form-control-sm" placeholder="VD: PB_KDOANH" required />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Tên phòng ban (*)</label>
                <input type="text" name="Name" class="form-control form-control-sm" placeholder="VD: Phòng Kinh Doanh" required />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Chi nhánh (*)</label>
                <select name="BranchId" class="form-select form-select-sm" required>
                    @if (branches != null)
                    {
                        foreach (var b in branches)
                        {
                            <option value="@b.Id">@b.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Phòng ban cấp trên (nếu có)</label>
                <select name="ParentId" class="form-select form-select-sm">
                    <option value="">-- Thuộc ban giám đốc (cấp cao nhất) --</option>
                    @if (flatDepts != null)
                    {
                        foreach (var fd in flatDepts.Where(x => x.IsActive))
                        {
                            <option value="@fd.Id">@fd.DisplayName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 text-end">
                <button type="button" class="btn btn-sm btn-outline-secondary me-2" data-bs-toggle="collapse" data-bs-target="#formDept">Hủy</button>
                <button type="submit" class="btn btn-sm btn-primary px-3">Lưu phòng ban</button>
            </div>
        </form>
    </div>
</div>

<!-- Form Thêm Chức Vụ (Collapsible) -->
<div class="collapse mb-4" id="formPos">
    <div class="card erp-card p-4">
        <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-award me-1"></i> Thêm Chức Danh / Vị Trí Công Tác Mới</h6>
        <form asp-action="TaoChucVu" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Mã chức danh (*)</label>
                <input type="text" name="Code" class="form-control form-control-sm" placeholder="VD: SENIOR_DEV" required />
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-semibold">Tên chức danh (*)</label>
                <input type="text" name="Name" class="form-control form-control-sm" placeholder="VD: Kỹ sư phần mềm Senior" required />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-sm btn-primary w-100">Lưu chức vụ</button>
            </div>
        </form>
    </div>
</div>

<!-- Tabs Điều Hướng: Interactive Org Chart & Danh Sách -->
<erp-tabs active-tab="tabOrgChart">
    <erp-tab id="tabOrgChart" label="Sơ đồ cây tổ chức (Org Chart)" icon="bi-diagram-3-fill">
        <div class="erp-org-viewport" id="orgChartViewport">
            <div class="erp-org-canvas" id="orgChartCanvas">
                <div class="org-tree">
                    @if (Model != null && Model.Any())
                    {
                        await RenderOrgChartTree(Model, true);
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-diagram-3 fs-1 d-block mb-2"></i>
                            Chưa có dữ liệu phòng ban để vẽ sơ đồ tổ chức.
                        </div>
                    }
                </div>
            </div>

            <!-- Điều khiển Zoom & Pan -->
            <div class="org-controls-bar">
                <button type="button" class="org-control-btn" data-org-action="zoom-in" title="Phóng to (+)">
                    <i class="bi bi-zoom-in"></i>
                </button>
                <button type="button" class="org-control-btn" data-org-action="zoom-out" title="Thu nhỏ (-)">
                    <i class="bi bi-zoom-out"></i>
                </button>
                <button type="button" class="org-control-btn" data-org-action="zoom-reset" title="Khôi phục gốc (100%)">
                    <i class="bi bi-arrows-fullscreen"></i>
                </button>
            </div>
        </div>
    </erp-tab>

    <erp-tab id="tabDeptList" label="Danh sách phòng ban dạng cây" icon="bi-list-nested">
        <div class="card erp-card">
            <div class="table-responsive">
                <table class="table erp-table sticky-thead mb-0 align-middle">
                    <thead>
                        <tr>
                            <th style="width: 120px;">Mã PB</th>
                            <th>Tên Phòng Ban &amp; Phân Cấp</th>
                            <th>Chi Nhánh</th>
                            <th class="text-center" style="width: 90px;">Nhân Sự</th>
                            <th class="text-center" style="width: 110px;">Trạng Thái</th>
                            <th class="text-end" style="width: 120px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            await RenderTree(Model, 0);
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="p-0 border-0">
                                    <erp-empty-state icon="bi-building-slash"
                                                     title="Chưa có phòng ban nào"
                                                     description="Hệ thống chưa ghi nhận phòng ban nào trong cơ cấu tổ chức." />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </erp-tab>

    <erp-tab id="tabPositions" label="Danh mục chức danh (@(positions?.Count ?? 0))" icon="bi-award">
        <div class="card erp-card">
            <div class="table-responsive">
                <table class="table erp-table sticky-thead mb-0 align-middle">
                    <thead>
                        <tr>
                            <th style="width: 160px;">Mã Chức Danh</th>
                            <th>Tên Chức Danh Công Việc</th>
                            <th class="text-end" style="width: 120px;">Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (positions != null && positions.Any())
                        {
                            foreach (var p in positions)
                            {
                                <tr>
                                    <td class="tabular-nums"><code>@p.Code</code></td>
                                    <td class="fw-semibold">@p.Name</td>
                                    <td class="text-end">
                                        <erp-status-badge variant="success" label="Hiệu lực" dot="true" />
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="p-0 border-0">
                                    <erp-empty-state icon="bi-award"
                                                     title="Chưa có chức danh nào"
                                                     description="Hệ thống chưa có danh mục chức danh vị trí công tác." />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </erp-tab>
</erp-tabs>

<!-- Drawer Slideout: Chi tiết Phòng Ban & Nhân sự Trực thuộc -->
<erp-drawer id="deptDetailDrawer" title="Thông tin Chi tiết Phòng Ban" position="right" size="lg">
    <div id="drawerLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <div class="mt-2 text-muted small">Đang tải dữ liệu phòng ban...</div>
    </div>
    <div id="drawerContent" class="d-none">
        <!-- Thông tin cơ bản -->
        <div class="card erp-card p-3 mb-3 border-0 bg-light">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <span class="badge bg-primary text-white me-2 tabular-nums" id="dCode"></span>
                    <h5 class="fw-bold d-inline align-middle mb-0" id="dName"></h5>
                </div>
                <span id="dStatusBadge"></span>
            </div>
            <div class="row g-2 text-secondary small mt-1">
                <div class="col-6"><i class="bi bi-geo-alt me-1"></i>Chi nhánh: <strong class="text-dark" id="dBranch"></strong></div>
                <div class="col-6"><i class="bi bi-diagram-2 me-1"></i>Cấp trên: <strong class="text-dark" id="dParent"></strong></div>
            </div>
        </div>

        <!-- Trưởng phòng & Định biên nhân sự -->
        <div class="row g-3 mb-3">
            <div class="col-md-7">
                <div class="card erp-card p-3 h-100">
                    <div class="text-muted small fw-semibold mb-2"><i class="bi bi-person-badge me-1"></i>Trưởng bộ phận phụ trách</div>
                    <div class="d-flex align-items-center gap-3">
                        <div id="dMgrAvatarWrapper" class="avatar avatar-lg bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5">
                            TP
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0 text-dark" id="dMgrName">Chưa bổ nhiệm</h6>
                            <div class="text-primary small" id="dMgrTitle">Trưởng đơn vị</div>
                            <div class="text-muted small mt-1" id="dMgrContact"><i class="bi bi-envelope me-1"></i>-</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card erp-card p-3 h-100">
                    <div class="text-muted small fw-semibold mb-2"><i class="bi bi-pie-chart me-1"></i>Định biên nhân sự</div>
                    <div class="d-flex align-items-baseline justify-content-between mb-1">
                        <span class="fs-4 fw-bold text-dark tabular-nums" id="dHeadcount">0</span>
                        <span class="text-muted small">Chỉ tiêu: <strong class="tabular-nums" id="dQuota">20</strong></span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div id="dQuotaBar" class="progress-bar bg-primary" role="progressbar" style="width: 0%;"></div>
                    </div>
                    <div class="text-muted small mt-2" id="dQuotaRatio">Tỷ lệ lấp đầy: 0%</div>
                </div>
            </div>
        </div>

        <!-- Danh sách thành viên trực thuộc -->
        <div class="card erp-card p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h6 class="fw-bold mb-0"><i class="bi bi-people-fill me-1 text-primary"></i>Danh sách nhân sự trực thuộc (<span id="dMemberCount" class="tabular-nums">0</span>)</h6>
            </div>
            <div class="table-responsive">
                <table class="table erp-table align-middle small mb-0">
                    <thead>
                        <tr>
                            <th>Nhân sự</th>
                            <th>Chức danh</th>
                            <th>Liên hệ</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Hồ sơ</th>
                        </tr>
                    </thead>
                    <tbody id="dMembersTbody"></tbody>
                </table>
            </div>
        </div>
    </div>
</erp-drawer>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Click vào hàng bảng cây hoặc node sơ đồ tổ chức để mở Drawer
            function loadDeptDrawer(deptId) {
                if (!deptId) return;
                var drawer = document.getElementById('deptDetailDrawer');
                var loading = document.getElementById('drawerLoading');
                var content = document.getElementById('drawerContent');

                if (loading) loading.classList.remove('d-none');
                if (content) content.classList.add('d-none');

                // Mở Drawer
                if (window.ERP && window.ERP.drawer) {
                    window.ERP.drawer.open('deptDetailDrawer');
                } else if (drawer) {
                    drawer.classList.add('is-open');
                }

                // Fetch dữ liệu qua API
                fetch('/PhongBan/GetDrawerDetail?id=' + deptId)
                    .then(res => res.json())
                    .then(res => {
                        if (!res.success) {
                            alert(res.message || 'Không thể tải dữ liệu phòng ban.');
                            return;
                        }
                        var data = res.data;
                        document.getElementById('dCode').textContent = data.code;
                        document.getElementById('dName').textContent = data.name;
                        document.getElementById('dBranch').textContent = data.branchName || 'Toàn công ty';
                        document.getElementById('dParent').textContent = data.parentDepartmentName || 'Cấp cao nhất';

                        // Trạng thái badge
                        var statusContainer = document.getElementById('dStatusBadge');
                        statusContainer.innerHTML = data.isActive
                            ? '<span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-dot"></i>Hoạt động</span>'
                            : '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Tạm ngừng</span>';

                        // Trưởng phòng
                        document.getElementById('dMgrName').textContent = data.managerName || 'Chưa bổ nhiệm';
                        document.getElementById('dMgrTitle').textContent = data.managerTitle || 'Trưởng đơn vị';
                        var contactHtml = '';
                        if (data.managerEmail) contactHtml += '<i class="bi bi-envelope me-1"></i>' + data.managerEmail + ' ';
                        if (data.managerPhone) contactHtml += '<i class="bi bi-telephone ms-2 me-1"></i>' + data.managerPhone;
                        document.getElementById('dMgrContact').innerHTML = contactHtml || '-';

                        var avatarWrapper = document.getElementById('dMgrAvatarWrapper');
                        if (data.managerAvatar) {
                            avatarWrapper.innerHTML = '<img src="' + data.managerAvatar + '" class="rounded-circle w-100 h-100" style="object-fit:cover;" />';
                        } else {
                            avatarWrapper.innerHTML = (data.managerName ? data.managerName.substring(0, 2).toUpperCase() : 'TP');
                        }

                        // Định biên
                        document.getElementById('dHeadcount').textContent = data.currentHeadcount;
                        document.getElementById('dQuota').textContent = data.staffingQuota;
                        var pct = Math.min(100, Math.round((data.currentHeadcount / (data.staffingQuota || 1)) * 100));
                        var bar = document.getElementById('dQuotaBar');
                        bar.style.width = pct + '%';
                        bar.className = 'progress-bar ' + (pct >= 90 ? 'bg-danger' : (pct >= 70 ? 'bg-warning' : 'bg-primary'));
                        document.getElementById('dQuotaRatio').textContent = 'Tỷ lệ lấp đầy: ' + pct + '%';

                        // Danh sách nhân sự
                        document.getElementById('dMemberCount').textContent = (data.members ? data.members.length : 0);
                        var tbody = document.getElementById('dMembersTbody');
                        tbody.innerHTML = '';
                        if (data.members && data.members.length > 0) {
                            data.members.forEach(function (m) {
                                var avatarElem = m.avatarUrl
                                    ? '<img src="' + m.avatarUrl + '" class="rounded-circle me-2" style="width:32px;height:32px;object-fit:cover;" />'
                                    : '<span class="avatar avatar-sm bg-secondary text-white rounded-circle me-2 d-inline-flex align-items-center justify-content-center" style="width:32px;height:32px;font-size:12px;">' + m.fullName.substring(0, 2).toUpperCase() + '</span>';

                                var statusBadge = m.status === 'Active'
                                    ? '<span class="badge bg-success-subtle text-success">Đang làm</span>'
                                    : (m.status === 'Probation' ? '<span class="badge bg-warning-subtle text-warning">Thử việc</span>' : '<span class="badge bg-secondary-subtle text-muted">' + m.status + '</span>');

                                var tr = document.createElement('tr');
                                tr.innerHTML = '<td><div class="d-flex align-items-center">' + avatarElem + '<div><div class="fw-semibold text-dark">' + m.fullName + '</div><small class="text-muted tabular-nums">' + m.employeeCode + '</small></div></div></td>'
                                    + '<td><span class="text-secondary">' + m.positionName + '</span></td>'
                                    + '<td><div class="text-muted small">' + m.email + '</div><div class="text-muted small">' + (m.phone || '') + '</div></td>'
                                    + '<td>' + statusBadge + '</td>'
                                    + '<td class="text-end"><a href="/NhanSu/Details/' + m.id + '" class="btn btn-sm btn-outline-primary py-0 px-2" title="Xem hồ sơ 360°"><i class="bi bi-arrow-right"></i></a></td>';
                                tbody.appendChild(tr);
                            });
                        } else {
                            tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">Chưa có nhân viên trực thuộc phòng này.</td></tr>';
                        }

                        if (loading) loading.classList.add('d-none');
                        if (content) content.classList.remove('d-none');
                    })
                    .catch(function (err) {
                        if (loading) loading.classList.add('d-none');
                        alert('Lỗi tải thông tin phòng ban: ' + err);
                    });
            }

            // Gán sự kiện click vào các node và hàng
            document.querySelectorAll('.dept-clickable-node, .dept-clickable-row, .btn-view-drawer').forEach(function (elem) {
                elem.addEventListener('click', function (e) {
                    var deptId = this.getAttribute('data-dept-id');
                    if (deptId) {
                        loadDeptDrawer(deptId);
                    }
                });
            });
        });
    </script>
}
