@model List<ERP_HRM_CMS.Models.Entities.Role>
@{
    ViewData["Title"] = "Quản lý nhóm quyền";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4 class="fw-bold mb-0">Quản lý nhóm quyền</h4>
        <small class="text-muted">Tạo nhóm cho từng bộ phận quản trị. Gán quyền chi tiết ở ma trận phân quyền, rồi gán nhóm cho tài khoản.</small>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-dark" href="/QuanTriTaiKhoan/Index"><i class="bi bi-people me-1"></i> Tài khoản</a>
        <a class="btn btn-dark" asp-action="Create"><i class="bi bi-plus-lg me-1"></i> Tạo nhóm quyền</a>
    </div>
</div>

@if (TempData["ThongBao"] is string tb)
{
    <div class="alert alert-success py-2">@tb</div>
}
@if (TempData["LoiVaiTro"] is string loi)
{
    <div class="alert alert-danger py-2">@loi</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Mã nhóm</th>
                <th>Tên nhóm quyền</th>
                <th>Mô tả</th>
                <th class="text-center">Số quyền</th>
                <th class="text-center">Số tài khoản</th>
                <th>Loại</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td><code>@r.Code</code></td>
                <td class="fw-semibold">@r.Name</td>
                <td class="small text-muted">@(r.Description ?? "—")</td>
                <td class="text-center">@r.RolePermissions.Count</td>
                <td class="text-center">@r.UserRoles.Count</td>
                <td>
                    @if (r.IsSystem)
                    {
                        <span class="badge bg-secondary">Mặc định</span>
                    }
                    else
                    {
                        <span class="badge bg-info text-dark">Tự tạo</span>
                    }
                </td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" href="/PhanQuyen/MaTranPhanQuyen?roleId=@r.Id" title="Gán quyền"><i class="bi bi-shield-check"></i> Quyền</a>
                    <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@r.Id"><i class="bi bi-pencil"></i> Sửa</a>
                    @if (!r.IsSystem)
                    {
                        <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Xóa nhóm quyền @r.Name?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Xóa</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
