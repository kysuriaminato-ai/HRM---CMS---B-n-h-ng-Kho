@model ERP_HRM_CMS.Models.ViewModels.VaiTroFormModel
@{
    var isEdit = Model.Id > 0;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Code" />
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Mã nhóm</label>
        @if (isEdit)
        {
            <input class="form-control font-monospace" value="@Model.Code" disabled />
            <div class="form-text">Mã nhóm không đổi sau khi tạo.</div>
        }
        else
        {
            <input asp-for="Code" class="form-control font-monospace" placeholder="VD: ADMIN_KHUYENMAI" autocomplete="off" />
            <div class="form-text">Chữ in hoa không dấu, số và dấu gạch dưới. Ví dụ: ADMIN_KHUYENMAI.</div>
            <span asp-validation-for="Code" class="text-danger small"></span>
        }
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label fw-semibold"></label>
        <input asp-for="Name" class="form-control" placeholder="VD: Quản lý khuyến mãi" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Description" class="form-label fw-semibold"></label>
        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nhóm này phụ trách việc gì..."></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-dark px-4">@(isEdit ? "Lưu thay đổi" : "Tạo và gán quyền")</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
    </div>
</form>
