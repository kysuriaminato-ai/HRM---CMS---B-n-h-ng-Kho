@model IEnumerable<ERP_HRM_CMS.Models.Entities.Notification>
@{
    ViewData["Title"] = "Trung Tâm Thông Báo & Cảnh Báo Hệ Thống";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-bell-fill me-2 text-primary"></i>Trung Tâm Thông Báo</h4>
        <p class="text-muted small mb-0">Theo dõi thông báo thời gian thực về đơn hàng POS, biến động tồn kho và sự kiện hệ thống</p>
    </div>
    <div>
        <button type="button" class="btn btn-outline-primary btn-sm px-3" onclick="markAllNotificationsRead()">
            <i class="bi bi-check2-all me-1"></i> Đánh dấu đã đọc tất cả
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="list-group list-group-flush" id="notificationCenterList">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    string bgClass = item.IsRead ? "bg-white" : "bg-light-subtle fw-semibold";
                    string iconClass = item.Type switch
                    {
                        "ORDER" => "bi-cart-check-fill text-success",
                        "STOCK_ALERT" => "bi-exclamation-triangle-fill text-danger",
                        "HRM" => "bi-person-badge-fill text-info",
                        _ => "bi-info-circle-fill text-primary"
                    };

                    <div class="list-group-item list-group-item-action p-3 @bgClass d-flex justify-content-between align-items-start border-bottom" id="notif-row-@item.Id">
                        <div class="d-flex align-items-start gap-3">
                            <div class="fs-4">
                                <i class="bi @iconClass"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <h6 class="mb-0 fw-bold">@item.Title</h6>
                                    @if (!item.IsRead)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary px-2" style="font-size: 10px;">MỚI</span>
                                    }
                                    <span class="badge bg-secondary-subtle text-secondary" style="font-size: 10px;">@item.Type</span>
                                </div>
                                <p class="text-secondary small mb-1">@item.Content</p>
                                <div class="text-muted" style="font-size: 11px;">
                                    <i class="bi bi-clock me-1"></i>@item.CreatedAt.ToString("HH:mm - dd/MM/yyyy")
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            @if (!string.IsNullOrEmpty(item.LinkUrl))
                            {
                                <a href="@item.LinkUrl" class="btn btn-sm btn-outline-primary py-1 px-2" onclick="markOneRead(@item.Id)">
                                    <i class="bi bi-arrow-right-short"></i> Xem
                                </a>
                            }
                            @if (!item.IsRead)
                            {
                                <button type="button" class="btn btn-sm btn-light py-1 px-2 text-muted" onclick="markOneRead(@item.Id)" title="Đánh dấu đã đọc">
                                    <i class="bi bi-check"></i>
                                </button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-bell-slash fs-1 d-block mb-2 text-secondary"></i>
                    Không có thông báo nào.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    function markOneRead(id) {
        fetch('/Notification/MarkAsRead?id=' + id, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const row = document.getElementById('notif-row-' + id);
                    if (row) {
                        row.classList.remove('bg-light-subtle', 'fw-semibold');
                        row.classList.add('bg-white');
                        const badge = row.querySelector('.badge.bg-primary-subtle');
                        if (badge) badge.remove();
                    }
                }
            });
    }

    function markAllNotificationsRead() {
        fetch('/Notification/MarkAllAsRead', { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    window.location.reload();
                }
            });
    }
</script>
}
