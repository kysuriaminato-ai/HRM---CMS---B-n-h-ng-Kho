@model ERP_HRM_CMS.Models.ViewModels.TaiKhoanFormViewModel
@{
    var isEdit = Model.Id > 0;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" id="formTaiKhoan">
    @Html.AntiForgeryToken()
    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Username" />
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

    @* 1. Chọn Nhân Viên Liên Kết *@
    <div class="mb-3">
        <label asp-for="EmployeeId" class="form-label fw-semibold">
            <i class="bi bi-person-badge text-primary me-1"></i> Nhân viên liên kết
        </label>
        @if (isEdit && Model.EmployeeId.HasValue)
        {
            <div class="p-2 border rounded bg-light-subtle d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill text-success"></i>
                <span><strong>[@Model.EmployeeCode]</strong> @Model.EmployeeFullName — @Model.DepartmentName</span>
                <input type="hidden" asp-for="EmployeeId" />
            </div>
        }
        else
        {
            <select asp-for="EmployeeId" class="form-select" id="selectEmployee" onchange="onEmployeeSelected(this)">
                <option value="">-- Tài khoản hệ thống / Không liên kết nhân sự --</option>
                @if (Model.Employees != null)
                {
                    foreach (var emp in Model.Employees)
                    {
                        <option value="@emp.Id" 
                                data-code="@emp.EmployeeCode" 
                                data-fullname="@emp.FullName" 
                                data-dept="@emp.DepartmentName"
                                data-hasaccount="@(emp.HasAccount ? "true" : "false")"
                                selected="@(Model.EmployeeId == emp.Id)">
                            [@emp.EmployeeCode] @emp.FullName - @emp.DepartmentName (@emp.PositionName) @(emp.HasAccount ? " [Đã có TK]" : "")
                        </option>
                    }
                }
            </select>
            <div class="form-text small">Chọn nhân sự để cấp tài khoản. Hệ thống sẽ tự động liên kết hồ sơ và gợi ý tên đăng nhập.</div>
        }
    </div>

    @* 2. Tên Đăng Nhập & Mật Khẩu *@
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Username" class="form-label fw-semibold">Tên đăng nhập (*)</label>
            @if (isEdit)
            {
                <input class="form-control bg-light" value="@Model.Username" disabled />
            }
            else
            {
                <input asp-for="Username" class="form-control" id="inputUsername" placeholder="ví dụ: an.nguyen hoặc nv005" required autocomplete="off" />
            }
        </div>
        <div class="col-md-6">
            @if (!isEdit)
            {
                <label asp-for="Password" class="form-label fw-semibold">Mật khẩu ban đầu (*)</label>
                <div class="input-group">
                    <input asp-for="Password" type="text" class="form-control font-monospace" id="inputPassword" value="@(Model.Password ?? "Admin@123456")" required />
                    <button class="btn btn-outline-secondary" type="button" onclick="generateRandomPass()" title="Sinh mật khẩu ngẫu nhiên">
                        <i class="bi bi-shuffle"></i>
                    </button>
                </div>
                <div class="form-text small">Mặc định: <code>Admin@123456</code> (tối thiểu 8 ký tự, có chữ và số).</div>
            }
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="form-check form-switch pt-2">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" checked="@Model.IsActive" />
                <label asp-for="IsActive" class="form-check-label fw-semibold">Kích hoạt tài khoản ngay</label>
            </div>
        </div>
        @if (!isEdit)
        {
            <div class="col-md-6">
                <div class="form-check form-switch pt-2">
                    <input asp-for="MustChangePassword" class="form-check-input" type="checkbox" />
                    <label asp-for="MustChangePassword" class="form-check-label">Bắt buộc đổi mật khẩu ở lần đăng nhập đầu</label>
                </div>
            </div>
        }
    </div>

    @* 3. Vai Trò Hệ Thống (Roles) *@
    <div class="mb-4">
        <label class="form-label fw-semibold d-block">Vai trò chính (Roles)</label>
        <div class="row g-2">
            @foreach (var r in Model.Roles)
            {
                <div class="col-md-6">
                    <div class="form-check border rounded p-2 ps-4 bg-body">
                        <input class="form-check-input" type="checkbox" name="roleIds" id="role_@r.Id" value="@r.Id" checked="@r.Checked" />
                        <label class="form-check-label w-100" for="role_@r.Id">
                            <strong class="d-block">@r.Name</strong>
                            <small class="text-muted">Mã: @r.Code</small>
                        </label>
                    </div>
                </div>
            }
        </div>
    </div>

    @* 4. Bảng Phân Quyền Ẩn/Hiện Menu Trực Tiếp Khi Tạo Tài Khoản Admin Con *@
    @if (!isEdit && Model.MenuFeatures != null && Model.MenuFeatures.Any())
    {
        <div class="mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
                <div>
                    <label class="form-label fw-bold mb-0 text-primary fs-6">
                        <i class="bi bi-shield-lock-fill me-1"></i> Phân Quyền Menu Cho Admin Con
                    </label>
                    <small class="text-muted d-block">Admin Con khi đăng nhập vào hệ thống <strong>CHỈ XEM ĐƯỢC CÁC MENU ĐƯỢC TÍCH CHỌN</strong>. Mọi menu khác sẽ được ẩn hoàn toàn!</small>
                </div>
                <div class="d-flex flex-wrap gap-1">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="presetRole('sales')">
                        <i class="bi bi-cart me-1"></i> Admin Con Bán Hàng
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-success" onclick="presetRole('hrm')">
                        <i class="bi bi-people me-1"></i> Admin Con Nhân Sự
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-info" onclick="presetRole('payroll')">
                        <i class="bi bi-cash-stack me-1"></i> Admin Con Lương & KT
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-warning" onclick="presetRole('warehouse')">
                        <i class="bi bi-box-seam me-1"></i> Admin Con Kho
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-dark" onclick="presetRole('cms')">
                        <i class="bi bi-globe me-1"></i> Admin Con CMS
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAllFeatures(true)">Tất cả</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="toggleAllFeatures(false)">Bỏ hết</button>
                </div>
            </div>

            <div class="row g-2 border rounded p-3 bg-light-subtle">
                @foreach (var group in Model.MenuFeatures.GroupBy(f => f.Group))
                {
                    <div class="col-12 mt-2">
                        <span class="badge bg-secondary-subtle text-secondary fw-bold">@group.Key</span>
                    </div>
                    @foreach (var f in group)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 border p-2 bg-body">
                                <div class="form-check form-switch d-flex align-items-start gap-2">
                                    <input class="form-check-input feature-checkbox mt-1" type="checkbox" 
                                           name="featureCodes" value="@f.Code" id="feat_@f.Code" 
                                           checked="@f.Checked" />
                                    <label class="form-check-label w-100 cursor-pointer" for="feat_@f.Code">
                                        <div class="fw-semibold small"><i class="@f.Icon text-primary me-1"></i> @f.Name</div>
                                        <small class="text-muted d-block" style="font-size: 0.75rem;">@f.Description</small>
                                    </label>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }

    <div class="d-flex gap-2 justify-content-end mt-4">
        <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
        <button type="submit" class="btn btn-dark px-4">
            <i class="bi bi-check-lg me-1"></i> @(isEdit ? "Lưu thay đổi" : "Tạo tài khoản")
        </button>
    </div>
</form>

<script>
    function onEmployeeSelected(select) {
        var opt = select.options[select.selectedIndex];
        if (!opt || !opt.value) return;

        var code = opt.getAttribute('data-code');
        var fullname = opt.getAttribute('data-fullname');
        var usernameInput = document.getElementById('inputUsername');

        if (usernameInput && !usernameInput.value) {
            // Tự sinh username: mã nhân viên viết thường, ví dụ: nv005
            usernameInput.value = code.toLowerCase();
        }
    }

    function generateRandomPass() {
        var chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@@#$%";
        var pass = "";
        for (var i = 0; i < 10; i++) {
            pass += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        pass += "1aA@@";
        document.getElementById('inputPassword').value = pass;
    }

    function toggleAllFeatures(checked) {
        document.querySelectorAll('.feature-checkbox').forEach(function(cb) {
            cb.checked = checked;
        });
    }

    function presetRole(type) {
        var map = {
            'sales': ['banhang', 'sanpham', 'donhang', 'khachhang', 'kho', 'baocao'],
            'hrm': ['nhansu', 'chamcong', 'dontu', 'hopdong', 'tuyendung', 'ess'],
            'payroll': ['luong', 'hopdong', 'baocao', 'congno', 'ess'],
            'warehouse': ['kho', 'sanpham', 'muahang', 'nhacungcap'],
            'cms': ['cms_content', 'cms_menu', 'cms_layout']
        };
        var allowed = map[type] || [];
        document.querySelectorAll('.feature-checkbox').forEach(function(cb) {
            cb.checked = allowed.indexOf(cb.value) !== -1;
        });
    }

    function setEssOnly() {
        document.querySelectorAll('.feature-checkbox').forEach(function(cb) {
            cb.checked = (cb.value === 'ess');
        });
    }
</script>
