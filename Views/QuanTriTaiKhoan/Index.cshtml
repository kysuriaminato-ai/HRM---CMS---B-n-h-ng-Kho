@model ERP_HRM_CMS.Models.ViewModels.TaiKhoanIndexViewModel
@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4 class="fw-bold mb-0">Quản lý tài khoản &amp; Phân quyền Menu</h4>
        <small class="text-muted">Tạo tài khoản nhân viên, cấu hình ẩn/hiện chức năng menu, duyệt và khóa tài khoản.</small>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-dark" asp-action="Create">
            <i class="bi bi-person-plus me-1"></i> Cấp tài khoản cho nhân viên
        </a>
    </div>
</div>

@if (TempData["ThongBao"] is string tb)
{
    <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@tb
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["LoiDuyet"] is string loi)
{
    <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@loi
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@*
    Khung thông tin đăng nhập vừa cấp.
    Mật khẩu tạm chỉ nằm trong TempData nên chỉ hiện đúng một lần sau khi
    tạo tài khoản hoặc đặt lại mật khẩu. Tải lại trang là mất, vì vậy khung
    này được đặt ngay đầu trang kèm nút sao chép để admin gửi cho người dùng.
*@
@if (TempData["GeneratedPassword"] is string matKhauTam && !string.IsNullOrWhiteSpace(matKhauTam))
{
    var tkTen = TempData["GeneratedUsername"] as string ?? string.Empty;
    var tkNgucanh = TempData["GeneratedPasswordContext"] as string ?? "Thông tin đăng nhập";

    <div class="card border-0 shadow-sm mb-3" id="khungThongTinDangNhap"
         style="border-left: 4px solid #d95b8c !important; background: #fffafc;">
        <div class="card-body">
            <div class="d-flex align-items-start gap-2 mb-3">
                <i class="bi bi-key-fill fs-4" style="color: #d95b8c;"></i>
                <div>
                    <div class="fw-bold">@tkNgucanh — hãy sao chép ngay</div>
                    <small class="text-danger fw-semibold">
                        Mật khẩu tạm chỉ hiển thị một lần. Tải lại trang là không xem lại được.
                    </small>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12 col-md-5">
                    <label class="form-label small text-muted mb-1" for="tkTenDangNhap">Tên đăng nhập</label>
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace" id="tkTenDangNhap"
                               value="@tkTen" readonly aria-label="Tên đăng nhập vừa cấp" />
                        <button class="btn btn-outline-secondary js-copy" type="button"
                                data-copy-target="tkTenDangNhap" title="Sao chép tên đăng nhập">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                </div>

                <div class="col-12 col-md-5">
                    <label class="form-label small text-muted mb-1" for="tkMatKhauTam">Mật khẩu tạm thời</label>
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace fw-bold" id="tkMatKhauTam"
                               value="@matKhauTam" readonly aria-label="Mật khẩu tạm thời" />
                        <button class="btn btn-outline-secondary js-copy" type="button"
                                data-copy-target="tkMatKhauTam" title="Sao chép mật khẩu">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                </div>

                <div class="col-12 col-md-2 d-flex align-items-end">
                    <button class="btn w-100 js-copy-both" type="button"
                            style="background: #d95b8c; color: #fff;">
                        <i class="bi bi-clipboard-check me-1"></i> Cả hai
                    </button>
                </div>
            </div>

            <div class="small text-muted mt-3 mb-0">
                <i class="bi bi-info-circle me-1"></i>
                Ở lần đăng nhập đầu tiên, hệ thống sẽ bắt buộc người dùng đổi mật khẩu
                tại <code>/Auth/ChangePassword</code>. Sau khi đổi xong, họ vào được
                đúng các chức năng đã được phân quyền.
            </div>
        </div>
    </div>
}

<div class="d-flex gap-2 mb-3">
    <a class="btn btn-sm btn-outline-dark @(ViewBag.Loc == null ? "active" : "")" asp-action="Index">Tất cả tài khoản (@Model.Items.Count)</a>
    <a class="btn btn-sm btn-outline-dark @(ViewBag.Loc == "khoa" ? "active" : "")" asp-action="Index" asp-route-loc="khoa">
        Chờ duyệt / Đã khóa (@Model.SoChoDuyet)
    </a>
</div>

<div class="erp-card">
    <div class="table-responsive">
        <table class="table erp-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Tên đăng nhập</th>
                    <th>Nhân viên liên kết</th>
                    <th>Phòng ban</th>
                    <th>Vai trò</th>
                    <th class="text-center">Trạng thái</th>
                    <th>Đăng nhập gần nhất</th>
                    <th class="text-end" style="width: 280px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Items != null && Model.Items.Any())
            {
                foreach (var u in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">
                            @u.Username
                            @if (u.IsSuperAdmin)
                            {
                                <span class="badge bg-danger ms-1">Admin Tổng</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(u.FullName))
                            {
                                <div class="d-flex align-items-center gap-1.5">
                                    <i class="bi bi-person-badge text-primary"></i>
                                    <span><strong>[@u.EmployeeCode]</strong> @u.FullName</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">— Tài khoản hệ thống —</span>
                            }
                        </td>
                        <td>
                            @(u.DepartmentName ?? "—")
                        </td>
                        <td>
                            @if (u.RoleNames.Count == 0)
                            {
                                <span class="badge bg-light text-muted border">Chưa có vai trò</span>
                            }
                            else
                            {
                                foreach (var r in u.RoleNames)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border me-1">@r</span>
                                }
                            }
                        </td>
                        <td class="text-center">
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-muted border">Đã khóa</span>
                            }
                        </td>
                        <td><small class="text-muted">@(u.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa đăng nhập")</small></td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                @if (!u.IsSuperAdmin)
                                {
                                    <a class="btn btn-outline-primary" asp-action="MenuNhanVien" asp-route-id="@u.Id" title="Cấu hình ẩn/hiện chức năng menu cho nhân viên này">
                                        <i class="bi bi-layout-text-sidebar me-1"></i> Cấu hình Menu
                                    </a>
                                }
                                <a class="btn btn-outline-dark" asp-action="Edit" asp-route-id="@u.Id" title="Chỉnh sửa thông tin">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (!u.IsActive)
                                {
                                    <form asp-action="Approve" asp-route-id="@u.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success" title="Mở khóa tài khoản">
                                            <i class="bi bi-unlock"></i>
                                        </button>
                                    </form>
                                }
                                else if (!u.IsSuperAdmin)
                                {
                                    <form asp-action="Lock" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn khóa tài khoản này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Khóa tài khoản">
                                            <i class="bi bi-lock"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-5">
                        <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                        Không có tài khoản nào phù hợp với bộ lọc.
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@*
    Sao chép thông tin đăng nhập. navigator.clipboard chỉ hoạt động trong ngữ cảnh
    bảo mật (https hoặc localhost) nên có thêm nhánh dự phòng dùng execCommand.
*@
<script>
    (function () {
        var khung = document.getElementById('khungThongTinDangNhap');
        if (!khung) { return; }

        function saoChep(chuoi, nut) {
            function baoThanhCong() {
                if (!nut) { return; }
                var icon = nut.querySelector('i');
                var lopCu = icon ? icon.className : null;
                if (icon) { icon.className = 'bi bi-check-lg'; }
                setTimeout(function () {
                    if (icon && lopCu) { icon.className = lopCu; }
                }, 1400);
            }

            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(chuoi).then(baoThanhCong, duPhong);
            } else {
                duPhong();
            }

            function duPhong() {
                var tam = document.createElement('textarea');
                tam.value = chuoi;
                tam.setAttribute('readonly', '');
                tam.style.position = 'fixed';
                tam.style.opacity = '0';
                document.body.appendChild(tam);
                tam.select();
                try { document.execCommand('copy'); baoThanhCong(); } catch (e) { }
                document.body.removeChild(tam);
            }
        }

        khung.querySelectorAll('.js-copy').forEach(function (nut) {
            nut.addEventListener('click', function () {
                var o = document.getElementById(nut.getAttribute('data-copy-target'));
                if (o) { saoChep(o.value, nut); }
            });
        });

        var nutCaHai = khung.querySelector('.js-copy-both');
        if (nutCaHai) {
            nutCaHai.addEventListener('click', function () {
                var ten = document.getElementById('tkTenDangNhap');
                var mk = document.getElementById('tkMatKhauTam');
                saoChep('Tên đăng nhập: ' + (ten ? ten.value : '') +
                        '\nMật khẩu tạm: ' + (mk ? mk.value : ''), nutCaHai);
            });
        }
    })();
</script>
