@model IEnumerable<ERP_HRM_CMS.Models.Entities.Category>
@{
    Layout = "_SalesLayout";
    ViewData["Title"] = "Quản Lý Danh Mục Ngành Hàng";
    var parents = ViewBag.Parents as List<ERP_HRM_CMS.Models.Entities.Category> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-diagram-2 me-2 text-primary"></i>Danh Mục Ngành Hàng</h4>
        <p class="text-muted small mb-0">Phân loại hàng hóa theo cây danh mục cha - con và theo dõi số lượng mặt hàng</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
            <i class="bi bi-plus-circle me-1"></i> Thêm mới danh mục
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 80px;">Thứ tự</th>
                        <th>Mã danh mục</th>
                        <th>Tên danh mục</th>
                        <th>Danh mục cha</th>
                        <th>Đường dẫn (Slug)</th>
                        <th class="text-center">Số sản phẩm</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var cat in Model)
                        {
                            <tr>
                                <td class="ps-3 text-muted">@cat.OrderIndex</td>
                                <td><span class="badge bg-light text-dark border font-monospace">@cat.Code</span></td>
                                <td class="fw-semibold text-dark">@cat.Name</td>
                                <td>
                                    @if (cat.Parent != null)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">@cat.Parent.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><em>(Cấp gốc)</em></span>
                                    }
                                </td>
                                <td class="text-muted small">@cat.Slug</td>
                                <td class="text-center">
                                    <span class="badge bg-info-subtle text-info border border-info px-2 py-1">
                                        @(cat.Products?.Count ?? 0) mặt hàng
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <form asp-action="Delete" asp-route-id="@cat.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                Chưa có danh mục nào. Hãy bấm "Thêm mới danh mục" ở trên.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm Danh Mục -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Thêm Mới Danh Mục</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã danh mục</label>
                        <input name="Code" class="form-control" required placeholder="VD: MAY_TINH, PHU_KIEN..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên danh mục</label>
                        <input name="Name" class="form-control" required placeholder="VD: Máy tính & Thiết bị văn phòng..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Danh mục cha (nếu có)</label>
                        <select name="ParentId" class="form-select">
                            <option value="">-- Là danh mục cấp cao nhất --</option>
                            @foreach (var p in parents)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Thứ tự hiển thị</label>
                        <input name="OrderIndex" type="number" class="form-control" value="1" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary px-3">Lưu danh mục</button>
                </div>
            </form>
        </div>
    </div>
</div>
