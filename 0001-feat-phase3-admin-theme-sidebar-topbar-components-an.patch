@@ -0,0 +1,259 @@
+/* ==========================================================================
+   ADMIN ANIMATIONS - Hiệu ứng động
+   Tôn trọng prefers-reduced-motion
+   ========================================================================== */
+
+/* ==========================================================================
+   1. FADE-IN & SLIDE-UP khi tải trang
+   ========================================================================== */
+.fade-in {
+    animation: fadeIn 0.4s ease-out both;
+}
+
+.slide-up {
+    animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
+}
+
+.slide-up-sm {
+    animation: slideUpSm 0.35s ease-out both;
+}
+
+@keyframes fadeIn {
+    from { opacity: 0; }
+    to { opacity: 1; }
+}
+
+@keyframes slideUp {
+    from { opacity: 0; transform: translateY(20px); }
+    to { opacity: 1; transform: translateY(0); }
+}
+
+@keyframes slideUpSm {
+    from { opacity: 0; transform: translateY(10px); }
+    to { opacity: 1; transform: translateY(0); }
+}
+
+/* ==========================================================================
+   2. STAGGER - Hiệu ứng so le cho danh sách
+   ========================================================================== */
+.stagger-list > * {
+    animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
+}
+
+.stagger-list > *:nth-child(1) { animation-delay: 0ms; }
+.stagger-list > *:nth-child(2) { animation-delay: 60ms; }
+.stagger-list > *:nth-child(3) { animation-delay: 120ms; }
+.stagger-list > *:nth-child(4) { animation-delay: 180ms; }
+.stagger-list > *:nth-child(5) { animation-delay: 240ms; }
+.stagger-list > *:nth-child(6) { animation-delay: 300ms; }
+.stagger-list > *:nth-child(7) { animation-delay: 360ms; }
+.stagger-list > *:nth-child(8) { animation-delay: 420ms; }
+.stagger-list > *:nth-child(n+9) { animation-delay: 480ms; }
+
+/* ==========================================================================
+   3. HOVER - Nâng thẻ khi hover
+   ========================================================================== */
+.hover-lift {
+    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
+}
+
+.hover-lift:hover {
+    transform: translateY(-3px);
+    box-shadow: var(--erp-elevated-shadow);
+}
+
+.hover-grow {
+    transition: transform 0.2s ease;
+}
+
+.hover-grow:hover {
+    transform: scale(1.02);
+}
+
+/* ==========================================================================
+   4. RIPPLE - Hiệu ứng khi nhấn nút
+   ========================================================================== */
+.ripple {
+    position: relative;
+    overflow: hidden;
+}
+
+.ripple-effect {
+    position: absolute;
+    border-radius: 50%;
+    background: rgba(255, 255, 255, 0.35);
+    transform: scale(0);
+    animation: rippleAnim 0.6s ease-out;
+    pointer-events: none;
+}
+
+@keyframes rippleAnim {
+    to {
+        transform: scale(4);
+        opacity: 0;
+    }
+}
+
+/* ==========================================================================
+   5. SCROLL REVEAL (IntersectionObserver)
+   Thêm class .reveal vào phần tử, JS sẽ thêm .revealed khi vào viewport
+   ========================================================================== */
+.reveal {
+    opacity: 0;
+    transform: translateY(24px);
+    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
+}
+
+.reveal.revealed {
+    opacity: 1;
+    transform: translateY(0);
+}
+
+.reveal-left {
+    opacity: 0;
+    transform: translateX(-24px);
+    transition: opacity 0.6s ease, transform 0.6s ease;
+}
+
+.reveal-left.revealed {
+    opacity: 1;
+    transform: translateX(0);
+}
+
+.reveal-right {
+    opacity: 0;
+    transform: translateX(24px);
+    transition: opacity 0.6s ease, transform 0.6s ease;
+}
+
+.reveal-right.revealed {
+    opacity: 1;
+    transform: translateX(0);
+}
+
+.reveal-scale {
+    opacity: 0;
+    transform: scale(0.9);
+    transition: opacity 0.5s ease, transform 0.5s ease;
+}
+
+.reveal-scale.revealed {
+    opacity: 1;
+    transform: scale(1);
+}
+
+/* ==========================================================================
+   6. COUNT-UP ANIMATION (JS-driven, class)
+   ========================================================================== */
+.count-up {
+    display: inline-block;
+    /* Dùng tabular-nums để số không nhảy bố cục */
+    font-variant-numeric: tabular-nums;
+}
+
+/* ==========================================================================
+   7. CHART ANIMATION
+   ========================================================================== */
+.chart-container {
+    position: relative;
+    animation: chartFadeIn 0.6s ease-out 0.2s both;
+}
+
+@keyframes chartFadeIn {
+    from { opacity: 0; transform: translateY(12px); }
+    to { opacity: 1; transform: translateY(0); }
+}
+
+/* ==========================================================================
+   8. SIDEBAR & MODAL TRANSITIONS
+   ========================================================================== */
+.erp-sidebar {
+    transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+#sidebarToggleIcon {
+    transition: transform 0.25s ease;
+}
+
+/* Modal smooth */
+.modal.fade .modal-dialog {
+    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
+    transform: scale(0.95) translateY(-10px);
+}
+
+.modal.show .modal-dialog {
+    transform: scale(1) translateY(0);
+}
+
+/* ==========================================================================
+   9. TOAST AUTO-DISMISS ANIMATION
+   ========================================================================== */
+.erp-toast-alert {
+    animation: toastSlideIn 0.3s ease-out;
+}
+
+@keyframes toastSlideIn {
+    from { opacity: 0; transform: translateY(-10px); }
+    to { opacity: 1; transform: translateY(0); }
+}
+
+.erp-toast-dismiss {
+    animation: toastSlideOut 0.25s ease-in forwards;
+}
+
+@keyframes toastSlideOut {
+    to { opacity: 0; transform: translateY(-10px); height: 0; padding: 0; margin: 0; overflow: hidden; }
+}
+
+/* ==========================================================================
+   10. SPINNER / LOADING
+   ========================================================================== */
+.erp-spinner {
+    display: inline-block;
+    width: 20px;
+    height: 20px;
+    border: 2px solid var(--erp-border-color);
+    border-top-color: var(--erp-primary);
+    border-radius: 50%;
+    animation: btn-spin 0.6s linear infinite;
+}
+
+.erp-spinner-lg {
+    width: 32px;
+    height: 32px;
+    border-width: 3px;
+}
+
+/* ==========================================================================
+   11. PULSE
+   ========================================================================== */
+.pulse {
+    animation: pulseAnim 2s ease-in-out infinite;
+}
+
+@keyframes pulseAnim {
+    0%, 100% { opacity: 1; }
+    50% { opacity: 0.5; }
+}
+
+/* ==========================================================================
+   12. PREFERS-REDUCED-MOTION - Tắt tất cả hiệu ứng
+   ========================================================================== */
+@media (prefers-reduced-motion: reduce) {
+    *, *::before, *::after {
+        animation-duration: 0.01ms !important;
+        animation-iteration-count: 1 !important;
+        transition-duration: 0.01ms !important;
+    }
+
+    .reveal, .reveal-left, .reveal-right, .reveal-scale {
+        opacity: 1;
+        transform: none;
+    }
+
+    .hover-lift:hover,
+    .hover-grow:hover,
+    .stat-card:hover {
+        transform: none;
+    }
+}
